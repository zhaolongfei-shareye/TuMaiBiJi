DATABASE_URL=sqlite:///./tmbj.db

# JWT — 必须设置为长随机字符串，否则服务启动会失败
# 生成方式示例: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 提炼：走云函数中转混元（吃小程序成长计划的免费 Token）
# 硬约束：混元只能在云函数内部用 cloud.ai() 调，本服务直连混元端点会导致额度不抵扣、改扣套餐。
# EXTRACT_PROVIDER 取值：hunyuan_cf（默认）/ none（强制降级，排查或提审期临时关能力用）
#                        / wechat_ai（为微信自家 AI 预留，尚未实现，命中即降级）
EXTRACT_PROVIDER=hunyuan_cf
# 云函数 HTTP 触发地址与凭据，均在云开发控制台创建；凭据绝不入库
HUNYUAN_CF_URL=
# ⚠️ 这里只能填**长期有效的 API Key**，不能填 access_token：网关的 access token 默认
# 2 小时过期、要靠 refresh_token 续，而提炼跑在 RQ worker 里，半夜过期就是静默全线降级。
# 出处是文档写的「云开发平台 → API Key 管理」，取 api_key 类型（服务端管理员凭证，
# 不设有效期即永不过期，单个环境最多 5 个）；填法都在同一个位置：Authorization: Bearer <值>
HUNYUAN_CF_KEY=
# 客户端等待上限。必须**大于**云函数自己的执行超时（现网 extract 已设 60 秒），
# 否则函数还会跑完、我们先放弃。注意微信 /tcb/invokecloudfunction 那条只等约 5 秒，
# 走网关不受它限制，但首次上线仍要实测一次端到端耗时。
HUNYUAN_CF_TIMEOUT=90

# 截图 OCR 已改为进程内 RapidOCR（开源、纯 CPU、随 requirements 安装），无需任何密钥
# 注意首次调用会加载模型，慢一些属正常；缺 libGL.so.1 时见 ocr.py 的报错提示

# 微信小程序
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# Redis（任务队列）
REDIS_URL=redis://localhost:6379

# CORS 允许的源，多个用逗号分隔；小程序客户端不走 CORS，留空即可
CORS_ORIGINS=
