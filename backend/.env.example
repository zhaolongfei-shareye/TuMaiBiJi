DATABASE_URL=sqlite:///./tmbj.db

# JWT — 必须设置为长随机字符串，否则服务启动会失败
# 生成方式示例: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# DeepSeek LLM
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 腾讯云 OCR
TENCENT_OCR_SECRET_ID=your-tencent-ocr-secret-id
TENCENT_OCR_SECRET_KEY=your-tencent-ocr-secret-key

# 腾讯云 ASR（一句话识别）
TENCENT_ASR_SECRET_ID=your-tencent-asr-secret-id
TENCENT_ASR_SECRET_KEY=your-tencent-asr-secret-key

# 腾讯云 COS（对象存储）
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_REGION=ap-shanghai
COS_BUCKET=your-bucket-name

# 微信小程序
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# Redis（任务队列）
REDIS_URL=redis://localhost:6379

# CORS 允许的源，多个用逗号分隔；生产环境请勿使用 *
CORS_ORIGINS=*
