          "if": [
            {
              "truthy": {
                "var": "hasNote"
              }
            },
            {
              "var": "s.bg"
            },
            {
              "var": "sp.bg"
            }
          ]
        }
      }
    },
    {
      "each": {
        "over": [
          56,
          146,
          236,
          326,
          416,
          506,
          596,
          686
