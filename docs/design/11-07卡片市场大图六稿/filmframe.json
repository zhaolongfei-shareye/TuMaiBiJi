            ]
          },
          "y": {
            "var": "signTop"
          },
          "size": {
            "var": "qrSize"
          },
          "offset": {
            "var": "s.accent"
          },
          "ink": {
            "if": [
              {
                "truthy": {
                  "var": "hasNote"
                }
              },
              {
                "var": "s.sub"
              },
              {
                "var": "sp.sub"
              }
            ]
          },
