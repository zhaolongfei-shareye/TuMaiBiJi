{
  "id": "filmframe",
  "min_version": 1,
  "steps": [
    {
      "let": "s",
      "value": {
        "prim": "scheme",
        "args": {
          "name": "mono",
          "categoryId": {
            "var": "note.category_id"
          }
        }
      }
    },
    {
      "let": "sp",
      "value": {
        "prim": "scheme",
        "args": {
          "name": "riso",
          "categoryId": {
            "var": "note.category_id"
          }
        }
      }
    },
    {
      "let": "pad",
      "value": 40
    },
    {
      "let": "imgY",
      "value": 84
    },
    {
      "let": "imgH",
      "value": 780
    },
    {
      "let": "qrSize",
      "value": 108
    },
    {
      "let": "frame",
      "value": {
        "prim": "joinNonEmpty",
        "args": {
          "sep": " ",
          "parts": [
            "FR",
            {
              "padStart": [
                {
                  "var": "note.id"
                },
                2
              ]
            },
            {
              "prim": "noteDate",
              "args": {}
            }
          ]
        }
      }
    },
    {
      "let": "titleY",
      "value": {
        "+": [
          {
            "var": "imgY"
          },
          {
            "var": "imgH"
          },
          72
        ]
      }
    },
    {
      "let": "titleLines",
      "value": {
        "prim": "fitLines",
        "args": {
          "text": {
            "var": "note.title"
          },
          "maxW": {
            "-": [
              {
                "var": "W"
              },
              {
                "*": [
                  {
                    "var": "pad"
                  },
                  2
                ]
              }
            ]
          },
          "n": 2,
          "size": 48,
          "bold": true
        }
      }
    },
    {
      "let": "titleBottom",
      "value": {
        "+": [
          {
            "var": "titleY"
          },
          {
            "*": [
              {
                "-": [
                  {
                    "len": {
                      "var": "titleLines"
                    }
                  },
                  1
                ]
              },
              62
            ]
          },
          48
        ]
      }
    },
    {
      "let": "sumLines",
      "value": {
        "if": [
          {
            "truthy": {
              "var": "note.summary"
            }
          },
          {
            "prim": "fitLines",
            "args": {
              "text": {
                "var": "note.summary"
              },
              "maxW": {
                "-": [
                  {
                    "var": "W"
                  },
                  {
                    "*": [
                      {
                        "var": "pad"
                      },
                      2
                    ]
                  }
                ]
              },
              "n": 2,
              "size": 24
            }
          },
          []
        ]
      }
    },
    {
      "let": "sumBottom",
      "value": {
        "if": [
          {
            "truthy": {
              "len": {
                "var": "sumLines"
              }
            }
          },
          {
            "+": [
              {
                "var": "titleBottom"
              },
              36,
              {
                "*": [
                  {
                    "-": [
                      {
                        "len": {
                          "var": "sumLines"
                        }
                      },
                      1
                    ]
                  },
                  36
                ]
              },
              24
            ]
          },
          {
            "var": "titleBottom"
          }
        ]
      }
    },
    {
      "let": "signTop",
      "value": {
        "+": [
          {
            "var": "sumBottom"
          },
          56
        ]
      }
    },
    {
      "let": "H",
      "value": {
        "+": [
          {
            "var": "signTop"
          },
          216
        ]
      }
    },
    {
      "let": "sign",
      "value": {
        "prim": "signRow",
