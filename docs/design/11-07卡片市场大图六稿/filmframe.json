                  },
                  {
                    "prim": "withAlpha",
                    "args": {
                      "color": {
                        "prim": "token",
                        "args": {
                          "name": "paper"
                        }
                      },
                      "alpha": 0.14
                    }
                  },
                  {
                    "prim": "withAlpha",
                    "args": {
                      "color": {
                        "prim": "token",
                        "args": {
                          "name": "ink"
                        }
                      },
                      "alpha": 0.14
                    }
                  }
                ]
              }
            }
          },
          {
            "emit": {
              "k": "rrect",
              "x": {
                "var": "hx"
              },
              "y": {
                "-": [
                  {
                    "var": "H"
                  },
                  56
                ]
              },
              "w": 44,
              "h": 30,
              "r": 6,
              "fill": {
                "if": [
                  {
                    "truthy": {
                      "var": "hasNote"
                    }
                  },
                  {
                    "prim": "withAlpha",
                    "args": {
                      "color": {
                        "prim": "token",
                        "args": {
                          "name": "paper"
                        }
                      },
                      "alpha": 0.14
                    }
                  },
                  {
                    "prim": "withAlpha",
                    "args": {
                      "color": {
                        "prim": "token",
                        "args": {
                          "name": "ink"
                        }
                      },
                      "alpha": 0.14
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "cond": {
          "truthy": {
            "var": "hasNote"
          }
        },
        "then": [
          {
            "emit": {
              "k": "image",
              "key": "note",
              "x": {
                "var": "pad"
              },
              "y": {
                "var": "imgY"
              },
              "w": {
                "-": [
                  {
                    "var": "W"
                  },
                  {
                    "*": [
                      {
                        "var": "pad"
                      },
                      2
                    ]
                  }
                ]
              },
              "h": {
                "var": "imgH"
              },
              "r": 4
            }
          }
        ],
        "else": [
          {
            "emitOne": {
              "prim": "glyphPlate",
              "args": {
                "x": {
                  "var": "pad"
                },
                "y": {
                  "var": "imgY"
                },
                "w": {
                  "-": [
                    {
                      "var": "W"
                    },
                    {
                      "*": [
                        {
                          "var": "pad"
                        },
                        2
                      ]
                    }
                  ]
                },
                "h": {
                  "var": "imgH"
                },
                "color": {
                  "prim": "withAlpha",
                  "args": {
                    "color": {
                      "prim": "token",
                      "args": {
                        "name": "ink"
                      }
                    },
                    "alpha": 0.12
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "emit": {
        "k": "text",
        "x": {
          "-": [
            {
              "var": "W"
            },
            {
              "var": "pad"
            }
          ]
        },
        "y": 70,
        "lines": [
          {
            "var": "frame"
          }
        ],
        "size": 20,
        "fam": {
          "prim": "token",
          "args": {
            "name": "mono"
          }
        },
        "color": {
          "if": [
            {
              "truthy": {
                "var": "hasNote"
              }
            },
            {
              "var": "s.accent"
            },
            {
              "var": "sp.accent"
            }
          ]
        },
        "align": "right"
      }
    },
    {
      "emit": {
        "k": "text",
        "x": {
          "var": "pad"
        },
        "y": {
          "var": "titleY"
        },
        "lines": {
          "var": "titleLines"
        },
        "lh": 62,
        "size": 48,
        "weight": "bold",
        "color": {
          "if": [
            {
              "truthy": {
                "var": "hasNote"
              }
            },
            {
              "var": "s.ink"
            },
            {
              "var": "sp.ink"
            }
          ]
        }
      }
    },
    {
      "if": {
        "cond": {
          "truthy": {
            "len": {
              "var": "sumLines"
            }
          }
        },
        "then": [
          {
            "emit": {
              "k": "text",
              "x": {
                "var": "pad"
              },
              "y": {
                "+": [
                  {
                    "var": "titleBottom"
                  },
                  36
                ]
              },
              "lines": {
                "var": "sumLines"
              },
              "lh": 36,
              "size": 24,
              "color": {
                "if": [
                  {
                    "truthy": {
                      "var": "hasNote"
                    }
                  },
                  {
                    "var": "s.sub"
                  },
                  {
                    "var": "sp.sub"
                  }
                ]
              }
            }
          }
        ],
        "else": []
      }
    },
    {
      "emitMany": {
        "var": "sign.layers"
      }
    },
    {
      "emitMany": {
        "var": "qr.layers"
      }
    }
  ]
}
