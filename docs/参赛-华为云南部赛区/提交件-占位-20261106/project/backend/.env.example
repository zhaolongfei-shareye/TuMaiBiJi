DATABASE_URL=sqlite:///./tmbj.db

# JWT — 必须设置为长随机字符串，否则服务启动会失败
# 生成方式示例: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 提炼：走云函数中转混元（吃小程序成长计划的免费 Token）
# 硬约束：混元只能在云函数内部用 cloud.ai() 调，本服务直连混元端点会导致额度不抵扣、改扣套餐。
# EXTRACT_PROVIDER 取值：hunyuan_cf（默认）/ none（强制降级，排查或提审期临时关能力用）
#                        / wechat_ai（为微信自家 AI 预留，尚未实现，命中即降级）
EXTRACT_PROVIDER=hunyuan_cf
# 云函数 HTTP 触发地址与凭据，均在云开发控制台创建；凭据绝不入库
HUNYUAN_CF_URL=
# ⚠️ 这里只能填**长期有效的 API Key**，不能填 access_token：网关的 access token 默认
# 2 小时过期、要靠 refresh_token 续，而提炼跑在 RQ worker 里，半夜过期就是静默全线降级。
# 出处是文档写的「云开发平台 → API Key 管理」，取 api_key 类型（服务端管理员凭证，
# 不设有效期即永不过期，单个环境最多 5 个）；填法都在同一个位置：Authorization: Bearer <值>
HUNYUAN_CF_KEY=
# 客户端等待上限。必须**大于**云函数自己的执行超时（现网 extract 已设 60 秒），
# 否则函数还会跑完、我们先放弃。注意微信 /tcb/invokecloudfunction 那条只等约 5 秒，
# 走网关不受它限制，但首次上线仍要实测一次端到端耗时。
HUNYUAN_CF_TIMEOUT=90

# 截图 OCR 已改为进程内 RapidOCR（开源、纯 CPU、随 requirements 安装），无需任何密钥
# 注意首次调用会加载模型，慢一些属正常；缺 libGL.so.1 时见 ocr.py 的报错提示

# 微信小程序
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# Redis（任务队列）
REDIS_URL=redis://localhost:6379

# CORS 允许的源，多个用逗号分隔；小程序客户端不走 CORS，留空即可
CORS_ORIGINS=

# 运营图后台（方案 docs/方案-cn后台资产管理.md）。**留空 = /ops 那一页整条链一律 503**，
# 现网其它功能不受影响；填成示例串这类假值，deploy.sh 的配置自检会念出来。
# 生成方式与 JWT_SECRET_KEY 用同一条命令；这一把钥匙只开后台那几个口，不进 users 表、
# 与小程序登录凭据无关。换掉它会让所有已登录的后台标签页当场失效——这是设计，不是副作用。
# 交付按老规矩走剪贴板（pbcopy / pbpaste），不进对话、不进命令行参数。
ADMIN_TOKEN=
ADMIN_SESSION_MINUTES=60
# 融合后台（方案 docs/方案-cn后台融合.md，站长 10-15 拍「以我们登录为主」）用的换票暗号。
# 图麦克那个服务拿管理员票来 `/api/admin/verify-token` 验真伪时，必须在 `X-Exchange` 头带上这一行。
# **留空 = 那个口一律 503**：两边各自登录照常，只是"一次登录管两个后台"这条不通。
# 它与 ADMIN_TOKEN、JWT_SECRET_KEY 是三把不同的钥匙——把后两者合并等于任何一边泄了两边同时开门，
# 而这一把只让对方问"这枚票真不真"，拿不到签名权。轮换它不影响任何已发出去的登录态。
# 两边要填成同一个值；生成就用 `openssl rand -hex 32`，交付同样走剪贴板。
ADMIN_EXCHANGE_SECRET=
# 提审期把这一项设成 1：下发端点一律回"无下发"，小程序落回包里那张图；
# 后台照常能点，但点什么都不影响线上（锚点 A6）。
MP_ASSETS_FREEZE=0
# 上传的那几张落在服务器磁盘上（留空＝默认 backend/var/mp-assets/）。backup.sh 连它一起备份。
MP_ASSETS_DIR=

# ===================== 10-25 补：代码有声明、这份模板此前没有的那 12 栏 =====================
# 为什么要有这一段（第八轮审计 M28）：`.env.example` 此前比 `Settings.model_fields` 少 12 栏，
# 而"少几行"那道自检（`deploy.sh`）当时只拿上一份 `.env.bak*` 当基准——备份本身也缺键时它是绿的。
# 于是照这份模板装出来的新环境，那 12 栏里掉哪些都不会有任何人出声，症状全是**静默降级**。
# 对法（现读，别抄这一段的字）：
#   backend/.venv/bin/python -c "from app.core.config import Settings; \
#     import re;f=set(Settings.model_fields);k={l.split('=',1)[0].strip() for l in open('backend/.env.example') if l.count('=') and not l.startswith('#')};print(sorted(f-k),sorted(k-f))"
# ⚠ 值一律不进这份文件（真凭据只在服务器那份 `.env` 里，走剪贴板交付）。
# ⚠ 只有 str 栏能留空：bool／int／float 那几栏**空串会让服务当场拒绝启动**
#   （pydantic 2.9 实测 `''` 报 bool_parsing／int_parsing／float_parsing，
#   而 `_load_settings()` 把任何 ValidationError 都转成"配置校验未通过"），
#   所以那几栏这里写的是**代码里的默认值**，不是留空。

# Sign in with Apple：identityToken 里 `aud` 应当等于的值（是 App 的 bundle id，不是 Services ID，
# 也不是密钥）。**不配会怎样**：`/v1/auth/apple` 一律 503——绝不退化成"不验 aud 就放行"。
# 填错值不报 503 而是每次登录 401，`apple_identity._verified_aud` 会把观察到的那个写进日志。
APPLE_CLIENT_ID=

# 内容安全（msgSecCheck）总开关。**这栏设成 False 的后果不是报错，是全部 UGC 出口静默放行**：
# 代码里"没检成"一律放行（不让微信侧抖动变成用户存不了笔记），所以关掉之后屏上什么都正常，
# 只有公开出口等于没过滤。测试环境才关（conftest 要的是"根本不出网"这条不变量）。
SEC_CHECK_ENABLED=True

# 每人每天的花费上限（10-25 审计 M33；计数表 `daily_usage`，判据 `tests/test_日量闸.py`）。
# 分钟闸挡不住"一天里陆陆续续打满"，这两栏才是"这一条链上一天花多少钱"的那道闸。
# 站长拍的档位＝提炼 50 条/天、内容检查 200 次/天；抬它不用改代码，改这两行＋重启。
EXTRACT_DAILY_LIMIT=50
SEC_CHECK_DAILY_LIMIT=200

# 分享卡片上那张小程序码指向哪个版本。**填成 trial 忘了改回来**＝真实用户扫到一张
# 只有体验成员打得开的码，而这在服务器上看不出来（只有拿别人手机扫才发现）。
# `deploy.sh` 每次部署都念这个值，就是为了别让它悄悄留在 trial。
SHARE_QR_ENV_VERSION=release

# 私密笔记解锁凭证活多久（分钟）。与登录 token 两件事：那条管"是不是这台设备的账号"，
# 这条只管"接下来这几分钟能看私密内容"。改大它＝解锁一次整天敞着，而这一闸防的恰恰是
# 手机在别人手里那一会儿。
PRIVATE_UNLOCK_MINUTES=15

# ---- RoamMark 那一路（方案 docs/方案-roammark-AI转发.md）----
# ⚠ 这一组正常**不在这里配**：站长 10-24 拍的是"后台那一栏我自己填"，正身在 `service_secrets`
# 表里那行 `DEEPSEEK`。下面这栏只是"库里那一行被删掉之后回到哪一层"的那一层兜底。
# 不配（且库里也没有）＝景点初稿那个口回 503 说人话，不是崩。
DEEPSEEK=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# ⚠ 能读图的只有 flash：官方价目页 Vision 那一栏写的是 Not supported，换 model 名要连着
# 提示词那一路一起换，别只改这一行。
DEEPSEEK_VISION_MODEL=deepseek-flash
# 单发实测 19.6 秒（一次 9 图、服务器侧、峰时）⇒ 客户端那一侧的超时必须比这个数大。
DEEPSEEK_TIMEOUT=90
# 那组口的门闩。**不配会怎样**：整组 `/api/roammark/*` 一律 503（与 ADMIN_TOKEN 同型——
# 没配就必须是"这个功能不可用"，不许退化成"没配就当不检"）。
# ⚠ 它不是密钥：这一串编在对方的包里，逆向就能拿到，它挡的是"随手 curl 刷钱"，
# 真正兜底的是 IP 限流与并发舱壁。别拿它当凭据轮换。
ROAMMARK_APP_GATE=

# ---- 外链贴图随笔记存档（方案 docs/方案-公众号贴图随笔记存档.md）----
# **这两行里任何一行没配＝整条不做**：一张都不下载、屏上也不报"没存上"。
# 代码可以先上现网，通道配好的那天才生效（半条链挂在屏上、静默少图，是这台机器被打回过的那类事）。
IMAGE_STORE_CF_URL=
# 同一个环境签发的管理员 API Key（选"不设有效期"那一种）。故意与 HUNYUAN_CF_KEY 分两枚：
# 地址能单独轮换、Key 也能单独轮换，而且"提炼那把钥匙顺手也能往桶里写"不该靠巧合成立。
IMAGE_STORE_CF_KEY=
# 必须**大于**那只云函数自己的执行超时（现网 3 秒是控制台里的读数，而实测 18231 ms 那一发照样
# 回 200 —— 见 §8.481，别照抄它）。20 秒这一档已经贴着现网最长实测（4 MB→18231 ms，只剩 9% 预算，
# 第八轮审计 M31 建议抬到 30–45 秒）。超时之后是"云上有一张、库里没那一行"的孤儿对象。
IMAGE_STORE_CF_TIMEOUT=20
