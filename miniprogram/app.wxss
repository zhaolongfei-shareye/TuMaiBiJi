page {
  --text-primary: #333333;
  --text-secondary: #999999;
  --bg-page: #f5f5f5;
  --bg-card: rgba(255, 255, 255, 0.85);
  --accent: #07c160;
  --border: rgba(0, 0, 0, 0.06);
  --card-radius: 20rpx;
  --card-blur: 20rpx;

  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.container {
  padding: 24rpx;
}

.card {
  background: var(--bg-card);
  border-radius: var(--card-radius);
  padding: 24rpx;
  margin-bottom: 20rpx;
  backdrop-filter: blur(var(--card-blur));
  -webkit-backdrop-filter: blur(var(--card-blur));
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.summary {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.tag {
  display: inline-block;
  background: rgba(7, 193, 96, 0.08);
  color: var(--accent);
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.btn-primary {
  background: var(--accent);
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-secondary {
  background: rgba(0, 0, 0, 0.04);
  color: var(--text-primary);
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}
