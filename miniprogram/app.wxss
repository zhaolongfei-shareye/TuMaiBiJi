page {
  --text-primary: #333333;
  --text-secondary: #999999;
  --bg-page: #f5f5f5;
  --bg-card: rgba(255, 255, 255, 0.85);
  --accent: #07c160;
  --border: rgba(0, 0, 0, 0.06);
  --card-radius: 20rpx;
  --card-blur: 20rpx;

  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.theme-default {
  --bg-page: #f5f5f5;
  --bg-card: rgba(255, 255, 255, 0.85);
  --text-primary: #333333;
  --text-secondary: #999999;
  --border: rgba(0, 0, 0, 0.06);
  --accent: #07c160;
}

.theme-blue {
  --bg-page: #e8edf5;
  --bg-card: rgba(255, 255, 255, 0.78);
  --text-primary: #2c3e50;
  --text-secondary: #6b7fa3;
  --border: rgba(102, 126, 234, 0.12);
  --accent: #667eea;
}

.theme-green {
  --bg-page: #e8f5f0;
  --bg-card: rgba(255, 255, 255, 0.78);
  --text-primary: #1a3a2a;
  --text-secondary: #4a8a6a;
  --border: rgba(17, 153, 142, 0.12);
  --accent: #11998e;
}

.theme-sunset {
  --bg-page: #fce4ec;
  --bg-card: rgba(255, 255, 255, 0.78);
  --text-primary: #4a1942;
  --text-secondary: #b85a8a;
  --border: rgba(245, 87, 108, 0.12);
  --accent: #f5576c;
}

.theme-purple {
  --bg-page: #0c0c1d;
  --bg-card: rgba(255, 255, 255, 0.12);
  --text-primary: #e8e8f0;
  --text-secondary: #8888aa;
  --border: rgba(255, 255, 255, 0.08);
  --accent: #a78bfa;
  --card-blur: 24rpx;
}

.theme-ocean {
  --bg-page: #0d1b2a;
  --bg-card: rgba(255, 255, 255, 0.1);
  --text-primary: #d8e8f0;
  --text-secondary: #6888a8;
  --border: rgba(255, 255, 255, 0.06);
  --accent: #4fc3f7;
  --card-blur: 24rpx;
}

.container {
  padding: 24rpx;
}

.card {
  background: var(--bg-card);
  border-radius: var(--card-radius);
  padding: 24rpx;
  margin-bottom: 20rpx;
  backdrop-filter: blur(var(--card-blur));
  -webkit-backdrop-filter: blur(var(--card-blur));
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.summary {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.tag {
  display: inline-block;
  background: rgba(7, 193, 96, 0.08);
  color: var(--accent);
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.btn-primary {
  background: var(--accent);
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-secondary {
  background: rgba(0, 0, 0, 0.04);
  color: var(--text-primary);
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}
