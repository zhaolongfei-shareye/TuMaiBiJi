.tab-bar {
  display: flex;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.icon-notes::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 8rpx;
  width: 24rpx;
  height: 28rpx;
  border: 3rpx solid #999;
  border-radius: 4rpx;
}

.icon-notes::after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 12rpx;
  height: 3rpx;
  background: #999;
  box-shadow: 0 6rpx 0 #999;
}

.active .icon-notes::before {
  border-color: #333;
}

.active .icon-notes::after {
  background: #333;
  box-shadow: 0 6rpx 0 #333;
}

.icon-create::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #999;
  border-radius: 50%;
}

.icon-create::after {
  content: '+';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 28rpx;
  font-weight: 300;
  color: #999;
  line-height: 1;
}

.active .icon-create::before {
  border-color: #333;
}

.active .icon-create::after {
  color: #333;
}

.icon-me::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #999;
  border-radius: 50%;
}

.icon-me::after {
  content: '';
  position: absolute;
  top: 22rpx;
  left: 4rpx;
  width: 32rpx;
  height: 14rpx;
  border: 3rpx solid #999;
  border-radius: 16rpx 16rpx 0 0;
  border-bottom: none;
}

.active .icon-me::before {
  border-color: #333;
}

.active .icon-me::after {
  border-color: #333;
}

.tab-label {
  font-size: 20rpx;
  color: #999;
}

.active .tab-label {
  color: #333;
  font-weight: 500;
}

.tab-bar-dark {
  background: rgba(20, 20, 30, 0.88);
  border-top-color: rgba(255, 255, 255, 0.08);
}

.tab-bar-dark .icon-notes::before,
.tab-bar-dark .icon-create::before,
.tab-bar-dark .icon-me::before {
  border-color: rgba(255, 255, 255, 0.45);
}

.tab-bar-dark .icon-notes::after {
  background: rgba(255, 255, 255, 0.45);
  box-shadow: 0 6rpx 0 rgba(255, 255, 255, 0.45);
}

.tab-bar-dark .icon-create::after {
  color: rgba(255, 255, 255, 0.45);
}

.tab-bar-dark .icon-me::after {
  border-color: rgba(255, 255, 255, 0.45);
}

.tab-bar-dark .active .icon-notes::before,
.tab-bar-dark .active .icon-create::before,
.tab-bar-dark .active .icon-me::before {
  border-color: #fff;
}

.tab-bar-dark .active .icon-notes::after {
  background: #fff;
  box-shadow: 0 6rpx 0 #fff;
}

.tab-bar-dark .active .icon-create::after {
  color: #fff;
}

.tab-bar-dark .active .icon-me::after {
  border-color: #fff;
}

.tab-bar-dark .tab-label {
  color: rgba(255, 255, 255, 0.45);
}

.tab-bar-dark .active .tab-label {
  color: #fff;
}
