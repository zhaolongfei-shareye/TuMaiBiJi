/* 底部导航：浮起的墨色胶囊。
   这里是自定义组件，拿不到 page 上的 CSS 变量，所以颜色一律写死，不用 var()。 */
.tab-bar {
  display: flex;
  position: fixed;
  bottom: 20rpx;
  left: 24rpx;
  right: 24rpx;
  height: 108rpx;
  background: #23252c;
  border-radius: 44rpx;
  padding-bottom: 0;
  box-shadow: 0 16rpx 44rpx rgba(35, 37, 44, 0.28);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.icon-notes::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 8rpx;
  width: 24rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 8rpx;
}

.icon-notes::after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 12rpx;
  height: 3rpx;
  background: rgba(255, 255, 255, 0.42);
  box-shadow: 0 6rpx 0 rgba(255, 255, 255, 0.42);
}

.icon-create::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 50%;
}

.icon-create::after {
  content: '+';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 28rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.42);
  line-height: 1;
}

.icon-me::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 50%;
}

.icon-me::after {
  content: '';
  position: absolute;
  top: 22rpx;
  left: 4rpx;
  width: 32rpx;
  height: 14rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 16rpx 16rpx 0 0;
  border-bottom: none;
}

.tab-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.42);
}

.active .tab-icon::before,
.active .tab-icon::after {
  border-color: #ffffff;
}

.active .icon-notes::after {
  background: #ffffff;
  box-shadow: 0 6rpx 0 #ffffff;
}

.active .icon-create::after,
.active .tab-label {
  color: #ffffff;
}

.active .tab-label {
  font-weight: 600;
}

/* 深色壁纸下页面底和胶囊几乎同色，靠一圈描边把它从背景里分出来 */
.tab-bar-dark {
  background: #1a1c22;
  box-shadow: 0 16rpx 44rpx rgba(0, 0, 0, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}
