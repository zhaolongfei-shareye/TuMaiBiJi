/* 私密解锁那一层的皮，三页共用一份（templates/pwd-sheet.wxml 那一张模板吃它）。 */
@import '../../styles/pwd-sheet.wxss';

.form-section {
  margin-top: var(--sp-5);
  padding: var(--sp-4);
}

.form-group {
  margin-bottom: var(--sp-5);
}

.form-group:last-child {
  margin-bottom: 0;
}

/* 标签做成眉标：小字 + 收字距，让输入框自己当主角 */
.label {
  display: block;
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--text-tertiary);
  margin-bottom: var(--sp-2);
}

.input,
.textarea,
.picker-value {
  background: var(--chip-idle);
  border-radius: var(--r-btn);
  padding: var(--sp-3) var(--sp-4);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  color: var(--text-primary);
}

.textarea {
  min-height: 150rpx;
}

.char-count {
  display: block;
  text-align: right;
  /* 「137/500」是数字加斜杠，跟着全局那一档走；字号仍吃 --fs-tiny，一位没动 */
  font-family: 'WtsjMind', 'Poppins', sans-serif;
  font-size: var(--fs-tiny);
  font-weight: 100;
  color: var(--text-secondary);
  margin-top: var(--sp-1);
}

.actions {
  display: flex;
  gap: var(--sp-2);
  margin-top: var(--sp-5);
}

.actions .btn-secondary,
.actions .btn-primary {
  flex: 1;
  text-align: center;
  padding: var(--sp-3) 0;
  font-size: var(--fs-body);
}

.tag-order {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag-chip {
  padding: 12rpx 22rpx;
  border-radius: var(--r-pill);
  background: var(--accent-soft);
  color: var(--text-secondary);
  font-size: var(--fs-meta);
  font-weight: 700;
}

/* 第一位就是列表方块上那个字，所以它用主按钮那对配色单独标出来
   （--accent 底 + --bg-page 字，深浅两套壁纸都读得清；--bg-card 在深色下是半透明白，不能用） */
.tag-chip.first {
  background: var(--accent);
  color: var(--bg-page);
}

.tag-order-hint {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-micro);
  line-height: 1.5;
  color: var(--text-tertiary);
}

/* 配图那一排（10-18 站长「编辑时，图片要展示，然后支持删除图片」）。
   方格定宽**又**定高 + aspectFill：只定宽时 flex 会压高不压宽，那张图就被夹扁（详情页同一排那张
   注释记的就是这一条）。类名带页面前缀 wr-。 */
.wr-shots {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.wr-shot {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  border-radius: var(--r-block);
  overflow: hidden;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.16);
}

.wr-shot-img {
  width: 100%;
  height: 100%;
  border-radius: var(--r-block);
  background: var(--accent-soft);  /* 图还没落下来时那一格不是白的 */
}

/* ✕ 浮在照片上、不浮在面板那套面上，所以不走 --cp-*：暗纱底 + #fff 字，与录入页 .th-x 同一支
   （照片是亮的，墨字压上去读不出来）。 */
.wr-shot-x {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(20, 20, 28, 0.55);
  color: #fff;
  font-size: var(--fs-micro);
  display: flex;
  align-items: center;
  justify-content: center;
}

.container {
  padding-bottom: 60rpx;
}
