.form-section {
  padding: 32rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.input {
  background: rgba(0, 0, 0, 0.04);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.textarea {
  background: rgba(0, 0, 0, 0.04);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  min-height: 120rpx;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.picker-value {
  background: rgba(0, 0, 0, 0.04);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.actions .btn-secondary,
.actions .btn-primary {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
}
