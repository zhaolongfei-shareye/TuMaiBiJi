.form-section {
  margin-top: var(--sp-5);
  padding: var(--sp-4);
}

.form-group {
  margin-bottom: var(--sp-5);
}

.form-group:last-child {
  margin-bottom: 0;
}

/* 标签做成眉标：小字 + 收字距，让输入框自己当主角 */
.label {
  display: block;
  font-size: var(--fs-tiny);
  font-weight: 700;
  letter-spacing: 1.6rpx;
  color: var(--text-secondary);
  margin-bottom: var(--sp-2);
}

.input,
.textarea,
.picker-value {
  background: var(--chip-idle);
  border-radius: var(--r-btn);
  padding: var(--sp-3) var(--sp-4);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  color: var(--text-primary);
}

.textarea {
  min-height: 150rpx;
}

.char-count {
  display: block;
  text-align: right;
  font-size: var(--fs-tiny);
  font-weight: 600;
  color: var(--text-secondary);
  margin-top: var(--sp-1);
}

.actions {
  display: flex;
  gap: var(--sp-2);
  margin-top: var(--sp-5);
}

.actions .btn-secondary,
.actions .btn-primary {
  flex: 1;
  text-align: center;
  padding: var(--sp-3) 0;
  font-size: var(--fs-body);
}

.container {
  padding-bottom: 60rpx;
}
