.form-section {
  margin-top: var(--sp-5);
  padding: var(--sp-4);
}

.form-group {
  margin-bottom: var(--sp-5);
}

.form-group:last-child {
  margin-bottom: 0;
}

/* 标签做成眉标：小字 + 收字距，让输入框自己当主角 */
.label {
  display: block;
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--text-tertiary);
  margin-bottom: var(--sp-2);
}

.input,
.textarea,
.picker-value {
  background: var(--chip-idle);
  border-radius: var(--r-btn);
  padding: var(--sp-3) var(--sp-4);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  color: var(--text-primary);
}

.textarea {
  min-height: 150rpx;
}

.char-count {
  display: block;
  text-align: right;
  font-size: var(--fs-tiny);
  font-weight: 600;
  color: var(--text-secondary);
  margin-top: var(--sp-1);
}

.actions {
  display: flex;
  gap: var(--sp-2);
  margin-top: var(--sp-5);
}

.actions .btn-secondary,
.actions .btn-primary {
  flex: 1;
  text-align: center;
  padding: var(--sp-3) 0;
  font-size: var(--fs-body);
}

.tag-order {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag-chip {
  padding: 12rpx 22rpx;
  border-radius: var(--r-pill);
  background: var(--accent-soft);
  color: var(--text-secondary);
  font-size: var(--fs-meta);
  font-weight: 700;
}

/* 第一位就是列表方块上那个字，所以它用主按钮那对配色单独标出来
   （--accent 底 + --bg-page 字，深浅两套壁纸都读得清；--bg-card 在深色下是半透明白，不能用） */
.tag-chip.first {
  background: var(--accent);
  color: var(--bg-page);
}

.tag-order-hint {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-micro);
  line-height: 1.5;
  color: var(--text-tertiary);
}

.container {
  padding-bottom: 60rpx;
}
