<!-- 私密解锁那一层的标记在 templates/pwd-sheet.wxml（10-12 起三页共用一份，站长拍「两个密码框要统一」；
     这一页 10-12 起也自己问一次，判据出处见 utils/privateGate.js 的 unlockOn 与 loadNoteForEdit）。 -->
<import src="../../templates/pwd-sheet.wxml"/>
<view class="container {{themeClass}}">
  <view class="form-section card">
    <view class="form-group">
      <text class="label">{{t.title}} *</text>
      <input 
        class="input" 
        placeholder="{{t.titlePlaceholder}}"
        value="{{formData.title}}"
        bindinput="onTitleInput"
        maxlength="100"
      />
    </view>

    <view class="form-group">
      <text class="label">{{t.summary}}</text>
      <textarea 
        class="textarea" 
        placeholder="{{t.summaryPlaceholder}}"
        value="{{formData.summary}}"
        bindinput="onSummaryInput"
        maxlength="500"
        auto-height
      />
      <text class="char-count">{{formData.summary.length || 0}}/500</text>
    </view>

    <view class="form-group">
      <text class="label">{{t.keyPointsHint}}</text>
      <textarea 
        class="textarea" 
        placeholder="{{t.keyPointsPlaceholder}}"
        value="{{keyPointsText}}"
        bindinput="onKeyPointsInput"
        auto-height
      />
    </view>

    <view class="form-group">
      <text class="label">{{t.tagsHint}}</text>
      <input 
        class="input" 
        placeholder="{{t.tagsPlaceholder}}"
        value="{{tagsText}}"
        bindinput="onTagsInput"
      />
      <view class="tag-order" wx:if="{{tagList.length}}">
        <view
          class="tag-chip {{index === 0 ? 'first' : ''}}"
          wx:for="{{tagList}}"
          wx:key="index"
          data-index="{{index}}"
          bindtap="promoteTag"
        >{{item}}</view>
      </view>
      <text class="tag-order-hint" wx:if="{{tagList.length > 1}}">{{t.tagOrderHint}}</text>
    </view>

    <view class="form-group">
      <text class="label">{{t.categoryLabel}}</text>
      <picker mode="selector" range="{{categoryNames}}" value="{{selectedCategoryIndex >= 0 ? selectedCategoryIndex + 1 : 0}}" bindchange="onCategoryChange">
        <view class="picker-value">
          {{selectedCategoryIndex >= 0 ? categoryNames[selectedCategoryIndex + 1] : t.noCategory}}
        </view>
      </picker>
    </view>
  </view>

  <view class="actions">
    <view class="btn-secondary" bindtap="onCancel">{{t.cancel}}</view>
    <view class="btn-primary" bindtap="onSave">{{t.save}}</view>
  </view>

  <template is="pwdSheet" data="{{pwdOpen, pwdEntering, pwdName, pwdScene, pwdTip, pwdBuf, pwdFocus, t}}"/>
</view>
