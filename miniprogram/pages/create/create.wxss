.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 32rpx;
}

.entry-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.entry-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  cursor: pointer;
  transition: transform 0.15s;
}

.entry-card:active {
  transform: scale(0.97);
}

.entry-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.entry-label {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.entry-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* URL Dialog */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.dialog-content {
  width: 600rpx;
  background: var(--bg-card);
  border-radius: var(--card-radius);
  padding: 40rpx 32rpx;
  backdrop-filter: blur(var(--card-blur));
}

.dialog-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.dialog-input {
  background: rgba(0, 0, 0, 0.04);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}

.dialog-actions {
  display: flex;
  gap: 16rpx;
}

.dialog-actions .btn-secondary,
.dialog-actions .btn-primary {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* Preview Section */
.preview-section {
  margin-top: 24rpx;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.preview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.preview-clear {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.preview-scroll {
  white-space: nowrap;
}

.preview-images {
  display: inline-flex;
  gap: 12rpx;
}

.preview-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.submit-btn {
  margin-top: 24rpx;
}
