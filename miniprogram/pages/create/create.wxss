.page-title {
  font-size: var(--fs-h1);
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
  margin: var(--sp-5) 0 var(--sp-4);
}

.entry-cards {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.entry {
  align-items: center;
}

.entry-label {
  font-size: var(--fs-title);
  font-weight: 800;
  letter-spacing: -0.5rpx;
  line-height: var(--lh-tight);
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.entry-desc {
  font-size: var(--fs-meta);
  line-height: var(--lh-tight);
  color: var(--text-secondary);
}

.entry-arrow {
  flex: none;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--text-tertiary);
}

/* URL Dialog */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 20, 28, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.dialog-content {
  width: 620rpx;
  background: var(--bg-card);
  border: var(--w-edge) solid var(--card-edge);
  border-radius: var(--r-card);
  padding: var(--sp-5) var(--sp-4) var(--sp-4);
  box-shadow: var(--sh-float);
}

.dialog-title {
  display: block;
  font-size: var(--fs-h2);
  font-weight: 700;
  letter-spacing: -0.6rpx;
  color: var(--text-primary);
  margin-bottom: var(--sp-4);
}

.dialog-input {
  background: var(--chip-idle);
  border-radius: var(--r-btn);
  padding: var(--sp-3) var(--sp-4);
  font-size: var(--fs-body);
  color: var(--text-primary);
  margin-bottom: var(--sp-5);
}

.dialog-actions {
  display: flex;
  gap: var(--sp-2);
}

.dialog-actions .btn-secondary,
.dialog-actions .btn-primary {
  flex: 1;
  text-align: center;
  padding: var(--sp-3) 0;
  border-radius: var(--r-pill);
  font-size: var(--fs-body);
}

/* Preview Section */
.preview-section {
  margin-top: var(--sp-3);
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--sp-3);
}

.preview-title {
  font-size: var(--fs-h2);
  font-weight: 700;
  letter-spacing: -0.4rpx;
  color: var(--text-primary);
}

.preview-clear {
  font-size: var(--fs-meta);
  color: var(--text-secondary);
}

.preview-scroll {
  white-space: nowrap;
}

.preview-images {
  display: inline-flex;
  gap: var(--sp-2);
}

.preview-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--r-btn);
}

.submit-btn {
  margin-top: var(--sp-4);
}

.container {
  padding-bottom: 140rpx;
}
