.page-title {
  font-size: var(--fs-h1);
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
  margin: var(--sp-5) 0 var(--sp-4);
}

.entry-cards {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

/* ---------- 手风琴卡 ----------
   高度不写死：用 min/max-height 夹住，中间是内容自己撑出来的自然高度。
   为什么不用固定 height：英文文案比中文长（"链接要以 http:// 或 https:// 开头"
   那句换行就多一行），固定档位一旦低估就把控件裁在卡里，而且裁掉的部分点不到。
   max-height 是可插值的，所以展开/收起仍然有 220ms 过渡，只是尾巴上有一小段空跑。 */
.entry {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 144rpx;
  max-height: 144rpx;
  padding: 0 var(--sp-4);
  background: var(--blk-bg);
  color: var(--blk-ink);
  overflow: hidden;
  margin-bottom: 0;
  transition: max-height 0.22s ease, padding 0.22s ease;
}

.entry:active {
  transform: scale(0.99);
}

.entry.open {
  justify-content: flex-start;
  padding: var(--sp-4);
}

.open-url { max-height: 560rpx; }
.open-shot { max-height: 620rpx; }
.open-shot.picked { max-height: 800rpx; }
.open-write { max-height: 780rpx; }

.entry-label {
  /* 功能名是这一屏最该被读到的东西，不能比页面标题（--fs-h1 42rpx）小 */
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: var(--lh-tight);
  opacity: 0.96;
  position: relative;
  z-index: 1;
}

.entry-body {
  position: relative;
  z-index: 1;
  animation: unfold 0.22s ease;
}

@keyframes unfold {
  from { opacity: 0; }
  to { opacity: 1; }
}

.entry-desc {
  font-size: var(--fs-meta);
  line-height: var(--lh-tight);
  opacity: 0.72;
  margin-top: 10rpx;
}

/* ---------- 卡内控件的面 ----------
   --face / --face-ink / --solid-bg / --solid-ink 由 palette.toneStyle 按这块色的深浅发下来，
   这里只写形状。深底卡（蓝）用半透明白面，亮底卡（橙/黄）用近白面 + 该卡墨色字。 */
.face-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-top: 26rpx;
  padding: 0 var(--sp-3);
  border-radius: var(--r-btn);
  background: var(--face);
  color: var(--face-ink);
}

.face-input {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--face-ink);
}

.face-ph {
  color: var(--face-ink);
  opacity: 0.5;
}

.face-x {
  flex: none;
  padding: 0 8rpx;
  font-size: var(--fs-meta);
  opacity: 0.6;
}

.face-area {
  width: 100%;
  height: 180rpx;
  margin-top: 16rpx;
  padding: 18rpx var(--sp-3);
  box-sizing: border-box;
  border-radius: var(--r-btn);
  background: var(--face);
  color: var(--face-ink);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
}

.entry-acts {
  display: flex;
  gap: var(--sp-2);
  margin-top: 20rpx;
}

.act {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
  font-size: var(--fs-body);
  font-weight: 700;
}

.act.ghost { background: var(--face); color: var(--face-ink); }
.act.solid { background: var(--solid-bg); color: var(--solid-ink); }
/* 不可用：面变薄、字变淡，且和 solid 的差别一眼看得出来，不靠文字解释 */
.act.off { background: var(--face-off); color: var(--face-off-ink); }

.entry-note {
  margin-top: 14rpx;
  font-size: var(--fs-label);
  line-height: var(--lh-tight);
  color: var(--blk-ink);
  opacity: 0.66;
}

.entry-err {
  margin-top: 14rpx;
  font-size: var(--fs-label);
  line-height: 1.4;
  font-weight: 700;
  color: var(--blk-err);
}

/* ---------- 截图卡 ---------- */
.shot-strip {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
  margin-top: 22rpx;
}

.shot-cell {
  position: relative;
  width: 128rpx;
  height: 128rpx;
}

.shot-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--r-btn);
  background: rgba(255, 255, 255, 0.5);
}

.shot-x {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(20, 20, 28, 0.66);
  color: #fff;
  font-size: var(--fs-micro);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pick2 {
  display: flex;
  gap: var(--sp-2);
  margin-top: 22rpx;
}

.pk {
  flex: 1;
  height: 164rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-chip);
  background: var(--face);
  color: var(--face-ink);
}

.pk:active { opacity: 0.82; }

.pk-label { font-size: var(--fs-title); font-weight: 800; letter-spacing: -0.5rpx; }
.pk-hint { font-size: var(--fs-micro); opacity: 0.62; margin-top: 4rpx; }

.pk-glyph {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 8rpx;
  background: var(--face-ink);
}

/* ---------- 卡底功能图形 ----------
   几何取自 Lucide v1.50.0（ISC 授权）：link / image / pencil / camera / images。
   同一套 24 格、同一描边重量、圆头线帽——自己手画的形状之所以显廉价，
   就是因为空心与实心混用、线宽不统一。这里只借形状，颜色仍由 palette 出：
   图形本体是一块 var(--blk-glyph) 的色，SVG 只当遮罩用，换分类色时图形跟着变。 */
.glyph {
  position: absolute;
  right: -30rpx;
  bottom: -46rpx;
  width: 264rpx;
  height: 264rpx;
  pointer-events: none;
  z-index: 0;
  background: var(--blk-glyph);
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}

