.page-title {
  font-size: var(--fs-h1);
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
  margin: var(--sp-5) 0 var(--sp-4);
}

.entry-cards {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

/* 深色大卡：这一屏是三块墨黑重音，不吃壁纸（和笔记色卡同一套逻辑——
   卡本身就是设计里最重的东西，主题只管它外面那层底）。 */
.entry {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  min-height: 210rpx;
  padding: 40rpx var(--sp-4);
  background: #23252c;
}

.entry:active {
  transform: scale(0.985);
}

/* 巨型抽象图形：白色压到 7% 上下，落在文字底下、被卡片圆角裁掉一半，
   要的是"若隐若现"，不是看得清——看得清就会跟文字抢。 */
.glyph {
  position: absolute;
  right: -60rpx;
  bottom: -110rpx;
  width: 340rpx;
  height: 340rpx;
  pointer-events: none;
  z-index: 0;
}

.glyph-ring {
  border-radius: 50%;
  border: 30rpx solid rgba(255, 255, 255, 0.09);
  border-right-color: transparent;
  border-bottom-color: transparent;
  transform: rotate(-24deg);
}

.glyph-disc {
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
}

.glyph-bars {
  border-radius: 50%;
  background: repeating-linear-gradient(
    115deg,
    rgba(255, 255, 255, 0.085) 0 22rpx,
    transparent 22rpx 54rpx
  );
}

.entry-text {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.entry-label {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.8rpx;
  line-height: var(--lh-tight);
  color: rgba(255, 255, 255, 0.94);
  margin-bottom: 10rpx;
}

.entry-desc {
  font-size: var(--fs-meta);
  line-height: var(--lh-tight);
  color: rgba(255, 255, 255, 0.52);
}

.entry-arrow {
  position: relative;
  z-index: 1;
  flex: none;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  color: rgba(255, 255, 255, 0.4);
}

/* URL Dialog */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 20, 28, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.dialog-content {
  width: 620rpx;
  background: var(--bg-card);
  border: var(--w-edge) solid var(--card-edge);
  border-radius: var(--r-card);
  padding: var(--sp-5) var(--sp-4) var(--sp-4);
  box-shadow: var(--sh-float);
}

.dialog-title {
  display: block;
  font-size: var(--fs-h2);
  font-weight: 700;
  letter-spacing: -0.6rpx;
  color: var(--text-primary);
  margin-bottom: var(--sp-4);
}

.dialog-input {
  background: var(--chip-idle);
  border-radius: var(--r-btn);
  padding: var(--sp-3) var(--sp-4);
  font-size: var(--fs-body);
  color: var(--text-primary);
  margin-bottom: var(--sp-5);
}

.dialog-actions {
  display: flex;
  gap: var(--sp-2);
}

.dialog-actions .btn-secondary,
.dialog-actions .btn-primary {
  flex: 1;
  text-align: center;
  padding: var(--sp-3) 0;
  border-radius: var(--r-pill);
  font-size: var(--fs-body);
}

/* Preview Section */
.preview-section {
  margin-top: var(--sp-3);
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--sp-3);
}

.preview-title {
  font-size: var(--fs-h2);
  font-weight: 700;
  letter-spacing: -0.4rpx;
  color: var(--text-primary);
}

.preview-clear {
  font-size: var(--fs-meta);
  color: var(--text-secondary);
}

.preview-scroll {
  white-space: nowrap;
}

.preview-images {
  display: inline-flex;
  gap: var(--sp-2);
}

.preview-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--r-btn);
}

.submit-btn {
  margin-top: var(--sp-4);
}

.container {
  padding-bottom: 140rpx;
}
