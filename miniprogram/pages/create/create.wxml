<view class="container">
  <view class="page-title">{{t('tabCreate', lang)}}</view>

  <!-- 三个入口卡片 -->
  <view class="entry-cards">
    <view class="card entry-card" bindtap="onUrlImport">
      <text class="entry-icon">🔗</text>
      <text class="entry-label">{{t('importUrl', lang)}}</text>
      <text class="entry-desc">公众号文章 / 网页链接</text>
    </view>

    <view class="card entry-card" bindtap="onScreenshotImport">
      <text class="entry-icon">📸</text>
      <text class="entry-label">{{t('importScreenshot', lang)}}</text>
      <text class="entry-desc">相册选择 / 拍照</text>
    </view>

    <view class="card entry-card" bindtap="onManualWrite">
      <text class="entry-icon">✍️</text>
      <text class="entry-label">{{t('writeNote', lang)}}</text>
      <text class="entry-desc">手动输入标题和摘要</text>
    </view>
  </view>

  <!-- URL 导入弹窗 -->
  <view wx:if="{{showUrlDialog}}" class="dialog-mask" catchtap="closeUrlDialog">
    <view class="dialog-content" catchtap="stopPropagation">
      <text class="dialog-title">粘贴链接</text>
      <input 
        class="dialog-input" 
        placeholder="https://mp.weixin.qq.com/..."
        value="{{urlInput}}"
        bindinput="onUrlInput"
        focus="{{showUrlDialog}}"
      />
      <view class="dialog-actions">
        <view class="btn-secondary" bindtap="closeUrlDialog">{{t('cancel', lang)}}</view>
        <view class="btn-primary" bindtap="submitUrl">{{t('save', lang)}}</view>
      </view>
    </view>
  </view>

  <!-- 截图预览区（选择后显示） -->
  <view wx:if="{{previewImages.length > 0}}" class="preview-section card">
    <view class="preview-header">
      <text class="preview-title">已选 {{previewImages.length}} 张截图</text>
      <text class="preview-clear" bindtap="clearPreview">清空</text>
    </view>
    <scroll-view class="preview-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="preview-images">
        <image 
          class="preview-img" 
          wx:for="{{previewImages}}" 
          wx:key="*this"
          src="{{item}}" 
          mode="aspectFill"
        />
      </view>
    </scroll-view>
    <view class="btn-primary submit-btn" bindtap="submitScreenshots">
      {{submitting ? '处理中...' : '开始提取'}}
    </view>
  </view>
</view>
