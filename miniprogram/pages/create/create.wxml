<view class="container {{themeClass}}">
  <view class="page-title">{{t.createHeading}}</view>

  <!-- 三个入口：整张饱和色大卡，卡底压一个若隐若现的功能图形：
       链条=链接导入，相框山日=图片/截图，铅笔=手写。图形几何取自 Lucide，见 create.wxss。
       字色跟着该组色走固定配对（黄/橙配白字实测只有 1.63/3.03，读不出来）。 -->
  <view class="entry-cards">
    <view class="card entry" style="{{skinUrl}}" bindtap="onUrlImport">
      <view class="glyph glyph-link"></view>
      <view class="entry-text">
        <view class="entry-label">{{t.importUrl}}</view>
        <view class="entry-desc">{{t.linkDesc}}</view>
      </view>
    </view>

    <view class="card entry" style="{{skinShot}}" bindtap="onScreenshotImport">
      <view class="glyph glyph-image"></view>
      <view class="entry-text">
        <view class="entry-label">{{t.importScreenshot}}</view>
        <view class="entry-desc">{{t.albumDesc}}</view>
      </view>
    </view>

    <view class="card entry" style="{{skinWrite}}" bindtap="onManualWrite">
      <view class="glyph glyph-pencil"></view>
      <view class="entry-text">
        <view class="entry-label">{{t.writeNote}}</view>
        <view class="entry-desc">{{t.manualDesc}}</view>
      </view>
    </view>
  </view>

  <!-- URL 导入弹窗 -->
  <view wx:if="{{showUrlDialog}}" class="dialog-mask" catchtap="closeUrlDialog">
    <view class="dialog-content" catchtap="stopPropagation">
      <text class="dialog-title">{{t.pasteLink}}</text>
      <input 
        class="dialog-input" 
        placeholder="https://mp.weixin.qq.com/..."
        value="{{urlInput}}"
        bindinput="onUrlInput"
        focus="{{showUrlDialog}}"
      />
      <view class="dialog-actions">
        <view class="btn-secondary" bindtap="closeUrlDialog">{{t.cancel}}</view>
        <view class="btn-primary" bindtap="submitUrl">{{t.save}}</view>
      </view>
    </view>
  </view>

  <!-- 截图预览区（选择后显示） -->
  <view wx:if="{{previewImages.length > 0}}" class="preview-section card">
    <view class="preview-header">
      <text class="preview-title">{{previewImages.length}} {{t.selectedCount}}</text>
      <text class="preview-clear" bindtap="clearPreview">{{t.clear}}</text>
    </view>
    <scroll-view class="preview-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="preview-images">
        <image 
          class="preview-img" 
          wx:for="{{previewImages}}" 
          wx:key="*this"
          src="{{item}}" 
          mode="aspectFill"
        />
      </view>
    </scroll-view>
    <view class="btn-primary submit-btn" bindtap="submitScreenshots">
      {{submitting ? t.processing : t.startExtract}}
    </view>
  </view>
</view>
