<view class="container {{themeClass}}" bindtap="collapse">
  <view class="page-title">{{t.createHeading}}</view>

  <!-- 手风琴：同一时刻最多一张卡展开。展开那张自己长高，把输入框/按钮装在自己肚子里；
       另外两张缩成一条、功能名垂直居中，位置不跳。整页（.container）就是收起点击区，
       卡片自己 catchtap，所以点卡内任何地方都不会把刚展开的东西收掉。 -->
  <view class="entry-cards">

    <view class="card entry {{active === 'url' ? 'open open-url' : ''}}" style="{{skinUrl}}" data-kind="url" catchtap="toggleCard">
      <view class="glyph glyph-link"></view>
      <view class="entry-label">{{t.importUrl}}</view>
      <view wx:if="{{active === 'url'}}" class="entry-body">
        <view class="entry-desc">{{t.linkDesc}}</view>
        <view class="face-box">
          <input
            class="face-input"
            value="{{urlInput}}"
            placeholder="https://mp.weixin.qq.com/…"
            placeholder-class="face-ph"
            confirm-type="done"
            bindinput="onUrlInput"
          />
          <view wx:if="{{urlInput}}" class="face-x" catchtap="clearUrl">✕</view>
        </view>
        <view class="entry-acts">
          <view class="act ghost" catchtap="pasteUrl">{{t.paste}}</view>
          <view class="act {{urlHint === 'ok' && !busy ? 'solid' : 'off'}}" catchtap="submitUrl">{{busy === 'url' ? t.busyExtract : t.save}}</view>
        </view>
        <view wx:if="{{errLine}}" class="entry-err" catchtap="openPermSetting">{{errLine}}</view>
        <view wx:elif="{{urlHint === 'bad'}}" class="entry-err">{{t.linkRule}}</view>
        <view wx:elif="{{urlHint === 'ok'}}" class="entry-note">{{t.linkReady}}</view>
        <view wx:else class="entry-note">{{t.urlHintIdle}}</view>
      </view>
    </view>

    <view class="card entry {{active === 'shot' ? (previewImages.length ? 'open open-shot picked' : 'open open-shot') : ''}}" style="{{skinShot}}" data-kind="shot" catchtap="toggleCard">
      <view class="glyph glyph-image"></view>
      <view class="entry-label">{{t.importScreenshot}}</view>
      <view wx:if="{{active === 'shot'}}" class="entry-body">
        <view class="entry-desc">{{shotDesc}}</view>
        <!-- 一横排可滑，不给它换行：换行的话 9 张会撑到三行，超出卡片高度就被裁，
             而裁掉的部分既看不见也点不到。 -->
        <scroll-view wx:if="{{previewImages.length}}" class="shot-strip" scroll-x show-scrollbar="{{false}}">
          <view class="shot-cell" wx:for="{{previewImages}}" wx:key="*this">
            <image class="shot-img" src="{{item}}" mode="aspectFill" />
            <view class="shot-x" data-index="{{index}}" catchtap="removeShot">✕</view>
          </view>
        </scroll-view>
        <view class="pick2">
          <view class="pk" data-source="camera" catchtap="pickImage">
            <view class="pk-glyph glyph-camera"></view>
            <view class="pk-label">{{t.takePhoto}}</view>
            <view class="pk-hint">{{t.takePhotoHint}}</view>
          </view>
          <view class="pk" data-source="album" catchtap="pickImage">
            <view class="pk-glyph glyph-album"></view>
            <view class="pk-label">{{t.fromAlbum}}</view>
            <view class="pk-hint">{{t.fromAlbumHint}}</view>
          </view>
        </view>
        <view class="entry-acts">
          <view wx:if="{{previewImages.length}}" class="act ghost" catchtap="clearShots">{{t.clear}}</view>
          <view class="act {{previewImages.length && !busy ? 'solid' : 'off'}}" catchtap="submitScreenshots">{{busy === 'shot' ? t.busyExtract : t.startExtract}}</view>
        </view>
        <view wx:if="{{errLine}}" class="entry-err" catchtap="openPermSetting">{{errLine}}</view>
      </view>
    </view>

    <view class="card entry {{active === 'write' ? 'open open-write' : ''}}" style="{{skinWrite}}" data-kind="write" catchtap="toggleCard">
      <view class="glyph glyph-pencil"></view>
      <view class="entry-label">{{t.writeNote}}</view>
      <view wx:if="{{active === 'write'}}" class="entry-body">
        <view class="entry-desc">{{t.manualDesc}}</view>
        <view class="face-box">
          <input
            class="face-input"
            value="{{writeTitle}}"
            placeholder="{{t.writeTitlePh}}"
            placeholder-class="face-ph"
            bindinput="onWriteTitle"
          />
        </view>
        <textarea
          class="face-area"
          value="{{writeBody}}"
          placeholder="{{t.writeBodyPh}}"
          placeholder-class="face-ph"
          maxlength="2000"
          bindinput="onWriteBody"
        />
        <view class="entry-acts">
          <view class="act ghost" catchtap="cancelWrite">{{t.cancel}}</view>
          <view class="act {{busy === 'write' ? 'off' : 'solid'}}" catchtap="saveManual">{{busy === 'write' ? t.busySave : t.save}}</view>
        </view>
        <view wx:if="{{errLine}}" class="entry-err">{{errLine}}</view>
      </view>
    </view>

  </view>
</view>
