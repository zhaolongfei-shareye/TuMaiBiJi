<view class="container {{themeClass}} {{bgSrc ? 'has-bg' : ''}} {{active ? 'bg-give-way' : ''}}" bindtap="collapse">
  <!-- 首页背景。图就是「我的 → 卡片模板」最上面那张形象图，没设过就用包里这张站长人像。
       必须用 <image> 组件而不是 wxss 的 background-image：后者不认小程序包里的
       本地文件（只认 base64 和网络地址），而这张 89KB 的图转 base64 会把主包撑坏。
       两个都 fixed，跟着视口不跟着滚；点它们等于点容器空白处，照样收条。 -->
  <image wx:if="{{bgSrc}}" class="page-bg" src="{{bgSrc}}" mode="aspectFill" />
  <view wx:if="{{bgSrc}}" class="page-scrim"></view>

  <view class="title-row">
    <view class="page-title">{{t.createHeading}}</view>
    <!-- 语言切换放在第一眼这一行：需要它的人正是刚进来、还没摸到「我的」页的人。
         只切界面文案，不动账号也不重新登录；服务端那一栏由 PUT /api/user/language 记着，
         换设备登录还是他选的那一门。整页是"收起"点击区，所以这两段用 catchtap 不吃进 collapse。 -->
    <view class="lang-switch" catchtap="noop" aria-label="{{t.selectLanguage}}">
      <view class="lang-seg {{lang === 'zh' ? 'lang-on' : ''}}" catchtap="onSwitchLang" data-key="zh">中</view>
      <view class="lang-seg {{lang === 'en' ? 'lang-on' : ''}}" catchtap="onSwitchLang" data-key="en">EN</view>
    </view>
  </view>

  <!-- 统一录入条：收起时只有这一条，右边三枚小圆是拍照 / 相册 / 链接三个入口；
       点条身或任意一枚小圆都向下展开成一张面板，面板里四个模式标签可以互切。
       原来那三张饱和色大卡没有消失，只是被收进同一条肚子里——功能名、控件、
       校验、报错行、忙态全部照旧，改的只有承载方式。 -->
  <view class="entry-wrap">
    <view class="bar" catchtap="openBar">
      <view class="bar-lead glyph-{{lead}}"></view>
      <view class="bar-label">{{barTitle}}</view>
      <view wx:if="{{active}}" class="bar-hint">{{t.barCollapse}}</view>
      <view wx:else class="bar-dots">
        <view class="dot" style="{{skinShot}}" catchtap="onDotShot" data-source="camera" aria-label="{{t.takePhoto}}">
          <view class="dot-glyph glyph-camera"></view>
        </view>
        <view class="dot" style="{{skinAlbum}}" catchtap="onDotShot" data-source="album" aria-label="{{t.fromAlbum}}">
          <view class="dot-glyph glyph-album"></view>
        </view>
        <view class="dot" style="{{skinUrl}}" catchtap="onDotUrl" aria-label="{{t.importUrl}}">
          <view class="dot-glyph glyph-link"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{active}}" class="panel" catchtap="noop">
      <view class="modes">
        <view class="mode {{mode === 'write' ? 'on' : ''}}" catchtap="onMode" data-mode="write">
          <view class="mode-dot" style="{{skinWrite}}"></view>{{t.modeWrite}}
        </view>
        <view class="mode {{mode === 'camera' ? 'on' : ''}}" catchtap="onMode" data-mode="camera">
          <view class="mode-dot" style="{{skinShot}}"></view>{{t.takePhoto}}
        </view>
        <view class="mode {{mode === 'album' ? 'on' : ''}}" catchtap="onMode" data-mode="album">
          <view class="mode-dot" style="{{skinAlbum}}"></view>{{t.fromAlbum}}
        </view>
        <view class="mode {{mode === 'url' ? 'on' : ''}}" catchtap="onMode" data-mode="url">
          <view class="mode-dot" style="{{skinUrl}}"></view>{{t.modeUrl}}
        </view>
      </view>

      <!-- 下面三段就是原来那三张卡的 entry-body，一行没改逻辑 -->
      <view wx:if="{{active === 'url'}}" class="entry-body">
        <view class="entry-desc">{{t.linkDesc}}</view>
        <view class="face-box">
          <input
            class="face-input"
            value="{{urlInput}}"
            placeholder="https://mp.weixin.qq.com/…"
            placeholder-class="face-ph"
            confirm-type="done"
            bindinput="onUrlInput"
          />
          <view wx:if="{{urlInput}}" class="face-x" catchtap="clearUrl">✕</view>
        </view>
        <view class="acts">
          <view class="act ghost" catchtap="pasteUrl">{{t.paste}}</view>
          <view class="act {{urlHint === 'ok' && !busy ? 'solid' : 'off'}}" catchtap="submitUrl">{{busy === 'url' ? t.busyExtract : t.save}}</view>
        </view>
        <view wx:if="{{errLine}}" class="entry-err" catchtap="openPermSetting">{{errLine}}</view>
        <view wx:elif="{{urlHint === 'bad'}}" class="entry-err">{{t.linkRule}}</view>
        <view wx:elif="{{urlHint === 'ok'}}" class="entry-note">{{t.linkReady}}</view>
        <view wx:else class="entry-note">{{t.urlHintIdle}}</view>
      </view>

      <view wx:elif="{{active === 'shot'}}" class="entry-body">
        <view class="entry-desc">{{shotDesc}}</view>
        <!-- 一横排可滑，不给它换行：换行的话 9 张会撑到三行，超出面板高度就被裁，
             而裁掉的部分既看不见也点不到。 -->
        <scroll-view wx:if="{{previewImages.length}}" class="shot-strip" scroll-x show-scrollbar="{{false}}">
          <view class="shot-cell" wx:for="{{previewImages}}" wx:key="*this">
            <image class="shot-img" src="{{item}}" mode="aspectFill" />
            <view class="shot-x" data-index="{{index}}" catchtap="removeShot">✕</view>
          </view>
        </scroll-view>
        <view class="pick2">
          <view class="pk" style="{{skinShot}}" data-source="camera" catchtap="pickImage">
            <view class="pk-glyph glyph-camera"></view>
            <view class="pk-label">{{t.takePhoto}}</view>
            <view class="pk-hint">{{t.takePhotoHint}}</view>
          </view>
          <view class="pk" style="{{skinAlbum}}" data-source="album" catchtap="pickImage">
            <view class="pk-glyph glyph-album"></view>
            <view class="pk-label">{{t.fromAlbum}}</view>
            <view class="pk-hint">{{t.fromAlbumHint}}</view>
          </view>
        </view>
        <view class="acts">
          <view wx:if="{{previewImages.length}}" class="act ghost" catchtap="clearShots">{{t.clear}}</view>
          <view class="act {{previewImages.length && !busy ? 'solid' : 'off'}}" catchtap="submitScreenshots">{{busy === 'shot' ? t.busyExtract : t.startExtract}}</view>
        </view>
        <view wx:if="{{errLine}}" class="entry-err" catchtap="openPermSetting">{{errLine}}</view>
      </view>

      <view wx:else class="entry-body">
        <view class="entry-desc">{{t.manualDesc}}</view>
        <view class="face-box">
          <input
            class="face-input"
            value="{{writeTitle}}"
            placeholder="{{t.writeTitlePh}}"
            placeholder-class="face-ph"
            bindinput="onWriteTitle"
          />
        </view>
        <textarea
          class="face-area"
          value="{{writeBody}}"
          placeholder="{{t.writeBodyPh}}"
          placeholder-class="face-ph"
          maxlength="2000"
          bindinput="onWriteBody"
        />
        <picker
          wx:if="{{categoryNames.length}}"
          class="cat-pick"
          mode="selector"
          range="{{categoryNames}}"
          value="{{catIndex}}"
          bindchange="onPickCategory"
        >
          <view class="cat-row">
            <text class="cat-key">{{t.categoryLabel}}</text>
            <text class="cat-val">{{categoryNames[catIndex]}}</text>
            <text class="cat-caret">›</text>
          </view>
        </picker>
        <view class="acts">
          <view class="act ghost" catchtap="cancelWrite">{{t.cancel}}</view>
          <view class="act {{busy === 'write' ? 'off' : 'solid'}}" catchtap="saveManual">{{busy === 'write' ? t.busySave : t.save}}</view>
        </view>
        <view wx:if="{{errLine}}" class="entry-err">{{errLine}}</view>
      </view>
    </view>

    <!-- 换背景图：只是导流到「我的 → 卡片模板」那一页，选图仍然只在那一页做一次，
         这里不弹相册——一个功能只留一个入口。 -->
    <view wx:if="{{bgSrc}}" class="home-swap" catchtap="goHomeBg" aria-label="{{t.homeBgSwap}}">
      <view class="swap-glyph glyph-image"></view>
      <text class="swap-text">{{t.homeBgSwap}}</text>
    </view>
  </view>
</view>
