<view class="container {{themeClass}}">
  <view class="page-title">{{t.createHeading}}</view>

  <!-- 三个入口：白卡 + 一个饱和色块徽标。大胆留给笔记列表，这里保持安静 -->
  <view class="entry-cards">
    <view class="entry-card" bindtap="onUrlImport">
      <view class="entry-badge" style="{{skinUrl}}"><text>链</text></view>
      <view class="entry-text">
        <text class="entry-label">{{t.importUrl}}</text>
        <text class="entry-desc">{{t.linkDesc}}</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <view class="entry-card" bindtap="onScreenshotImport">
      <view class="entry-badge" style="{{skinShot}}"><text>图</text></view>
      <view class="entry-text">
        <text class="entry-label">{{t.importScreenshot}}</text>
        <text class="entry-desc">{{t.albumDesc}}</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <view class="entry-card" bindtap="onManualWrite">
      <view class="entry-badge" style="{{skinWrite}}"><text>写</text></view>
      <view class="entry-text">
        <text class="entry-label">{{t.writeNote}}</text>
        <text class="entry-desc">{{t.manualDesc}}</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>
  </view>

  <!-- URL 导入弹窗 -->
  <view wx:if="{{showUrlDialog}}" class="dialog-mask" catchtap="closeUrlDialog">
    <view class="dialog-content" catchtap="stopPropagation">
      <text class="dialog-title">{{t.pasteLink}}</text>
      <input 
        class="dialog-input" 
        placeholder="https://mp.weixin.qq.com/..."
        value="{{urlInput}}"
        bindinput="onUrlInput"
        focus="{{showUrlDialog}}"
      />
      <view class="dialog-actions">
        <view class="btn-secondary" bindtap="closeUrlDialog">{{t.cancel}}</view>
        <view class="btn-primary" bindtap="submitUrl">{{t.save}}</view>
      </view>
    </view>
  </view>

  <!-- 截图预览区（选择后显示） -->
  <view wx:if="{{previewImages.length > 0}}" class="preview-section card">
    <view class="preview-header">
      <text class="preview-title">{{previewImages.length}} {{t.selectedCount}}</text>
      <text class="preview-clear" bindtap="clearPreview">{{t.clear}}</text>
    </view>
    <scroll-view class="preview-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="preview-images">
        <image 
          class="preview-img" 
          wx:for="{{previewImages}}" 
          wx:key="*this"
          src="{{item}}" 
          mode="aspectFill"
        />
      </view>
    </scroll-view>
    <view class="btn-primary submit-btn" bindtap="submitScreenshots">
      {{submitting ? t.processing : t.startExtract}}
    </view>
  </view>
</view>
