<view class="container {{themeClass}} {{bgSrc ? 'has-bg' : ''}} {{active ? 'entry-dock' : ''}}" bindtap="collapse">
  <!-- 首页背景。图就是「我的 → 卡片模板」最上面那张形象图，没设过就用包里这张站长人像。
       必须用 <image> 组件而不是 wxss 的 background-image：后者不认小程序包里的
       本地文件（只认 base64 和网络地址），而这张 89KB 的图转 base64 会把主包撑坏。
       两个都 fixed，跟着视口不跟着滚；点它们等于点容器空白处，照样收条。 -->
  <image wx:if="{{bgSrc}}" class="page-bg" src="{{bgSrc}}" mode="aspectFill" />
  <!-- 「调亮度」那一枚点拧的就是这一层的透明度：dimScrim 空串＝全铺（最沉那一档，
       也就是这半年一直在跑的样子），opacity:0＝一点不压（＝原图亮度，站长拿原图对过才认的）。
       不再另叠第二层黑——上一版那么做，"纯白"档实测只有原图亮度的 62%，压暗的其实一直是这层罩子。 -->
  <view wx:if="{{bgSrc}}" class="page-scrim" style="{{dimScrim}}"></view>

  <view class="title-row">
    <view class="page-title">{{t.createHeading}}</view>
    <!-- 语言切换放在第一眼这一行：需要它的人正是刚进来、还没摸到「我的」页的人。
         只切界面文案，不动账号也不重新登录；服务端那一栏由 PUT /api/user/language 记着，
         换设备登录还是他选的那一门。整页是"收起"点击区，所以这两段用 catchtap 不吃进 collapse。 -->
    <view class="lang-switch" catchtap="noop" aria-label="{{t.selectLanguage}}">
      <view class="lang-seg {{lang === 'zh' ? 'lang-on' : ''}}" catchtap="onSwitchLang" data-key="zh">中</view>
      <view class="lang-seg {{lang === 'en' ? 'lang-on' : ''}}" catchtap="onSwitchLang" data-key="en">EN</view>
    </view>
  </view>

  <!-- slogan 下面靠左那一行：日期 + 星期，只当提醒和气氛，字号跟右边「中」一致 -->
  <view class="date-row">
    <text class="d">{{dateText}}</text>
    <text class="w">{{weekText}}</text>
  </view>

  <!-- 统一录入条（10-08 改版）。收起态还是那条纸白胶囊，右边三枚小圆是三个入口；
       展开之后条身整条让位——上面换成框外那一行小字，下面升起一张暗面板。
       面板里只剩两样东西：一个输入框（或一横排小图）＋ 一枚"右滑才开始提炼"的长条。
       功能一个没少：校验、忙态、报错、权限引导全部照旧，改的是承载方式。 -->
  <view class="entry-wrap">
    <!-- 站长 10-01 晚：横条上面加一行轮播 Tips，教人用拍照提炼、分享选模板这些现成能力。
         展开态整行不渲染（和「换背景」同一规矩：面板已经贴底了，上面再滚一行提示会跟表单抢眼睛）。
         字号、左边留空、离横条那一行的距离全在 wxss 的 .tips 上，这里只递一枚点和一句文本。
         点是他要的那枚"小灯泡"的象征，颜色由 palette.TIP_DOT 从 style 递进来——
         写进 wxss 会被 `验-统一录入条.js` 那条"饱和色不许抄进样式表"打红。
         中文是「Tips：」、英文是「Tips: 」——冒号那档跟着语言走，不硬贴一个全角冒号到英文上。 -->
    <view wx:if="{{!active && tips.length}}" class="tips">
      <view class="tips-dot" style="{{tipDotStyle}}"></view>
      <text class="tips-line">{{tipsPrefix}}{{tips[tipIdx]}}</text>
    </view>

    <!-- 收起态：条身不再挂 open 类。展开时它整个不渲染（面板自己贴底，
         上面那行框外小字接手「点空白处收起」这一句），所以胶囊与面板"同一块白、接缝对齐"那套没了。 -->
    <view wx:if="{{!active}}" class="bar" catchtap="openBar">
      <view class="bar-lead glyph-pen"></view>
      <view class="bar-label">{{t.barIdle}}</view>
      <view class="bar-dots">
        <view class="dot" style="{{skinShot}}" catchtap="onDotShot" data-source="camera" aria-label="{{t.takePhoto}}">
          <view class="dot-glyph glyph-camera"></view>
        </view>
        <view class="dot" style="{{skinAlbum}}" catchtap="onDotShot" data-source="album" aria-label="{{t.fromAlbum}}">
          <view class="dot-glyph glyph-images"></view>
        </view>
        <view class="dot" style="{{skinUrl}}" catchtap="onDotUrl" aria-label="{{t.importUrl}}">
          <view class="dot-glyph glyph-link"></view>
        </view>
      </view>
    </view>

    <!-- 展开态：面板外面那一行两枚小字（10-08 站长原话「这一行移出框外」）。
         左边报名前在干什么、右边报怎么退出去，两枚都浮在形象图上，所以吃页面级
         --text-tertiary：铺图时它是纸白 .56，没铺图时是这套壁纸的灰字，两头都不用另写规则。 -->
    <view wx:if="{{active}}" class="out">
      <text class="out-l">{{t.chooseMode}}</text>
      <text class="out-r">{{t.barCollapse}}</text>
    </view>
    <!-- 报错行放在框外、面板上面（10-08）：它是临时消息不是控件，塞进面板里就得给每一态
         都预留一行高度，而那一段高度正是站长连说两轮"继续压低"要省的地方。
         权限那一类整行可点，直接进设置；其余只是读。 -->
    <view wx:if="{{active && hintLine}}" class="out-err" catchtap="openPermSetting">{{hintLine}}</view>

    <view wx:if="{{active}}" class="panel {{panelOpen ? 'panel-open' : ''}}" style="{{skinPanel}}" catchtap="noop">
      <view class="modes" catchtap="noop">
        <view class="md {{active === 'photo' ? 'on' : ''}}" catchtap="onTab" data-tab="photo">{{t.modePhoto}}</view>
        <view class="md {{active === 'url' ? 'on' : ''}}" catchtap="onTab" data-tab="url">{{t.modeUrl}}</view>
        <view class="md {{active === 'write' ? 'on' : ''}}" catchtap="onTab" data-tab="write">{{t.modeWrite}}</view>
      </view>

      <view class="card">
        <!-- 照片 · 还没选图：三枚圈。中间那枚大的（白环＋实心）就是快门，是全篇唯一的大钮；
             左边小圆走相册、右边小圆跳到链接那一档。三个图形都带字，没有裸图。 -->
        <view wx:if="{{active === 'photo' && !previewImages.length}}" class="crow">
          <view class="mini" catchtap="pickImage" data-source="album" aria-label="{{t.fromAlbum}}">
            <view class="mini-c"><view class="mini-glyph glyph-images"></view></view>
            <text class="mini-lb">{{t.fromAlbum}}</text>
          </view>
          <view class="shutcol" catchtap="pickImage" data-source="camera" aria-label="{{t.takePhoto}}">
            <view class="shut"><view class="shut-core"><view class="shut-glyph glyph-camera"></view></view></view>
            <text class="shut-lb">{{t.takePhoto}}</text>
          </view>
          <view class="mini" catchtap="onTab" data-tab="url" aria-label="{{t.modeUrl}}">
            <view class="mini-c"><view class="mini-glyph glyph-link"></view></view>
            <text class="mini-lb">{{t.modeUrl}}</text>
          </view>
        </view>

        <!-- 照片 · 已选：一横排小图，➕ 那枚与小图同尺寸同圆角、钉在最右端。
             「已选 N 张」那一行撤了，序号直接标在每张图的左下角（数一看就知道是第几张、删的是哪张）。
             一行放 5 格：9 张 + ➕ = 10 格 = 正好两行，所以"展开只多一行"这条落得下去。 -->
        <view wx:elif="{{active === 'photo'}}" class="strip">
          <view class="th" wx:for="{{previewImages}}" wx:key="*this">
            <image class="th-img" src="{{item}}" mode="aspectFill" />
            <view class="th-x" data-index="{{index}}" catchtap="removeShot">✕</view>
            <text class="th-no">{{index + 1}}</text>
          </view>
          <view class="th th-add {{shotsFull ? 'th-add-dis' : ''}}" catchtap="onAddShot" aria-label="{{t.importScreenshot}}">
            <view class="th-plus glyph-plus"></view>
          </view>
        </view>

        <!-- 链接：一个输入框，提示词吃现网那句 linkDesc，点进去就没了。
             「粘贴」和「保存」那两枚按钮撤了——保存换成右滑那一枚，粘贴交给系统长按。 -->
        <view wx:elif="{{active === 'url'}}" class="field">
          <input
            class="field-input"
            value="{{urlInput}}"
            placeholder="{{t.linkDesc}}"
            placeholder-class="field-ph"
            confirm-type="done"
            bindinput="onUrlInput"
          />
          <view wx:if="{{urlInput}}" class="field-x" catchtap="clearUrl">✕</view>
        </view>

        <!-- 文字：一个原文框（收起一行、展开两行）。标题和归类挪到详情页「编辑」里改，
             所以这一屏只有一个框——站长 10-08 原话「砍一个输入框，只留一个输入框」。 -->
        <textarea
          wx:else
          class="field field-area {{panelOpen ? 'field-area-2' : ''}}"
          value="{{writeBody}}"
          placeholder="{{t.manualDesc}}"
          placeholder-class="field-ph"
          maxlength="2000"
          show-confirm-bar="{{false}}"
          bindinput="onWriteBody"
          bindfocus="onBodyFocus"
          bindblur="onBodyBlur"
        />

        <!-- 「原文翻译」那一枚（站长 10-04 要的小开关，默认关）留在文字这一档，但只在展开态出现：
             500rpx 的面板肚子里只剩"一个框 + 一枚条"，塞不下第三样，而硬塞就得把面板抬高、
             正好顶回站长连说两轮不许挡的那张脸。展开态有这一段富余，够用。
             ⚠️ 这一条放置是我定的，不是他拍过的——现网是收起态就能看到。 -->
        <view wx:if="{{active === 'write' && panelOpen}}" class="wr-sw {{writeTranslate ? 'wr-sw-on' : ''}}" catchtap="onToggleTranslate">
          <text class="wr-sw-lab">{{t.origTranslate}}</text>
          <view class="wr-sw-track"><view class="wr-sw-dot"></view></view>
        </view>

        <!-- 右滑才开始提炼。三档共用同一枚画法，只差圆里那支图形（照片=叠图、链接=链环、文字=钢笔）。
             圆跟着手指走、停在最右、颜色全程不变；是轨道随进度由纸白吃成实心，那一圈白环一直在。 -->
        <template
          wx:if="{{active !== 'photo' || previewImages.length}}"
          is="sld"
          data="{{t, busy, done, dragging, ready, knobRpx, fillPct, sldIcon}}"
        />
      </view>
    </view>

    <!-- 这一行两件事，各一个入口：左边「调亮度」换深浅一档，右边「换背景」导流到
         「我的 → 卡片模板」那一页选图（这里不弹相册——一个功能只留一个入口）。
       两截都是 catchtap：点左边不能顺手把右边那条导流也触发，点整行也不该冒到
       容器的 collapse 上去。 -->
    <view wx:if="{{bgSrc}}" class="home-swap">
      <view class="swap-half" catchtap="onCycleDim" aria-label="{{t.bgDimLabel}}" role="button">
        <text class="swap-text">{{t.bgDimLabel}}</text>
        <view class="dim-dot" style="{{dimDot}}"></view>
      </view>
      <view class="swap-half" catchtap="goHomeBg" aria-label="{{t.homeBgSwap}}" role="button">
        <text class="swap-text">{{t.homeBgSwap}}</text>
        <view class="swap-glyph glyph-chev"></view>
      </view>
    </view>
  </view>
</view>

<!-- 滑动确认那一枚长条。三个模式共用一份，所以写成模板；
     ⚠️ <template is> 不继承页面 data，用到的字段必须一个个显式递进去——
     漏了 t 整句是空的，漏了 knobRpx 圆就永远停在 CSS 那个起点 10rpx（10-08 真跑量出来的：
     data 里 knobRpx 一路走到 456，屏上那枚圆一动不动，四张截图里都是左边那颗）。
     拖动中那条 transition 由 sld-drag 关掉，松手回弹与进位才交还给 CSS 过渡。 -->
<template name="sld">
  <view class="sld {{ready ? '' : 'sld-off'}} {{busy ? 'sld-busy' : ''}} {{done ? 'sld-done' : ''}} {{dragging ? 'sld-drag' : ''}}"
        catchtap="onSldTap"
        bindtouchstart="onSlideStart" catchtouchmove="onSlideMove" bindtouchend="onSlideEnd" bindtouchcancel="onSlideEnd">
    <view class="sld-fill" style="width:{{fillPct}}%"></view>
    <view class="sld-txt">{{busy || done ? t.busyExtract : t.slideExtract}}</view>
    <view class="sld-knob" style="left:{{knobRpx}}rpx"><view class="sld-glyph glyph-{{sldIcon}}"></view></view>
  </view>
</template>
