.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.category-list {
  margin-bottom: 32rpx;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}

.category-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.category-color {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
}

.category-name {
  font-size: 30rpx;
  color: var(--text-primary);
}

.category-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.action-btn {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 8rpx 12rpx;
}

.action-btn.disabled {
  opacity: 0.3;
}

.edit-btn {
  color: var(--accent);
}

.delete-btn {
  color: #e74c3c;
}

.edit-input {
  flex: 1;
  font-size: 30rpx;
  padding: 12rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.edit-actions {
  display: flex;
  gap: 16rpx;
}

.edit-confirm {
  font-size: 28rpx;
  color: var(--accent);
  font-weight: 600;
}

.edit-cancel {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.add-btn {
  text-align: center;
  padding: 28rpx;
  font-size: 30rpx;
  color: var(--accent);
  background: var(--bg-card);
  border-radius: var(--card-radius);
  backdrop-filter: blur(var(--card-blur));
}

.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.dialog-card {
  width: 80%;
  padding: 40rpx;
  border-radius: 24rpx;
}

.dialog-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 32rpx;
}

.dialog-input {
  font-size: 30rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
}

.dialog-actions {
  display: flex;
  justify-content: space-around;
}

.dialog-btn {
  font-size: 30rpx;
  padding: 16rpx 40rpx;
}

.dialog-btn.cancel {
  color: var(--text-secondary);
}

.dialog-btn.confirm {
  color: var(--accent);
  font-weight: 600;
}
