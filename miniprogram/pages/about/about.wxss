.about-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-6) 0 var(--sp-5);
}

/* 墨黑块 + 白字。原来是微信绿渐变，那是默认皮肤，不是这套设计的颜色 */
.app-icon {
  width: 148rpx;
  height: 148rpx;
  border-radius: 44rpx;
  background: #23252c;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--sp-4);
  box-shadow: var(--sh-card);
}

.icon-text {
  font-size: 68rpx;
  font-weight: 700;
  line-height: 1;
  color: #ffffff;
}

.app-name {
  font-size: var(--fs-h1);
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
  margin-bottom: var(--sp-1);
}

.app-version {
  font-size: var(--fs-meta);
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--text-secondary);
}

.about-card {
  padding: var(--sp-4);
}

.card-title {
  display: block;
  font-size: var(--fs-tiny);
  font-weight: 700;
  letter-spacing: 1.6rpx;
  color: var(--text-secondary);
  margin-bottom: var(--sp-3);
}

.card-text {
  display: block;
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  color: var(--text-primary);
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-2);
}

.feature-dot {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--accent);
  /* 用色块做圆点，不用 • 字符——字符的位置跟不齐行高 */
  color: transparent;
  overflow: hidden;
  margin-top: 12rpx;
}

.feature-text {
  flex: 1;
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  color: var(--text-primary);
}

.contact-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--sp-3);
}

.contact-label {
  font-size: var(--fs-meta);
  color: var(--text-secondary);
}

.contact-value {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-primary);
}

.copyright {
  display: block;
  text-align: center;
  font-size: var(--fs-tiny);
  letter-spacing: 0.4rpx;
  color: var(--text-secondary);
  padding: var(--sp-5) 0 var(--sp-6);
}
