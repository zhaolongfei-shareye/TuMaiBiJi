<view class="container {{themeClass}}">
  <!-- 头部：logo 靠左，右侧应用名 + slogan，跟详情页"左块右文"那条母题一致 -->
  <view class="me-header card">
    <image class="brand-logo" src="/assets/logo.png" mode="aspectFill"></image>
    <view class="brand-text">
      <text class="brand-name">图麦笔记</text>
      <text class="brand-slogan">{{t.slogan}}</text>
    </view>
  </view>

  <!-- 分享入口退化成菜单里的一行：这一行本身就是 button[open-type=share]，
       点它直接弹微信原生分享面板。
       为什么不用"透明按钮盖在一行普通菜单上"那种做法：实测那颗绝对定位的 button
       在这套 flex 行里只量到半行宽（184/332），点右半边不触发——命中面积反而变小了。
       行即按钮，命中面积天然就是整行，也不用再对齐两层。
       右边那句奖励承诺取自 /api/user/quota，服务端认账才写；额度读回来之前留空。 -->
  <view class="menu-group card">
    <button class="menu-item share-row" open-type="share" aria-label="{{t.shareToFriend}}">
      <text class="menu-label">{{t.shareToFriend}}</text>
      <view class="menu-right">
        <text class="menu-value">{{shareValue}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </button>
    <!-- 额度这行只能看不能点，所以不给箭头；数字没读回来时整行不占位 -->
    <view class="menu-item" wx:if="{{quotaText}}">
      <text class="menu-label">{{t.quotaLabel}}</text>
      <view class="menu-right">
        <text class="menu-value">{{quotaText}}</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onNavigate" data-page="profile">
      <text class="menu-label">{{t.navProfile}}</text>
      <view class="menu-right">
        <text class="menu-value">{{profileSummary}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onNavigate" data-page="categories">
      <text class="menu-label">{{t.categories}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onNavigate" data-page="wallpaper">
      <text class="menu-label">{{t.wallpaper}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <!-- 私密密码紧跟外观设置：两条都是"这台手机上的我的设置"，
         原来排在邮箱下面，跟"关于/反馈邮箱/注销"那组混在一起不好找。 -->
    <view class="menu-item" bindtap="onOpenPwdPanel">
      <text class="menu-label">{{t.privatePassword}}</text>
      <view class="menu-right">
        <text class="menu-value">{{privateSet ? t.privatePasswordSet : t.privatePasswordNotSet}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-group card">
    <view class="menu-item" bindtap="onNavigate" data-page="about">
      <text class="menu-label">{{t.about}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onCopy" data-value="{{contactEmail}}">
      <text class="menu-label">{{t.feedbackEmail}}</text>
      <view class="menu-right">
        <text class="menu-value">{{contactEmail}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item menu-danger" bindtap="onDeleteAccount">
      <text class="menu-label">{{t.deleteAccount}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 私密密码面板：自绘两层，不用 wx.showModal(editable)——
       那条只有一个输入框、数字明文可见，也没有"再输一次"的位置。 -->
  <view wx:if="{{pwdPanel}}" class="pwd-mask" bindtap="onClosePwdPanel"></view>
  <view wx:if="{{pwdPanel}}" class="pwd-sheet card">
    <view class="pwd-title">{{t.privatePassword}}</view>
    <view class="pwd-hint">{{t.privatePasswordHint}}</view>
    <input
      class="pwd-input"
      type="number"
      maxlength="6"
      password="{{true}}"
      value="{{pwd1}}"
      placeholder="{{t.privatePasswordNew}}"
      placeholder-class="pwd-ph"
      bindinput="onPwdInput1"
    />
    <input
      class="pwd-input"
      type="number"
      maxlength="6"
      password="{{true}}"
      value="{{pwd2}}"
      placeholder="{{t.privatePasswordAgain}}"
      placeholder-class="pwd-ph"
      bindinput="onPwdInput2"
    />
    <view class="pwd-save" bindtap="onPwdSave">{{t.privatePasswordOk}}</view>
    <view wx:if="{{privateSet}}" class="pwd-reset" bindtap="onPwdReset">{{t.privatePasswordReset}}</view>
    <view class="pwd-cancel" bindtap="onClosePwdPanel">{{t.cancel}}</view>
  </view>
</view>
