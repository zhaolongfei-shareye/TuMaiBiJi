<view class="container {{themeClass}}">
  <!-- 头部这块：底图贴屏边铺满；接缝那道弧的方向不动（站长 10-04 指出我改反了，已改回）——
       仍是"下面那一层往上凸出来盖住图的下沿"，只是这一层的颜色换成了页面底，
       所以它不再是一张卡，只是把那道弧留住。 -->
  <view class="head">
    <view class="head-band {{bgSrc ? 'has-bg' : ''}}">
      <image wx:if="{{bgSrc}}" class="head-img" style="{{imgStyle}}" src="{{bgSrc}}" mode="aspectFill" />
      <!-- 「调亮度」那一枚点拧的就是这一层：dimScrim 空串＝全铺（最沉那一档＝现网样子），
           opacity:0＝一点不压（＝原图亮度）。三页同一个本机键，所以一起沉、一起亮。 -->
      <view wx:if="{{bgSrc}}" class="head-scrim" style="{{dimScrim}}"></view>
      <!-- 左上角这行大字与首页那一行是同一档量（--fs-h1 / 700 / -1rpx / left 32 top 22），
           站长 10-01：三个 tab 的首页风格要一致，这一页原来只有右上角那枚药丸。
           站长 10-04：这一行不再写死「我的」，改成跟着下面那枚药丸走——停在设置就写设置、
           翻到关于就写关于，让这行大字报出当前这一屏是哪一档。-->
      <view class="h1">{{tab === 'about' ? t.pillAbout : t.pillSettings}}</view>
      <!-- 数字没从 /api/user/quota 读回来之前整块不占位：宁可空着，也不先摆一个猜的数 -->
      <view wx:if="{{scoreText}}" class="score">
        <text class="score-n">{{scoreText}}</text>
        <text class="score-l">{{t.brainScore}}</text>
      </view>
    </view>
    <!-- 站长 10-04：这一行不再是一张卡——那层"把卡色叠在页底上画成不透明"的补丁撤了，
         换成页面底同一个色，下沿两角也不再收圆；留着的只有往上凸那道弧。
         它在 .head 里面，为的是吃那块顶回去的 24 内缩、贴屏边把图的下沿盖住。 -->
    <view class="sheet">
      <image class="sheet-logo" src="{{logoSrc}}" mode="aspectFill" />
      <view class="sheet-text">
        <text class="sheet-name">{{nameText}}</text>
        <text class="sheet-slogan">{{sloganText}}</text>
      </view>
      <!-- 站长 10-01 晚：这枚药丸从图上搬进 LOGO 这一行的最右。原来它浮在照片右上角，
           和左上角那行「我的」抢同一条视线；搬进来之后这一行就是「圆 LOGO + 两行字 + 两个档」。 -->
      <view class="pill">
        <view class="seg {{tab === 'set' ? 'on' : ''}}" bindtap="onTab" data-key="set">{{t.pillSettings}}</view>
        <view class="seg {{tab === 'about' ? 'on' : ''}}" bindtap="onTab" data-key="about">{{t.pillAbout}}</view>
      </view>
    </view>
  </view>

  <!-- ---------------- 设置：能操作的那几样 ---------------- -->
  <block wx:if="{{tab === 'set'}}">
    <view class="menu-group card">
      <view class="menu-item" bindtap="onNavigate" data-page="profile">
        <text class="menu-label">{{t.navProfile}}</text>
        <text class="menu-hint">{{t.navProfileTip}}</text>
        <view class="ico"><view class="cv"></view></view>
      </view>
      <view class="menu-item" bindtap="onNavigate" data-page="wallpaper">
        <text class="menu-label">{{t.wallpaper}}</text>
        <text class="menu-hint">{{t.wallpaperTip}}</text>
        <view class="ico"><view class="cv"></view></view>
      </view>
      <view class="menu-item" bindtap="onNavigate" data-page="categories">
        <text class="menu-label">{{t.categories}}</text>
        <text class="menu-hint">{{t.categoriesTip}}</text>
        <view class="ico"><view class="cv"></view></view>
      </view>
      <!-- 私密密码：这一行只是门，输入整块搬到屏幕下方那一层（站长 10-01 晚：
           「不在原菜单处理方式」——原来就地展开成两个长输入框，混在列表里像另一行菜单）。
           门仍然只吃服务端那条读数，读没读回来决定右边按钮是「重置密码」还是「确定」。 -->
      <view class="menu-item {{pwdOpen ? 'open' : ''}}" bindtap="onTogglePwd">
        <text class="menu-label">{{t.privatePassword}}</text>
        <text class="menu-hint">{{t.privatePasswordTip}}</text>
        <view class="ico"><view class="cv"></view></view>
      </view>
      <!-- 我的邮箱：这一行不给小字说明（右侧那一档要留给现读回来的地址，两处都要字就挤了），
           说明整句搬进点开的这一层。地址没读回来之前右侧什么都不摆——连「未填写」也不摆，
           那也是一个猜的数（这页另外几处读不到就整块不占位是同一条规矩）。 -->
      <view class="menu-item {{emailOpen ? 'open' : ''}}" bindtap="onToggleEmail">
        <text class="menu-label">{{t.myEmail}}</text>
        <view class="menu-right">
          <text wx:if="{{emailLoaded}}" class="menu-value me-email-val">{{emailText || t.myEmailUnset}}</text>
          <view class="ico"><view class="cv"></view></view>
        </view>
      </view>
      <view class="menu-item menu-danger" bindtap="onDeleteAccount">
        <text class="menu-label">{{t.deleteAccount}}</text>
        <view class="ico"><view class="cv"></view></view>
      </view>
    </view>

    <!-- 图片云空间（方案 §3.1.8）：过了 0.9 才出现的脚注，不是菜单里的一格——
         它没有能点进去的页面，画成 menu-item 就是给了一个按不动的门（站长那条
         "一个功能只留一个入口"）。比值是**全站**口径，所以这句说的是这一池水，
         不是"你的空间"。 -->
    <view wx:if="{{storageWarn}}" class="me-storage">
      <text class="me-storage-k">{{t.storageSpace}}</text>
      <text class="me-storage-v">{{storageTip}}</text>
    </view>
  </block>

  <!-- ---------------- 关于：只能看的那几样，直接在头部下面生成，不分二级 ---------------- -->
  <block wx:else>
    <view class="card about-lead">
      <view class="about-who">
        <text class="about-name">{{t.appName}}</text>
        <text class="about-ver">v{{version}}</text>
      </view>
      <text class="about-p">{{introLead}}</text>
    </view>

    <view class="menu-group card">
      <view class="menu-item" bindtap="onCopy" data-value="{{site}}">
        <text class="menu-label">{{t.officialSite}}</text>
        <view class="menu-right">
          <text class="menu-value">{{site}}</text>
          <view class="ico"><view class="cv"></view></view>
        </view>
      </view>
      <view class="menu-item" bindtap="onCopy" data-value="{{contactEmail}}">
        <text class="menu-label">{{t.feedbackEmail}}</text>
        <view class="menu-right">
          <text class="menu-value">{{contactEmail}}</text>
          <view class="ico"><view class="cv"></view></view>
        </view>
      </view>
      <!-- 这一行本身就是 button[open-type=share]：点它直接弹微信分享面板。
           右边不再挂那句「新写作者 +10」（站长 10-02：撤掉）——同一个数下面那块规则
           第二行已经说了，一行右边再摆一遍就是两张卡各说一遍。这一行只留箭头。 -->
      <button class="menu-item share-row" open-type="share" aria-label="{{t.shareToFriend}}">
        <text class="menu-label">{{t.shareToFriend}}</text>
        <view class="menu-right">
          <view class="ico"><view class="cv"></view></view>
        </view>
      </button>
    </view>

    <!-- 魅力值规则（站长 10-01 深夜：原来这一组最底下那行「魅力 + 数字」撤掉，换成一块规则）。
         站长 10-02 真机打回第二版：三行之间不要横线——"这是一件事三个要点，是完整的论述，
         不是区分三件事"。所以线撤掉，每行前面挂一枚点，行高收回到一行的呼吸，读下来是一段话。
         三个数仍由 loadQuota 从 /api/user/quota 填，读不到整块不出现。 -->
    <view wx:if="{{mindRules.length}}" class="card rules">
      <text class="rules-title">{{t.mindRulesTitle}}</text>
      <view class="rule" wx:for="{{mindRules}}" wx:key="label">
        <view class="rdot" style="{{ruleDotStyle}}"></view>
        <text class="rule-label">{{item.label}}</text>
        <text class="rule-value">{{item.value}}</text>
      </view>
    </view>

    <text class="copyright">{{t.copyright}}</text>
  </block>

  <!-- 私密密码这一层（站长 10-01 深夜第二次改口径：撤掉底部 1/3 那一份，照「分类管理」
       改成整屏遮罩 + 居中卡）。从上到下：功能名 → 使用场景说明 → 校验提醒 + 六个方格 →
       一行两枚（左退出、右动作）。六个格子是同一只隐藏 input 的显示面（六只 input 要点六次
       才起键盘）。输完第一遍自动跳到第二遍，第二遍输满六位才真的发请求。
       点遮罩空白处收回，和分类管理那一页一个手势（卡自己 catchtap 挡住，不冒泡）。
       站长 10-02 iPhone 11 真机两条：①这只 input 原来挂 password="{{true}}"，iOS 的密文点是
       系统那一层画的，不吃 CSS opacity——所以六个格子左边漏出一串点和光标（他说的"锚点错位"）。
       现在改成普通数字输入，字由样式染成透明，屏幕上只剩我们自己的六枚点；
       ②键盘盖住了下面两枚按钮 → adjust-position 关掉（不让微信去顶整页），卡自己坐到上面去。 -->
  <view wx:if="{{pwdOpen}}" class="pwd-mask" bindtap="onClosePwdPanel">
    <view class="pwd-card card" catchtap="">
      <text class="pwd-name">{{pwdName}}</text>
      <text class="pwd-scene">{{pwdScene}}</text>
      <text wx:if="{{pwdEntering}}" class="pwd-tip">{{pwdTip}}</text>
      <view wx:if="{{pwdEntering}}" class="pwd-boxes">
        <view wx:for="{{[0, 1, 2, 3, 4, 5]}}" wx:key="index"
          class="pwd-cell {{pwdBuf.length > index ? 'fill' : ''}}"></view>
        <input class="pwd-capture" type="number" maxlength="6" adjust-position="{{false}}"
          style="left:{{(pwdBuf.length > 5 ? 5 : pwdBuf.length) * 92}}rpx"
          focus="{{pwdFocus}}" value="{{pwdBuf}}" bindinput="onPwdBuf" />
      </view>
      <view class="pwd-two">
        <view class="pwd-btn ghost" bindtap="onClosePwdPanel">{{t.cancel}}</view>
        <view wx:if="{{pwdEntering}}" class="pwd-btn primary" bindtap="onPwdOk">{{t.privatePasswordOk}}</view>
        <view wx:else class="pwd-btn danger" bindtap="onPwdReset">{{t.privatePasswordReset}}</view>
      </view>
    </view>
  </view>

  <!-- 我的邮箱这一层：几何全部抄上面那一层（遮罩 rgba(20,20,28,.55)、卡宽 620rpx、
       离顶 180rpx、一行两枚各占一半），只是把六个格子换成一只普通输入框。
       输入框预填的是**现读回来的那一条**（不是本机存的），所以 me.js 在读没回来之前不让打开——
       预填成空再把人引导去点保存，就等于替他把原来那条清了。 -->
  <view wx:if="{{emailOpen}}" class="me-email-mask" bindtap="onCloseEmailPanel">
    <view class="me-email-card card" catchtap="">
      <text class="me-email-name">{{t.myEmail}}</text>
      <text class="me-email-scene">{{t.myEmailScene}}</text>
      <input class="me-email-field" type="text" confirm-type="done" adjust-position="{{false}}"
        focus="{{emailFocus}}" placeholder="{{t.myEmailPlaceholder}}" placeholder-class="me-email-ph"
        value="{{emailBuf}}" bindinput="onEmailBuf" bindconfirm="onEmailSave" />
      <view class="me-email-two">
        <view class="me-email-btn ghost" bindtap="onCloseEmailPanel">{{t.cancel}}</view>
        <view class="me-email-btn primary" bindtap="onEmailSave">{{t.myEmailSave}}</view>
      </view>
    </view>
  </view>
</view>
