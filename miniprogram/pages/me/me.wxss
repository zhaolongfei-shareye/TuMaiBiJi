.me-header {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-4);
  margin-top: var(--sp-5);
}

.brand-logo {
  flex: none;
  width: 128rpx;
  height: 128rpx;
  border-radius: 40rpx;
  /* 原来这里垫了一层 --chip-idle 当底，因为旧 logo 自己不带底色。
     新 logo 是透明底圆标，再垫就会在四个角露出一块圆角方板。 */
}

.brand-text {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.brand-name {
  font-size: var(--fs-h2);
  font-weight: 800;
  letter-spacing: -0.8rpx;
  color: var(--text-primary);
}

.brand-slogan {
  font-size: var(--fs-meta);
  line-height: var(--lh-tight);
  color: var(--text-secondary);
}

/* ---------- 分享卡 ---------- */
.share-card {
  padding: var(--sp-4);
}

.share-hint {
  display: block;
  font-size: var(--fs-meta);
  line-height: var(--lh-tight);
  color: var(--text-secondary);
  margin-bottom: var(--sp-3);
}

/* 小程序 button 默认带一堆样式，这里全部推平，只当一块可点的主按钮用。
   配色跟 .btn-primary 同一对（--accent 底 + --bg-page 字）：不能用 --bg-card，
   深色壁纸下它是半透明白，压在亮色按钮上等于把字抹掉。 */
.share-btn {
  margin: 0;
  padding: 0;
  height: 88rpx;
  line-height: 88rpx;
  width: 100%;
  border-radius: var(--r-pill);
  background: var(--accent);
  color: var(--bg-page);
  font-size: var(--fs-body);
  font-weight: 800;
  letter-spacing: -0.4rpx;
  border: none;
}

.share-btn::after {
  border: none;
}

.share-btn:active {
  opacity: 0.86;
}

.menu-group {
  padding: 0 var(--sp-4);
  overflow: hidden;
}

/* 分组内的分隔线和卡片外描边同色同粗，不然一行里会出现两种"线" */
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: var(--w-edge) solid var(--card-edge);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: var(--fs-body);
  font-weight: 700;
  letter-spacing: -0.3rpx;
  color: var(--text-primary);
}

.menu-value {
  font-size: var(--fs-meta);
  color: var(--text-tertiary);
  margin-right: var(--sp-1);
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-arrow {
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--text-tertiary);
}

.container {
  padding-bottom: 140rpx;
}
