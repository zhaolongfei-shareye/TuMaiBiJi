.container {
  padding-bottom: 140rpx;
}

/* ---------- 头部：底图 + 盖在它下沿的圆角留白卡 ----------
   图用的是「卡片模板」最上面那四个位置里勾了「背景」的那一张（poster.homeBg()），
   和首页、新建页同一个来源、同一个取图口，这一页不开第二个上传入口。
   可见高度 502 = 视口 1506 的三分之一；卡片往上盖住 40，所以这块盒子是 542。 */
.head {
  position: relative;
  /* .container 自带 24rpx 左右内边距，而这一块的口径是"图贴屏边、只有下方两角收圆"，
     所以自己把那份内边距顶回去。这里写死 24rpx 而不是 calc(-var(--sp-3))：
     真跑尺子量过，带 calc 的这条在这份编译里整条规则被丢掉，页面直接不渲染。
     改了 --sp-3 要记得同步这里——`验-我的页改版-真跑.js` 有一条钉"留白卡左右贴屏边"。 */
  margin-left: -24rpx;
  margin-right: -24rpx;
}

.head-band {
  position: relative;
  height: 542rpx;
  overflow: hidden;
  background: var(--bg-page);
}

/* 图按"这一页单独定锚点"摆：aspectFill 只会把画面正中间那一条留在框里，
   人像照的中段是胸口和手，脸会被裁掉。所以图按宽铺满算出真实高度，
   再往上顶 15% 的余量（见 me.js 的 bandGeom），首页和新建页那条不动。 */
.head-img {
  position: absolute;
}

.head-scrim {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  /* 停点取首页那条罩子的前三分之一，同一张图两页的明暗要是一个连续体 */
  background: linear-gradient(180deg, rgba(18, 20, 26, 0.58) 0%, rgba(18, 20, 26, 0.58) 14%,
    rgba(18, 20, 26, 0.5) 58%, rgba(18, 20, 26, 0.44) 100%);
}

/* ---------- 药丸：关于的入口。默认「设置」 ---------- */
.pill {
  position: absolute;
  right: 32rpx;
  top: 24rpx;
  z-index: 4;
  display: flex;
  gap: 4rpx;
  padding: 5rpx;
  border-radius: var(--r-pill);
  background: rgba(242, 239, 233, 0.92);
}

.seg {
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 28rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-meta);
  font-weight: 700;
  color: var(--text-secondary);
}

.seg.on {
  background: var(--accent);
  color: var(--bg-page);
}

/* ---------- MIND 那个大数字：Poppins Thin，压在图右下角 ----------
   站长要的是 iPhone 锁屏时钟那种"细、长、圆"。那版真身是 SF Pro Rounded，
   苹果许可只允许在苹果设备上用、不能打进包分发，所以走开源最接近的一支：
   Poppins Thin 100（OFL，可商用可内嵌）。字体只裁 0-9 十个数字、base64 内嵌，
   1.9KB 进包，不占域名、不会出现"字体还没到、数字先跳一下"。
   数字比上一版收 8 成（126 到 100），英文字跟着收到最小一档字阶 18，并与数字居中。 */
@font-face {
  font-family: 'WtsjMind';
  src: url(data:font/ttf;base64,) format('truetype');
  font-weight: 100;
}

.score {
  position: absolute;
  right: 30rpx;
  bottom: 56rpx;
  z-index: 4;
}

.score-n {
  display: block;
  font-family: 'WtsjMind', 'Poppins', sans-serif;
  font-size: 100rpx;
  font-weight: 100;
  line-height: 0.86;
  color: rgba(242, 239, 233, 0.74);
}

.score-l {
  display: block;
  margin-top: 10rpx;
  /* 字距是加在每个字母后面的，整串会比视觉宽度多出一个字距的尾巴；
     补一个同宽的左内边距，居中才真的对到数字中间 */
  padding-left: 6rpx;
  text-align: center;
  font-size: var(--fs-micro);
  font-weight: 700;
  letter-spacing: 6rpx;
  color: rgba(242, 239, 233, 0.62);
}

/* ---------- 留白区：圆 LOGO 与右边两行字等高（80 = 31×1.25 + 7 + 24×1.4） ---------- */
.sheet {
  position: relative;
  margin-top: -40rpx;
  height: 144rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  /* 深色壁纸那几套的 --bg-card 是半透明的，直接铺在照片上会透出图来。
     这里把同一张卡的颜色叠在自己的页面底色上画一遍，得到的是同一个色、但不透明。 */
  background-color: var(--bg-page);
  background-image: linear-gradient(var(--bg-card), var(--bg-card));
  border-radius: var(--r-card);
}

.sheet-logo {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.sheet-text {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  min-width: 0;
}

.sheet-name {
  font-size: var(--fs-title);
  font-weight: 800;
  letter-spacing: -0.4rpx;
  line-height: 1.25;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sheet-slogan {
  font-size: var(--fs-meta);
  line-height: 1.4;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 条状列表：左名称，右一枚"圆点里住箭头"的一体 icon ---------- */
.menu-group {
  padding: 0 var(--sp-4);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 106rpx;
  border-bottom: var(--w-edge) solid var(--card-edge);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: var(--fs-body);
  font-weight: 700;
  letter-spacing: -0.3rpx;
  color: var(--text-primary);
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.menu-value {
  font-size: var(--fs-meta);
  color: var(--text-secondary);
  white-space: nowrap;
}

.ico {
  flex: none;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 箭头是圆点里的一根折角，不另起一枚：两者永远对齐、永远同一套色 */
.ico .cv {
  width: 13rpx;
  height: 13rpx;
  border-right: 4rpx solid var(--bg-page);
  border-bottom: 4rpx solid var(--bg-page);
  transform: rotate(-45deg);
  margin-left: -4rpx;
}

.menu-item.open {
  background: var(--accent-soft);
}

.menu-item.open .ico .cv {
  transform: rotate(45deg);
  margin-left: 0;
  margin-top: -6rpx;
}

/* 注销这一行只给文字着色，不铺色块：一屏里只有一个动作是不可逆的，
   它要看得见，但不该抢过别人的位置。 */
.menu-item.menu-danger .menu-label {
  color: var(--danger);
}

/* ---------- 分享行：这一行本身就是 button[open-type=share] ----------
   要把小程序 button 的默认样式（灰底、圆角、::after 描边、居中、行高）全部推平。 */
.menu-item.share-row {
  margin: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 0;
  border: none;
  border-bottom: var(--w-edge) solid var(--card-edge);
  border-radius: 0;
  background: transparent;
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 700;
  line-height: var(--lh-tight);
  text-align: left;
  letter-spacing: -0.3rpx;
  white-space: normal;
}

.menu-item.share-row::after {
  border: none;
}

.menu-item.share-row:active {
  background: var(--accent-soft);
}

/* ---------- 私密密码：就地展开，长在列表里面，不再浮一层 ---------- */
.pwd-inline {
  padding: 4rpx 0 30rpx;
  border-bottom: var(--w-edge) solid var(--card-edge);
}

.pwd-hint {
  display: block;
  font-size: var(--fs-meta);
  line-height: var(--lh-body);
  color: var(--text-secondary);
}

.pwd-input {
  margin-top: 16rpx;
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: var(--r-chip);
  background: var(--chip-idle);
  font-size: var(--fs-body);
  letter-spacing: 6rpx;
  color: var(--text-primary);
}

.pwd-ph {
  color: var(--text-tertiary);
  letter-spacing: 0;
}

.pwd-two {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.pwd-btn {
  flex: 1;
  height: 96rpx;
  border-radius: var(--r-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-title);
  font-weight: 800;
}

.pwd-btn.ghost {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--text-secondary);
  background: var(--chip-idle);
}

.pwd-btn.primary {
  background: var(--accent);
  color: var(--bg-page);
}

.pwd-btn.danger {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--danger);
  box-shadow: inset 0 0 0 var(--w-edge) var(--danger-soft);
}

/* ---------- 关于：头部下面直接生成，不分二级 ---------- */
.about-lead {
  padding: 24rpx 28rpx;
}

.about-who {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.about-name {
  font-size: var(--fs-title);
  font-weight: 800;
  letter-spacing: -0.5rpx;
  color: var(--text-primary);
}

.about-ver {
  font-size: var(--fs-label);
  font-weight: 700;
  color: var(--text-secondary);
  background: var(--chip-idle);
  padding: 3rpx 14rpx;
  border-radius: var(--r-pill);
}

.about-p {
  display: block;
  font-size: var(--fs-body);
  line-height: 1.55;
  color: var(--text-primary);
}

/* 「脑力值」那一行只能看，所以不给 icon（icon 的意思是"点得进去"） */
.copyright {
  display: block;
  margin-top: 26rpx;
  text-align: center;
  font-size: var(--fs-tiny);
  color: var(--text-tertiary);
}
