.container {
  padding-bottom: 140rpx;
}

/* ---------- 头部：底图 + 盖在它下沿的圆角留白卡 ----------
   图用的是「卡片模板」最上面那四个位置里勾了「背景」的那一张（poster.homeBg()），
   和首页、新建页同一个来源、同一个取图口，这一页不开第二个上传入口。
   可见高度 502 = 视口 1506 的三分之一；卡片往上盖住 40，所以这块盒子是 542。 */
.head {
  position: relative;
  /* .container 自带 24rpx 左右内边距，而这一块的口径是"图贴屏边、只有下方两角收圆"，
     所以自己把那份内边距顶回去。这里写死 24rpx 而不是 calc(-var(--sp-3))：
     真跑尺子量过，带 calc 的这条在这份编译里整条规则被丢掉，页面直接不渲染。
     改了 --sp-3 要记得同步这里——`验-我的页改版-真跑.js` 有一条钉"留白卡左右贴屏边"。 */
  margin-left: -24rpx;
  margin-right: -24rpx;
}

.head-band {
  position: relative;
  height: 542rpx;
  overflow: hidden;
  background: var(--bg-page);
}

/* 图按"这一页单独定锚点"摆：aspectFill 只会把画面正中间那一条留在框里，
   人像照的中段是胸口和手，脸会被裁掉。所以图按宽铺满算出真实高度，
   再往上顶 15% 的余量（见 me.js 的 bandGeom），首页和新建页那条不动。 */
.head-img {
  position: absolute;
}

/* 与首页 .h1 逐字同一档：字号、字重、字距、位子都一样，两页只差那一行字的内容。
   铺了图才翻纸白（首页是 .container.has-bg .h1，这里盒子不同名，落在这块上）。 */
.h1 {
  position: absolute;
  left: var(--sp-4);
  top: 22rpx;
  z-index: 4;
  font-size: var(--fs-h1);
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
}

.head-band.has-bg .h1 {
  color: rgba(242, 239, 233, 0.96);
}

.head-scrim {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  /* 停点取首页那条罩子的前三分之一，同一张图两页的明暗要是一个连续体 */
  background: linear-gradient(180deg, rgba(18, 20, 26, 0.58) 0%, rgba(18, 20, 26, 0.58) 14%,
    rgba(18, 20, 26, 0.5) 58%, rgba(18, 20, 26, 0.44) 100%);
}

/* ---------- 药丸：关于的入口。默认「设置」 ----------
   10-01 晚从照片上搬进留白卡（见 me.wxml 那段），所以这一块面不再吃纸白 @92%——
   它现在坐在卡底上，面改成淡墨一档，选中那枚仍是墨底纸字，和「我的」页别处的按钮同两档。 */
.pill {
  flex: none;
  display: flex;
  gap: 4rpx;
  padding: 5rpx;
  border-radius: var(--r-pill);
  background: rgba(35, 37, 44, 0.055);
}

.seg {
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 24rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-meta);
  font-weight: 700;
  color: var(--text-secondary);
}

.seg.on {
  background: var(--accent);
  color: var(--bg-page);
}

/* MIND 钉右上角（站长 10-01 晚：和笔记页那三列同一个锚点、同一档数字，
   两个 tab 的右上角对齐，这一格读起来就是"这页的状态数字"）。
   原来它在照片右下角 bottom 56，被下面那张卡的上沿压着。 */
.score {
  position: absolute;
  right: 32rpx;
  top: 24rpx;
  z-index: 4;
}

.score-n {
  display: block;
  font-family: 'WtsjMind', 'Poppins', sans-serif;
  font-size: 64rpx;
  font-weight: 100;
  line-height: 0.86;
  color: rgba(242, 239, 233, 0.74);
}

.score-l {
  display: block;
  margin-top: 10rpx;
  /* 字距是加在每个字母后面的，整串会比视觉宽度多出一个字距的尾巴；
     补一个同宽的左内边距，居中才真的对到数字中间 */
  padding-left: 4rpx;
  text-align: center;
  font-size: var(--fs-micro);
  font-weight: 700;
  letter-spacing: 4rpx;
  color: rgba(242, 239, 233, 0.62);
}

/* ---------- 留白区：圆 LOGO 与右边两行字等高（80 = 31×1.25 + 7 + 24×1.4） ---------- */
.sheet {
  position: relative;
  margin-top: -40rpx;
  height: 144rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  /* 深色壁纸那几套的 --bg-card 是半透明的，直接铺在照片上会透出图来。
     这里把同一张卡的颜色叠在自己的页面底色上画一遍，得到的是同一个色、但不透明。 */
  background-color: var(--bg-page);
  background-image: linear-gradient(var(--bg-card), var(--bg-card));
  border-radius: var(--r-card);
}

.sheet-logo {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.sheet-text {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  /* 药丸搬进来之后这一行是「LOGO + 两行字 + 药丸」：字那一格吃掉剩下的宽度并顶到药丸前，
     药丸才真的钉在最右。两行字本来就是单行截断，宽度不够是省号，不会把药丸挤走。 */
  flex: 1;
  min-width: 0;
}

.sheet-name {
  font-size: var(--fs-title);
  font-weight: 800;
  letter-spacing: -0.4rpx;
  line-height: 1.25;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sheet-slogan {
  font-size: var(--fs-meta);
  line-height: 1.4;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 条状列表：左名称，右一枚"圆点里住箭头"的一体 icon ---------- */
.menu-group {
  padding: 0 var(--sp-4);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 106rpx;
  border-bottom: var(--w-edge) solid var(--card-edge);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: var(--fs-body);
  font-weight: 700;
  letter-spacing: -0.3rpx;
  color: var(--text-primary);
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.menu-value {
  font-size: var(--fs-meta);
  color: var(--text-secondary);
  white-space: nowrap;
}

/* ---------- 魅力值规则（站长 10-01 深夜：这一组最底下那行「魅力 + 数字」撤掉，换成一块规则）
   站长 10-02 真机第二版：三行之间不要横线分隔——"这是一件事三个要点，是完整的论述，
   不是区分三件事"。所以线撤了、行高从菜单那一档 106 收到 72，每行前面挂一枚点，
   与新建页四步指引、Tips 同一枚黄点（色值由 me.js 的 ruleDotStyle 从 palette.TIP_DOT 递进来，
   写进样式表就是第二份色板）。三个数不写死在模板里：由 me.js 的 loadQuota 从 /api/user/quota
   填，读不到整块不出现。 */
.rules {
  padding-bottom: 0;
}

.rules-title {
  display: block;
  font-size: var(--fs-body);
  font-weight: 700;
  letter-spacing: -0.2rpx;
}

.rule {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-height: 72rpx;
}

.rdot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.rule-label {
  font-size: var(--fs-body);
  color: var(--text-secondary);
}

.rule-value {
  margin-left: auto;
  font-family: 'WtsjMind', 'Poppins', sans-serif;
  font-size: var(--fs-title);
  white-space: nowrap;
}

.ico {
  flex: none;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 箭头是圆点里的一根折角，不另起一枚：两者永远对齐、永远同一套色 */
.ico .cv {
  width: 13rpx;
  height: 13rpx;
  border-right: 4rpx solid var(--bg-page);
  border-bottom: 4rpx solid var(--bg-page);
  transform: rotate(-45deg);
  margin-left: -4rpx;
}

.menu-item.open {
  background: var(--accent-soft);
}

.menu-item.open .ico .cv {
  transform: rotate(45deg);
  margin-left: 0;
  margin-top: -6rpx;
}

/* 注销这一行只给文字着色，不铺色块：一屏里只有一个动作是不可逆的，
   它要看得见，但不该抢过别人的位置。 */
.menu-item.menu-danger .menu-label {
  color: var(--danger);
}

/* ---------- 分享行：这一行本身就是 button[open-type=share] ----------
   要把小程序 button 的默认样式（灰底、圆角、::after 描边、居中、行高）全部推平。 */
.menu-item.share-row {
  margin: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 0;
  border: none;
  border-bottom: var(--w-edge) solid var(--card-edge);
  border-radius: 0;
  background: transparent;
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 700;
  line-height: var(--lh-tight);
  text-align: left;
  letter-spacing: -0.3rpx;
  white-space: normal;
}

.menu-item.share-row::after {
  border: none;
}

.menu-item.share-row:active {
  background: var(--accent-soft);
}

/* ---------- 私密密码：就地展开，长在列表里面，不再浮一层 ---------- */
/* ---------- 私密密码这一层（站长 10-01 深夜第二次改口径：撤掉底部 1/3 那一份，
   照「分类管理」那一页改成整屏遮罩 + 卡）----------
   站长 10-02 iPhone 11：居中那一版键盘还是把两枚按钮盖住了——微信只保证"焦点框不被压住"，
   它不知道这张卡底下还有按钮。所以这一层不再居中：卡自己坐到上面去（离顶 180rpx），
   input 那边同时关掉 adjust-position（不让微信去顶整页），两枚按钮永远在键盘上面。
   其余几何一项都不自己发明：遮罩 rgba(20,20,28,.55) / 卡宽 620rpx / 内边距 48·32·32 /
   一行两枚各占一半 —— 与 categories.wxss 的 .dialog-mask / .dialog-card / .dialog-actions 同值。 */
.pwd-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 20, 28, 0.55);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 180rpx;
  z-index: 100;
}

.pwd-card {
  width: 620rpx;
  padding: var(--sp-5) var(--sp-4) var(--sp-4);
  margin-bottom: 0;
  box-shadow: var(--sh-float);
}

/* 第一行是这一格的功能名（他要的"里面是功能名称"） */
.pwd-name {
  display: block;
  font-size: var(--fs-h2);
  font-weight: 700;
  letter-spacing: -0.6rpx;
  color: var(--text-primary);
}

/* 功能名下面那句是"这串密码用在哪"——他要的"使用场景说明要写清楚"，
   两态各一句：没设过说用途，已设过说"要换就得先重置"。
   站长 10-02：这句一回行就压过格子，所以整句降到 --fs-tiny 并收字距——
   中文那句（28 字）在 620 宽里正好走成一行，英文那句长，仍是两行，但已经淡一档。 */
.pwd-scene {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-tiny);
  letter-spacing: -0.2rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

/* 格子上方那句就是"提醒校验"：第一遍说要 6 位数字，第二遍说要再输一次 */
.pwd-tip {
  display: block;
  margin-top: var(--sp-4);
  text-align: center;
  font-size: var(--fs-meta);
  line-height: var(--lh-body);
  color: var(--text-secondary);
}

/* 六格整组居中、每格 78×96：上一版 flex:1 摊满 556rpx 一行，单格 82 宽看着粗（他原话"不精致"） */
.pwd-boxes {
  position: relative;
  /* 定宽居中（6×78 + 5×14 = 538）：那枚取焦的 input 要按格算落点，行宽不定就没法算 */
  width: 538rpx;
  margin: 18rpx auto 0;
  display: flex;
  justify-content: center;
  gap: 14rpx;
}

.pwd-cell {
  position: relative;
  flex: none;
  width: 78rpx;
  height: 96rpx;
  border-radius: var(--r-chip);
  background: var(--chip-idle);
  box-shadow: inset 0 0 0 var(--w-edge) var(--card-edge);
}

.pwd-cell.fill {
  box-shadow: inset 0 0 0 var(--w-edge) var(--accent);
}

/* 输进去的那一位画成一枚点，不画数字：这一串是密码，屏幕前可能站着别人。
   用 ::after 而不是往 wxml 里塞 text 节点，是因为六个格子本来就是空壳。 */
.pwd-cell.fill::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 20rpx;
  margin: -10rpx 0 0 -10rpx;
  border-radius: 50%;
  background: var(--accent);
}

/* 真正收键盘的是这一只，六个格子只是它的显示面：小程序没有"六格各收一个字符"的原生控件，
   做六只 input 反而要点六次才起键盘、删一位还要跳格。
   透明但不能 display:none——那样焦点和键盘都起不来。
   站长 10-02 iPhone 11：原来这只挂的是 password，iOS 的密文点由系统那一层画、不吃 opacity，
   于是格子左边漏出一串点和光标。现在改普通数字输入，字和光标一律染透明——
   opacity 万一被哪个内核忽略，这一串也不会露在屏幕上（这一串是密码，屏幕前可能站着别人）。 */
.pwd-capture {
  position: absolute;
  /* 只盖住"当前该填的那一格"（left 由 wxml 按已填几位推过去，一格 78 + 一缝 14 = 92）。
     原来它是整行铺开：iPhone 上那枚光标是微信画的原生层，不吃 opacity / color /
     caret-color 任何一种（站长 10-03 真机看到的那根竖条就在六格左边的空档里），
     所以只能把它的落点收进格子里，再用 1rpx 字号让光标本身塌掉。 */
  left: 0;
  top: 0;
  width: 78rpx;
  height: 100%;
  opacity: 0;
  color: transparent;
  -webkit-text-fill-color: transparent;
  caret-color: transparent;
  font-size: 1rpx;
  text-align: left;
}

.pwd-two {
  margin-top: var(--sp-5);
  display: flex;
  gap: var(--sp-2);
}

/* 一行两枚各占一半，尺寸抄 categories.wxss 的 .dialog-btn（不再自己定一枚 96rpx 高的） */
.pwd-btn {
  flex: 1;
  text-align: center;
  padding: var(--sp-3) 0;
  border-radius: var(--r-pill);
  font-size: var(--fs-body);
  font-weight: 600;
}

.pwd-btn.ghost {
  color: var(--text-secondary);
  background: var(--chip-idle);
}

.pwd-btn.primary {
  background: var(--btn-bg);
  color: var(--btn-ink);
}

.pwd-btn.danger {
  color: var(--danger);
  box-shadow: inset 0 0 0 var(--w-edge) var(--danger-soft);
}

/* ---------- 关于：头部下面直接生成，不分二级 ---------- */
.about-lead {
  padding: 24rpx 28rpx;
}

.about-who {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.about-name {
  font-size: var(--fs-title);
  font-weight: 800;
  letter-spacing: -0.5rpx;
  color: var(--text-primary);
}

.about-ver {
  /* 版本号是"v + 数字 + 点"，整串跟着全局那一档走，不然半粗半细更难看（字体里有 v 和 .） */
  font-family: 'WtsjMind', 'Poppins', sans-serif;
  font-size: var(--fs-label);
  font-weight: 100;
  color: var(--text-secondary);
  background: var(--chip-idle);
  padding: 3rpx 14rpx;
  border-radius: var(--r-pill);
}

.about-p {
  display: block;
  font-size: var(--fs-body);
  line-height: 1.55;
  color: var(--text-primary);
}

/* 「脑力值」那一行只能看，所以不给 icon（icon 的意思是"点得进去"） */
.copyright {
  display: block;
  margin-top: 26rpx;
  text-align: center;
  font-size: var(--fs-tiny);
  color: var(--text-tertiary);
}
