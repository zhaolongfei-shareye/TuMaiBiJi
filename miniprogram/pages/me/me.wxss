.me-header {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-4);
  margin-top: var(--sp-5);
}

.avatar {
  flex: none;
  width: 128rpx;
  height: 128rpx;
  border-radius: 40rpx;
  background: var(--chip-idle);
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
  min-width: 0;
}

.nickname {
  font-size: var(--fs-h2);
  font-weight: 800;
  letter-spacing: -0.8rpx;
  color: var(--text-primary);
}

.menu-group {
  padding: 0 var(--sp-4);
  overflow: hidden;
}

/* 分组内的分隔线和卡片外描边同色同粗，不然一行里会出现两种"线" */
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: var(--w-edge) solid var(--card-edge);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: var(--fs-body);
  font-weight: 700;
  letter-spacing: -0.3rpx;
  color: var(--text-primary);
}

.menu-value {
  font-size: var(--fs-meta);
  color: var(--text-tertiary);
  margin-right: var(--sp-1);
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-arrow {
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--text-tertiary);
}

.container {
  padding-bottom: 140rpx;
}
