.me-header {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-5) var(--sp-4);
  margin-top: var(--sp-5);
}

.avatar {
  flex: none;
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  background: var(--chip-idle);
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
  min-width: 0;
}

.nickname {
  font-size: var(--fs-h2);
  font-weight: 700;
  letter-spacing: -0.6rpx;
  color: var(--text-primary);
}

.menu-group {
  padding: 0 var(--sp-4);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-4) 0;
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: var(--fs-body);
  font-weight: 600;
  letter-spacing: -0.3rpx;
  color: var(--text-primary);
}

.menu-value {
  font-size: var(--fs-meta);
  color: var(--text-secondary);
  margin-right: var(--sp-1);
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-arrow {
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--text-secondary);
  opacity: 0.5;
}

.container {
  padding-bottom: 140rpx;
}
