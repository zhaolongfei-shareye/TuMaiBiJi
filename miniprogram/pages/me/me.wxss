.me-header {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-4);
  margin-top: var(--sp-5);
}

.brand-logo {
  flex: none;
  width: 128rpx;
  height: 128rpx;
  border-radius: 40rpx;
  /* 原来这里垫了一层 --chip-idle 当底，因为旧 logo 自己不带底色。
     新 logo 是透明底圆标，再垫就会在四个角露出一块圆角方板。 */
}

.brand-text {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.brand-name {
  font-size: var(--fs-h2);
  font-weight: 800;
  letter-spacing: -0.8rpx;
  color: var(--text-primary);
}

.brand-slogan {
  font-size: var(--fs-meta);
  line-height: var(--lh-tight);
  color: var(--text-secondary);
}

/* ---------- 分享行 ----------
   入口退化成菜单里的一行：这一行本身就是 button[open-type=share]，
   所以要把小程序 button 的那堆默认样式（灰底、圆角、::after 描边、居中、行高）全部推平，
   让它和下面几行列表项长得一模一样——一个按钮态混进来就把节奏打断了。
   选择器写成 .menu-item.share-row：两条规则同为单类时后写的赢，
   .menu-item 在这个文件里更靠后，不加类名组合就会被它的 padding 盖掉。 */
.menu-item.share-row {
  margin: 0;
  width: 100%;
  box-sizing: border-box;
  border: none;
  border-bottom: var(--w-edge) solid var(--card-edge);
  border-radius: 0;
  background: transparent;
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 700;
  line-height: var(--lh-tight);
  text-align: left;
  letter-spacing: -0.3rpx;
  white-space: normal;
}

.menu-item.share-row::after {
  border: none;
}

.menu-item.share-row:active {
  background: var(--accent-soft);
}

.menu-group {
  padding: 0 var(--sp-4);
  overflow: hidden;
}

/* 分组内的分隔线和卡片外描边同色同粗，不然一行里会出现两种"线" */
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: var(--w-edge) solid var(--card-edge);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: var(--fs-body);
  font-weight: 700;
  letter-spacing: -0.3rpx;
  color: var(--text-primary);
}

.menu-value {
  font-size: var(--fs-meta);
  color: var(--text-tertiary);
  margin-right: var(--sp-1);
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-arrow {
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--text-tertiary);
}

/* 注销这一行只给文字着色，不铺色块：一屏里只有一个动作是不可逆的，
   它要看得见，但不该抢过"分享好友"那行的位置。 */
.menu-item.menu-danger .menu-label,
.menu-item.menu-danger .menu-arrow {
  color: var(--danger);
}

.container {
  padding-bottom: 140rpx;
}

/* ---------- 私密密码面板 ----------
   自绘两层，不用 wx.showModal(editable)：那条只有一个输入框、数字明文，
   也没有"再输一次"的位置。这一页没铺背景图，遮罩按常规压暗一档就够。 */
.pwd-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(18, 20, 26, 0.55);
  z-index: 100;
}

.pwd-sheet {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 200rpx;
  z-index: 101;
  padding: 40rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.pwd-title {
  font-size: var(--fs-title);
  font-weight: 800;
  letter-spacing: -0.5rpx;
  color: var(--text-primary);
}

.pwd-hint {
  margin-top: 10rpx;
  font-size: var(--fs-meta);
  color: var(--text-secondary);
}

.pwd-input {
  margin-top: 28rpx;
  height: 88rpx;
  font-size: var(--fs-body);
  letter-spacing: 6rpx;
  color: var(--text-primary);
  border-bottom: var(--w-edge) solid var(--card-edge);
}

.pwd-ph {
  color: var(--text-tertiary);
  letter-spacing: 0;
}

/* 一行两个动作：等宽、同一高度，左边退出右边主操作 */
.pwd-two {
  margin-top: 40rpx;
  display: flex;
  gap: 20rpx;
}

.pwd-btn {
  flex: 1;
  height: 96rpx;
  border-radius: var(--r-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-title);
  font-weight: 800;
}

.pwd-btn.ghost {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--text-secondary);
  background: var(--chip-idle);
}

.pwd-btn.primary {
  background: var(--accent);
  color: var(--bg-page);
}

.pwd-btn.danger {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--danger);
  box-shadow: inset 0 0 0 var(--w-edge) var(--danger-soft);
}
