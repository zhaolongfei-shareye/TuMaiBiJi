.page-title {
  display: block;
  font-size: var(--fs-h1);
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
  margin: var(--sp-5) 0 var(--sp-4);
}

.lang-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.lang-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-3);
  padding: var(--sp-4);
  margin-bottom: 0;
}

.lang-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.lang-label {
  font-size: var(--fs-body);
  font-weight: 700;
  letter-spacing: -0.4rpx;
  color: var(--text-primary);
}

.lang-desc {
  font-size: var(--fs-meta);
  line-height: var(--lh-tight);
  color: var(--text-secondary);
}

.check-mark {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--accent);
  color: var(--bg-page);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
