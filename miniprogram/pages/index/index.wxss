.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-icon, .clear-icon {
  font-size: 32rpx;
  margin-left: 12rpx;
}

.clear-icon {
  color: var(--text-secondary);
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.category-chips {
  display: inline-flex;
  gap: 12rpx;
}

.chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  background: rgba(0, 0, 0, 0.04);
  color: var(--text-secondary);
  transition: all 0.2s;
}

.chip.active {
  background: var(--chip-color, var(--accent));
  color: #ffffff;
}

.loading, .empty {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.note-card {
  position: relative;
  margin-bottom: 16rpx;
  transition: transform 0.15s;
}

.note-card.pinned {
  border-left: 4rpx solid var(--accent);
}

.note-card:active {
  transform: scale(0.98);
}

.note-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
}

.pin-badge {
  font-size: 20rpx;
  background: var(--accent);
  color: #ffffff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.summary {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.tags {
  margin-bottom: 12rpx;
}

.note-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.source-type {
  font-size: 22rpx;
  color: var(--text-secondary);
  background: rgba(0, 0, 0, 0.04);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.time {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.container {
  padding-bottom: 140rpx;
}
