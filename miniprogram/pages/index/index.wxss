.search-input {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--text-primary);
}

.search-icon, .clear-icon {
  font-size: var(--fs-title);
  margin-left: var(--sp-1);
}

.clear-icon {
  color: var(--text-secondary);
}

.search-bar {
  margin: var(--sp-2) 0 var(--sp-3);
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: var(--sp-3);
}

.category-chips {
  display: inline-flex;
  gap: 12rpx;
}

.chip.active {
  background: var(--tone-bg, var(--accent));
  color: var(--tone-ink, var(--bg-page));
}

.loading, .empty {
  text-align: center;
  padding: var(--sp-6) 0;
  color: var(--text-secondary);
  font-size: var(--fs-body);
}

.tags {
  margin-top: var(--sp-2);
}

.container {
  padding-bottom: 160rpx;
}
