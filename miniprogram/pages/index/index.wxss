.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
}

.header .btn-primary {
  font-size: 26rpx;
  padding: 12rpx 28rpx;
}

.loading, .empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.empty .btn-secondary {
  margin-top: 24rpx;
  display: inline-block;
  padding: 16rpx 48rpx;
}

.note-card {
  cursor: pointer;
}

.note-card:active {
  background: #f9f9f9;
}

.tags {
  margin-top: 16rpx;
}

.time {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
}
