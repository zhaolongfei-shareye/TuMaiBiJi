/* 页标题：字号字重与新建页「选择一种方式」那一行完全一致 */
.page-title {
  font-size: var(--fs-h1);
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
  margin: var(--sp-5) 0 var(--sp-4);
}

/* ---------- 搜索条 ----------
   一块饱和色 + 一条横线。输入框不再有"面"（原来那层半透明白盒子撤了），
   字直接坐在卡色上，靠一条下划线表示这里能写；"搜索笔记"是线上的纯文字动作，
   不是按钮——同"获取验证码"那种做法。底色仍由 palette.toneStyle(1) 发下来。
   横线单独画一个元素而不是 border-bottom：这样能给它自己的透明度，
   又不会连带把字也调淡，而且颜色仍只是 --blk-ink 的一份，不引入第二个色值。 */
.sc-card {
  background: var(--blk-bg);
  color: var(--blk-ink);
  padding: 26rpx var(--sp-3) 20rpx;
  margin-bottom: var(--sp-3);
}

/* 卡不是整块点下去的按钮（点它是为了打字），所以不跟着 .card 一起缩放 */
.sc-card:active {
  transform: none;
}

.sc-line {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  height: 64rpx;
}

.sc-rule {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 3rpx;
  background: var(--blk-ink);
  opacity: 0.42;
}

.sc-input {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--blk-ink);
}

.sc-ph {
  color: var(--blk-ink);
  opacity: 0.62;
  font-weight: 600;
}

.sc-x {
  flex: none;
  padding: 0 6rpx;
  font-size: var(--fs-body);
  opacity: 0.7;
}

/* 线上的文字动作：没有底色、没有圆角框，靠字重和位置表示可点 */
.sc-go {
  flex: none;
  padding-left: var(--sp-1);
  font-size: var(--fs-title);
  font-weight: 800;
  letter-spacing: -0.5rpx;
  color: var(--blk-ink);
}

.sc-go:active {
  opacity: 0.66;
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: var(--sp-3);
}

.category-chips {
  display: inline-flex;
  gap: 12rpx;
}

.loading, .empty {
  text-align: center;
  padding: var(--sp-6) 0;
  color: var(--text-secondary);
  font-size: var(--fs-body);
}

.summary {
  font-size: var(--fs-meta);
  line-height: 1.55;
  color: var(--text-secondary);
  margin-bottom: var(--sp-2);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.chev {
  flex: none;
  font-size: var(--fs-body);
  font-weight: 400;
  line-height: 1;
}

.container {
  padding-bottom: 160rpx;
}
