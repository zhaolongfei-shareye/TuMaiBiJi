/* 页标题：字号字重与新建页「选择一种方式」那一行完全一致 */
.page-title {
  font-size: var(--fs-h1);
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
  margin: var(--sp-5) 0 var(--sp-4);
}

/* ---------- 搜索条 ----------
   矮到一行：上下各 16rpx 的留白 + 88rpx 的控件，总高比新建页那三张卡折叠时（144rpx）还矮。
   底色由 palette.toneStyle(1) 发下来，和新建页 URL 卡同一块蓝；输入框和按钮用 app.wxss
   里那份共享定义，这里只把它们摆成一行，并给按钮改宽度（.act 默认 flex:1 是通栏用的）。 */
.sc-card {
  background: var(--blk-bg);
  color: var(--blk-ink);
  padding: var(--sp-2) var(--sp-3);
  margin-bottom: var(--sp-3);
}

/* 卡不是整块点下去的按钮（点它是为了打字），所以不跟着 .card 一起缩放 */
.sc-card:active {
  transform: none;
}

.sc-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.sc-box {
  flex: 1;
  min-width: 0;
  margin-top: 0;
}

.sc-btn {
  flex: none;
  padding: 0 var(--sp-3);
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: var(--sp-3);
}

.category-chips {
  display: inline-flex;
  gap: 12rpx;
}

.loading, .empty {
  text-align: center;
  padding: var(--sp-6) 0;
  color: var(--text-secondary);
  font-size: var(--fs-body);
}

.summary {
  font-size: var(--fs-meta);
  line-height: 1.55;
  color: var(--text-secondary);
  margin-bottom: var(--sp-2);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.chev {
  flex: none;
  font-size: var(--fs-body);
  font-weight: 400;
  line-height: 1;
}

.container {
  padding-bottom: 160rpx;
}
