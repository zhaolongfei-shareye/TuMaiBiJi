<view class="container {{themeClass}} {{bgSrc ? 'has-bg' : ''}}">
  <!-- 头部那一段铺形象图（和新建页同一张、同一个开关、同一个取图口）。
       列表不铺：一行行字压在照片上，滚起来字和图打架——这是 09-28 那版效果图里
       A/C 两条路选下来的 C。图做成 fixed，滚到哪儿它都在头部那一段。 -->
  <image wx:if="{{bgSrc}}" class="page-bg" src="{{bgSrc}}" mode="aspectFill" />
  <view wx:if="{{bgSrc}}" class="page-scrim"></view>

  <view class="page-head">
    <view class="page-title">{{t.notesHeading}}</view>
    <!-- 三个数按全量算，不受搜索词和分类筛选影响 -->
    <text class="page-stats" wx:if="{{statsText}}">{{statsText}}</text>
  </view>

  <!-- 搜索条：一块饱和色，里面只有一条横线——输入框不再有"盒子"，
       字直接坐在色块上，靠一条下划线表示可写。右侧"搜索笔记"是纯文字动作，
       不是按钮（同"获取验证码"那种做法）。底色仍与新建页 URL 卡同一块蓝。 -->
  <view class="card sc-card" style="{{searchSkin}}">
    <view class="sc-line">
      <input
        class="sc-input"
        value="{{searchKeyword}}"
        placeholder="{{t.searchPh}}"
        placeholder-class="sc-ph"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <view wx:if="{{searchKeyword}}" class="sc-x" catchtap="clearSearch">✕</view>
      <view class="sc-go" catchtap="onSearchConfirm">{{t.search}}</view>
      <view class="sc-rule"></view>
    </view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}">
    <view class="category-chips">
      <view 
        class="chip {{selectedCategory === null ? 'active' : ''}}"
        bindtap="selectCategory"
        data-id="{{null}}"
      >
        {{t.allCategories}}
      </view>
      <view 
        class="chip {{selectedCategory === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        bindtap="selectCategory"
        data-id="{{item.id}}"
        style="{{item.toneStyle}}"
      >
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <!-- 这一层只干一件事：铺图时把列表抬到罩层之上（fixed 的图有 z-index，
       静态内容会被它整个盖住）。它以前是"一张纸"，圆角朝上托着列表，
       那条描边和每条笔记自己的描边叠成框套框，09-28 深夜撤了——一条笔记一个框。 -->
  <view class="list-layer">
    <!-- 加载状态 -->
    <view wx:if="{{loading}}" class="loading">{{t.loading}}</view>

    <!-- 空状态 -->
    <view wx:elif="{{notes.length === 0 && !loading}}" class="empty">
      <text>{{t.noNotes}}</text>
    </view>

    <!-- 笔记列表：一条笔记 = 一张描边行卡。D2 把左侧那块 176 方块撤了，
         分类身份退到 meta 行最前面的一枚点 + 分类名（颜色仍由 palette 派生）。
         v5+v6 手风琴：一次开一条；展开行的画法照 v3 中心卡（36 号粗标题 + 4 行概要 +
         脚注 + 操作条），私密笔记展开前弹密码。展开即详情，不再跳独立详情页。 -->
    <view wx:else class="notes-list">
      <view
        class="card note-row {{openIdx === index ? 'open' : ''}}"
        wx:for="{{notes}}"
        wx:key="id"
        bindtap="onRowTap"
        data-idx="{{index}}"
      >
        <view class="row-title">
          <text class="pin" wx:if="{{item.is_pinned}}">{{t.pinned}}</text>{{item.title}}
        </view>
        <!-- 折叠条不露摘要（v5 那条口径）：summary 只在展开态渲染 -->
        <view class="summary" wx:if="{{openIdx === index && item.summary}}">{{item.summary}}</view>
        <view class="row-foot">
          <view class="cat {{item.catRing ? 'is-ring' : ''}}" style="{{item.catStyle}}">
            <view class="cat-dot"></view>
            <text>{{item.catLabel}}</text>
          </view>
          <text class="sep">·</text>
          <text class="src">{{item.source_type_label}}</text>
          <block wx:if="{{item.tagLine}}">
            <text class="sep">·</text>
            <text class="tg">{{item.tagLine}}</text>
          </block>
          <text class="dt">{{item.date_label}}</text>
          <text class="chev">›</text>
        </view>
        <!-- 展开态才出现的操作条；catchtap 让点它不冒泡回 onRowTap（否则一点就收起） -->
        <view class="row-actions" wx:if="{{openIdx === index}}" catchtap="noop">
          <view class="act-btn {{item.is_pinned ? 'on' : ''}}" catchtap="onRowTogglePin" data-idx="{{index}}">{{item.is_pinned ? t.unpin : t.pin}}</view>
          <view class="act-btn" catchtap="onRowEdit" data-idx="{{index}}">{{t.edit}}</view>
          <view class="act-btn danger" catchtap="onRowDelete" data-idx="{{index}}">{{t.delete}}</view>
          <view class="act-btn primary" wx:if="{{!item.is_private}}" catchtap="onRowShare" data-idx="{{index}}">{{t.shareAsImage}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- v7：海报画布藏在屏幕外、不进 fixed——这条是历史坑（fixed 里的原生 canvas 会整体错位）。
       弹窗里显示的是 canvasToTempFilePath 出的成品 <image>，image 进 fixed 是常规做法。 -->
  <canvas id="posterCanvas" type="2d" class="poster-canvas-offscreen" style="width: {{posterW}}rpx; height: {{posterH}}rpx"></canvas>

  <!-- v7：模板独浮弹窗——拉弹窗时上面的展开行已经通过 openIdx=-1 收掉了，页面上只剩这一个浮层。
       搜索条、分类块、列表行、tab 栏在弹窗身后一字不虚；弹窗左右内缩 24、离 tab 留 24。 -->
  <view wx:if="{{templateOpen}}" class="tpl-mask" bindtap="onCancelTemplate"></view>
  <view wx:if="{{templateOpen}}" class="tpl-sheet">
    <view class="tpl-handle" bindtap="onHandleTap"></view>
    <view class="tpl-body" bindtouchstart="onPosterTouchStart" bindtouchend="onPosterTouchEnd">
      <image wx:if="{{posterImagePath}}" class="tpl-poster" src="{{posterImagePath}}" mode="widthFix" style="width: {{posterW}}rpx" />
      <view wx:else class="tpl-loading">{{t.loading}}</view>
      <view class="tpl-swipe-hint">{{t.swipeHint}}</view>
    </view>
    <view class="tpl-actions">
      <view class="tpl-btn" bindtap="onCancelTemplate">{{t.cancel}}</view>
      <view class="tpl-btn primary {{posterImagePath ? '' : 'disabled'}}" bindtap="onSavePoster">{{t.saveToAlbum}}</view>
    </view>
  </view>
</view>
