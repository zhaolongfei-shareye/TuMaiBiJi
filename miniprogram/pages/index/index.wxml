<view class="container {{themeClass}} {{bgSrc ? 'has-bg' : ''}}" bindtap="onBlankTap">
  <!-- v12（站长 10-01 拍）：图只守头部这一段 542，下面整块是一张圆角卡往上盖住它 40，
       于是接缝四个角都是弧——和「我的」页那张 sheet 同一画法、同一个量。
       09-28 那版"图贯穿全屏"到此结束：当时打回的是"纸一圈描边 + 每条笔记又一圈描边"的框套框，
       这张圆角卡不描边，只换底色，所以不会再框套框。
       图取口仍是 utils/poster.js 的 homeBg()，和新建页同一张、同一个开关。
       v18（站长 10-02 夜里拍做减法）：右上角只剩「笔记」这一列，「分享」「种草」两列
       跟着那两个屏一起撤；图上这一行由"分类 + 圆钮"换成"一句 Tips + 三枚裸 icon"。 -->
  <view class="head">
    <image wx:if="{{bgSrc}}" class="head-img" style="{{imgStyle}}" src="{{bgSrc}}" mode="aspectFill" />
    <!-- 这一层就是「调亮度」那一枚点拧的东西：dimScrim 空串＝全铺（最沉那一档＝现网样子），
         opacity:0＝一点不压（＝原图亮度）。与新建页 .page-scrim 同一个数、同一个本机键。 -->
    <view class="head-scrim" style="{{dimScrim}}"></view>
    <view class="h1">{{t.notesHeading}}</view>
    <!-- 一列：笔记。数仍来自服务端那一次 /api/user/quota，本页不自己相加。 -->
    <view class="stats">
      <view class="stat" wx:for="{{stats}}" wx:key="key">
        <text class="n">{{item.n}}</text>
        <text class="l">{{item.l}}</text>
      </view>
    </view>

    <!-- 图上这一行（站长 10-02 第三轮）：左边一句轮播 Tips，右边三枚**裸 icon**——
         圆底和描边整块撤掉，只留中间图形，之间一道竖线区隔，整组紧靠右。
         点搜索：Tips 整条不渲染，搜索那枚就地向左摊成输入框，右边两枚切换 icon 照旧留着；
         点这一行以外的空白缩回，Tips 又回来（缩回不清词，清词是 ✕ 那一枚的活）。
         三枚 icon 一律 catchtap：它们在行内，不该被当成"点了空白"而把搜索收掉。
         Tips 这里不带「Tips：」前缀——右边三枚占掉 216，可用宽只剩 20 个汉字，
         前缀那五个字符会把句子本身吃掉（新建页那条仍然带前缀）。 -->
    <view class="tools">
      <view wx:if="{{searchOpen}}" class="srch" style="{{searchSkin}}" catchtap="noop">
        <view class="glyph-search"></view>
        <input
          class="srch-input"
          focus="{{searchOpen}}"
          value="{{searchKeyword}}"
          placeholder="{{t.searchPh}}"
          placeholder-class="srch-ph"
          confirm-type="search"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
        />
        <view wx:if="{{searchKeyword}}" class="srch-x" catchtap="clearSearch">✕</view>
        <view class="srch-go" catchtap="onSearchConfirm">{{t.search}}</view>
      </view>
      <view wx:else class="tp">
        <block wx:if="{{tips.length}}">
          <view class="tp-dot" style="{{tipDotStyle}}"></view>
          <text class="tp-tx">{{tips[tipIdx]}}</text>
        </block>
      </view>
      <view class="acts">
        <view wx:if="{{!searchOpen}}" class="ic {{searchKeyword ? 'on' : ''}}" catchtap="onOpenSearch" aria-label="{{t.search}}">
          <view class="glyph-search"></view>
        </view>
        <view class="vr"></view>
        <view class="ic {{listMode === 'desk' ? 'on' : ''}}" catchtap="onToggleMode" data-mode="desk" aria-label="{{t.viewDesk}}">
          <view class="glyph-grid"><view class="q"></view><view class="q"></view><view class="q"></view><view class="q"></view></view>
        </view>
        <view class="vr"></view>
        <view class="ic {{listMode === 'rows' ? 'on' : ''}}" catchtap="onToggleMode" data-mode="rows" aria-label="{{t.viewRows}}">
          <view class="glyph-lines"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="sheet">
  <!-- 分类这一行钉在列表区顶上，不跟着月份滚（③）。左沿与下面时间轴同一条 24 内缩；
       「置顶笔记」占住时间轴那一列的 126，chips 从这一列右边才起排——
       多到一排放不下时照旧左右滚，但滚的那一节只从时间轴右侧开始（④）。
       这一行与下面的笔记区之间一条浅虚线（⑤）。左右各外扩 24 再把内缩加回来，
       为的是让那条虚线通到整块圆角卡的边，和效果图同一画法。
       置顶这一档纯文字 + 选中那枚下面一条短黄杠，不做按钮壳（他一贯的口径）。 -->
  <view class="cats">
    <view class="pinb {{pinnedOnly ? 'on' : ''}}" style="{{tipVarStyle}}" catchtap="onTogglePinned">
      <text class="pinb-t">{{t.pinFilter}}</text>
    </view>
    <scroll-view class="cat-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="cat-chips">
        <view
          class="chip all {{selectedCategory === null ? 'active' : ''}}"
          bindtap="selectCategory"
          data-id="{{null}}"
        >
          {{t.allCategories}}
        </view>
        <view
          class="chip tone {{selectedCategory === item.id ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          bindtap="selectCategory"
          data-id="{{item.id}}"
          style="{{item.toneStyle}}"
        >
          {{item.name}}
        </view>
      </view>
    </scroll-view>
    <!-- 处在"只看置顶"这件事，除了左边那条短黄杠，唯一把话说出来的地方 -->
    <text wx:if="{{pinnedOnly}}" class="pinn">{{t.pinnedOnly}}</text>
  </view>

  <!-- v12：列表不再整页滚，改在这块区域里自己滚、滚到底再取下一批。
       内缩挂在 .sheet 的 padding 上，不挂在 scroll-view 自己身上——挂在它身上时
       右侧要给滚动条留位，左右就不等宽了（详情浮窗那一层实测右移 12rpx，同一条坑）。
       v18：这一区里是「左时间轴 + 右纸片墙 / 一行」，月份档和它旁边那枚小黄点跟着一起滚。 -->
  <scroll-view
    class="list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    lower-threshold="160"
    bindscrolltolower="onListToLower"
  >
    <!-- 加载状态 -->
    <view wx:if="{{loading}}" class="loading">{{t.loading}}</view>

    <!-- 空状态 -->
    <view wx:elif="{{notes.length === 0 && !loading}}" class="empty">
      <text>{{t.noNotes}}</text>
    </view>

    <!-- 笔记这一屏（v18）。两种排布共用 index.js layout() 算出的同一份"月—行—枚"坐标：
         纸片墙=同一日期必同一行、一行满 4 枚往下一行续、不同日期必另起一行，每枚再抖一点
         竖向错位和角度；一行模式=一条 88、不画横线、连日期都不显示。
         点一枚纸片 / 一行 = 直接浮详情窗（两档都不就地展开，理由见 index.js 的 onRowTap）；
         私密笔记开窗前先验密码。动作全在详情窗下沿 dock 里。
         一屏上唯一的状态标记是「已分享」那一小块色+白字（①）：置顶、来源这些状态这里
         什么都不画，置顶那件事由分类行左边那一档说。 -->
    <view wx:else class="bodyrow" style="height: {{stageH}}rpx">
      <view class="rail">
        <view class="rail-line"></view>
        <view class="rm" wx:for="{{groups}}" wx:key="mk" style="top: {{item.top}}rpx">
          <view class="rm-dot" style="{{tipDotStyle}}"></view>
          <text class="rm-ym">{{item.ym}}</text>
        </view>
      </view>

      <view class="stage">
        <view class="gp" wx:for="{{groups}}" wx:key="mk" style="top: {{item.top}}rpx; height: {{item.h}}rpx">
          <block wx:if="{{listMode === 'desk'}}">
            <view
              class="note"
              wx:for="{{item.cards}}"
              wx:for-item="c"
              wx:key="id"
              style="left: {{c.x}}rpx; top: {{c.y}}rpx; transform: rotate({{c.r}}deg); z-index: {{c.z}}; {{c.paperStyle}}"
              bindtap="onRowTap"
              data-idx="{{c.i}}"
            >
              <text class="note-t">{{c.ptitle}}</text>
              <view class="note-btm">
                <!-- 头像只在有的时候进左下角，对方没设形象就整枚不渲染、不留空圈（②）；
                     日期因此挪到下面那一行的右端，两件事不打架。 -->
                <view class="note-who" wx:if="{{c.who}}">
                  <view class="glyph-who"></view>
                  <text class="note-name">{{c.who}}</text>
                </view>
                <view class="note-foot">
                  <text class="shared-tag" wx:if="{{c.shared}}" style="{{c.sharedStyle}}">{{t.sharedTag}}</text>
                  <text class="note-date">{{c.tail}}</text>
                </view>
              </view>
            </view>
          </block>

          <view wx:else class="rows">
            <view
              class="rw"
              wx:for="{{item.cards}}"
              wx:for-item="c"
              wx:key="id"
              bindtap="onRowTap"
              data-idx="{{c.i}}"
            >
              <text class="rw-t">{{c.title}}</text>
              <!-- ②那处改口讲的是"这篇打哪儿来"，与排布无关：两种排布都得说同一句话，
                   所以转存来的那篇在一行模式里同样带昵称 + 通用头像，不只在纸片上有。 -->
              <view class="note-who" wx:if="{{c.who}}">
                <view class="glyph-who"></view>
                <text class="note-name">{{c.who}}</text>
              </view>
              <text class="shared-tag" wx:if="{{c.shared}}" style="{{c.sharedStyle}}">{{t.sharedTag}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 翻页那一句挂在排布之外：它不该占掉一格的位置 -->
    <view wx:if="{{loadingMore}}" class="loading-more">{{t.loading}}</view>
  </scroll-view>
  </view>

  <!-- v7 ③：详情浮窗。点一枚纸片 / 一行才浮它，浮上来时列表和分类块被它盖严（同宽 24 内缩），
       「我的笔记」和三个 tab 在窗外原样清晰——背后什么都不垫，只有这一个是活的窗口。
       顶部把手（含「点一下收起」）是回列表的口；动作条钉在窗口下沿。 -->
  <view wx:if="{{detailOpen}}" class="float-mask" bindtap="onCloseDetail"></view>
  <view wx:if="{{detailOpen}}" class="float-sheet" style="{{detailNote.catStyle}}">
    <view class="grip" bindtap="onCloseDetail">
      <view class="grip-bar"></view>
      <text class="grip-tx">{{t.grip}}</text>
    </view>
    <scroll-view class="ds-body" scroll-y show-scrollbar="{{false}}">
      <view class="ds-in">
      <view class="ds-meta">{{detailNote.source_type_label}} · {{detailNote.created_at_label}}</view>
      <view class="ds-h2">{{detailNote.title}}</view>
      <view class="ds-tags" wx:if="{{detailNote.tags && detailNote.tags.length}}">
        <text class="ds-tag" wx:for="{{detailNote.tags}}" wx:key="*this" wx:for-item="tg">{{tg}}</text>
      </view>

      <view class="ds-lab" wx:if="{{detailNote.summary}}">{{t.summaryLabel}}</view>
      <view class="ds-para" wx:if="{{detailNote.summary}}">{{detailNote.summary}}</view>

      <block wx:if="{{detailNote.key_points && detailNote.key_points.length}}">
        <view class="ds-lab">{{t.keyPoints}}</view>
        <view class="ds-pt" wx:for="{{detailNote.key_points}}" wx:key="index" wx:for-item="kp">
          <view class="ds-pt-n">{{index + 1}}</view>
          <view class="ds-pt-x">{{kp}}</view>
        </view>
      </block>

      <view class="ds-lab" wx:if="{{detailNote.source_url}}">{{t.sourceLink}}</view>
      <view class="ds-link" wx:if="{{detailNote.source_url}}" catchtap="openSourceUrl">{{detailNote.source_url}}</view>

      <view class="ds-orig" wx:if="{{detailNote.original_content}}">
        <view class="ds-lab">{{t.originalContent}}</view>
        <view class="ds-sw" catchtap="onToggleOrig">{{origOpen ? t.collapse : t.expand}} ⌄</view>
      </view>
      <view class="ds-para" wx:if="{{origOpen && detailNote.original_content}}">{{detailNote.original_content}}</view>
      <view class="ds-pad"></view>
      </view>
    </scroll-view>

    <!-- 动作条：四枚并排一行（站长 09-30 拍的，覆盖 v3-v7 效果图上"通栏一枚"的画法）。
         「转为笔记卡片」改名「生成笔记卡片」——原名让人以为点完详情页就没了。
         私密笔记那枚不渲染，剩下三枚自动等宽；也不给公开状态那一行。 -->
    <view class="ds-dock">
      <view class="ds-irow">
        <view class="ds-ibtn {{detailNote.is_pinned ? 'on' : ''}}" catchtap="onSheetPin">{{detailNote.is_pinned ? t.unpin : t.pin}}</view>
        <view class="ds-ibtn" catchtap="onSheetEdit">{{t.edit}}</view>
        <view class="ds-ibtn danger" catchtap="onSheetDelete">{{t.delete}}</view>
        <view wx:if="{{!detailNote.is_private}}" class="ds-ibtn primary" catchtap="onSheetToPoster">{{t.shareAsImage}}</view>
      </view>
      <view wx:if="{{shared && !detailNote.is_private}}" class="ds-pub">
        <text class="ds-pub-l">{{t.sharedNow}}</text>
        <text class="ds-pub-act" catchtap="onSheetUnshare">{{t.unshare}}</text>
      </view>
    </view>
  </view>

  <!-- v7：海报画布藏在屏幕外、不进 fixed——这条是历史坑（fixed 里的原生 canvas 会整体错位）。
       弹窗里显示的是 canvasToTempFilePath 出的成品 <image>，image 进 fixed 是常规做法。 -->
  <canvas id="posterCanvas" type="2d" class="poster-canvas-offscreen" style="width: {{canvasW}}rpx; height: {{canvasH}}rpx"></canvas>

  <!-- v7 ④⑤：模板独浮弹窗——拉弹窗时详情窗整个藏起来，页面上只剩这一个浮层，
       背后什么都不垫。取消 / 保存成功 / 点把手三个口收掉弹窗后回到详情窗那一屏（不是回列表）。 -->
  <view wx:if="{{templateOpen}}" class="float-mask" bindtap="onCancelTemplate"></view>
  <view wx:if="{{templateOpen}}" class="float-sheet tpl-sheet">
    <view class="grip" bindtap="onHandleTap">
      <view class="grip-bar"></view>
      <!-- 左右各一句、同一行同一档：右边收窗，左边告诉他这一屏能左右滑。
           原来那句挂在卡片下面，卡片一高就被顶到看不见。 -->
      <text class="grip-tx grip-tx-l">{{t.swipeHint}}</text>
      <text class="grip-tx">{{t.grip}}</text>
    </view>
    <view class="tpl-body" bindtouchstart="onPosterTouchStart" bindtouchend="onPosterTouchEnd">
      <image wx:if="{{posterImagePath}}" class="tpl-poster" src="{{posterImagePath}}" mode="aspectFit" style="width: {{posterW}}rpx; height: {{posterH}}rpx" />
      <view wx:else class="tpl-loading">{{t.loading}}</view>
      <!-- 一共多少套、现在第几套：每套一枚，当前那枚大一点、其余淡一档 -->
      <view class="tpl-dots">
        <view wx:for="{{tplIds}}" wx:key="id"
          class="tpl-dot {{item.id === posterTpl ? 'tpl-dot-on' : ''}}"
          style="background: {{item.color}}"></view>
      </view>
    </view>
    <view class="tpl-dock">
      <!-- 码的开关：只影响这一张成品图，与海报页那条是同一个开关语义 -->
      <view class="tpl-qr" catchtap="onToggleQr">
        <view class="pill {{noQr ? '' : 'pill-on'}}"><view class="pill-dot"></view></view>
        <view class="tpl-qr-text">
          <text class="tpl-qr-label">{{t.qrToggle}}</text>
          <text class="tpl-qr-hint">{{t.qrToggleHint}}</text>
        </view>
      </view>
      <view class="tpl-actions">
        <view class="tpl-btn ghost" bindtap="onCancelTemplate">{{t.cancel}}</view>
        <view class="tpl-btn primary {{posterImagePath ? '' : 'disabled'}}" bindtap="onSavePoster">{{t.saveAndShare}}</view>
      </view>
    </view>
  </view>

  <!-- 微信图片面板那五枚按钮是半透明底，会把我们这一页透出来（站长 10-02 iPhone 11：
       "背景并没有全黑，看到后面杂乱无章"）。这一层盖在它底下那一页上：整屏纯黑，
       连弹窗和底栏一起盖住（底栏是自定义组件、z-index 999，所以这里要压过它）。
       面板一收就由 onSavePoster 的 complete 撤掉，不常驻。 -->
  <view wx:if="{{shareDim}}" class="share-dim"></view>
</view>
