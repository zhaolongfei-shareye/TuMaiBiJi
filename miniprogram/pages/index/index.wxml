<view class="container {{themeClass}}">
  <view class="page-title">{{t.notesHeading}}</view>

  <!-- 搜索卡：整块饱和色，和新建页那张 URL 卡同一块蓝、共用 app.wxss 里同一套
       .face-box / .act 定义，所以输入框和按钮在两页必须是一样高的。
       放大镜只做卡底水印，不进按钮——按钮上只有"搜索"两个字。
       清空放在输入框内的 ✕，跟新建页那条链接框同一做法。 -->
  <view class="card sc-card" style="{{searchSkin}}">
    <!-- 这一层要压在水印图形上面。.glyph 是定位元素（z-index:0），
         不包一层带 position 的容器，卡里的输入框和按钮会被图形盖住。 -->
    <view class="sc-body">
      <view class="sc-label">{{t.search}}</view>
      <view class="sc-desc">{{t.searchScope}}</view>
      <view class="face-box">
        <input
          class="face-input"
          value="{{searchKeyword}}"
          placeholder="{{t.searchPh}}"
          placeholder-class="face-ph"
          confirm-type="search"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
        />
        <view wx:if="{{searchKeyword}}" class="face-x" catchtap="clearSearch">✕</view>
      </view>
      <view class="acts">
        <view class="act solid" bindtap="onSearchConfirm">{{t.searchBtn}}</view>
      </view>
    </view>
    <view class="glyph glyph-search"></view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}">
    <view class="category-chips">
      <view 
        class="chip {{selectedCategory === null ? 'active' : ''}}"
        bindtap="selectCategory"
        data-id="{{null}}"
      >
        {{t.allCategories}}
      </view>
      <view 
        class="chip {{selectedCategory === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        bindtap="selectCategory"
        data-id="{{item.id}}"
        style="{{item.toneStyle}}"
      >
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">{{t.loading}}</view>

  <!-- 空状态 -->
  <view wx:elif="{{notes.length === 0 && !loading}}" class="empty">
    <text>{{t.noNotes}}</text>
  </view>

  <!-- 笔记列表：一条笔记 = 一张描边行卡，颜色集中在左侧方块 -->
  <view wx:else class="notes-list">
    <view
      class="card row"
      wx:for="{{notes}}"
      wx:key="id"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <view class="blk" style="{{item.blockStyle}}">
        <text class="blk-name">{{item.blockName}}</text>
        <text class="blk-date">{{item.date_label}}</text>
        <view class="motif {{item.motif}}"></view>
      </view>
      <view class="blk-body">
        <view class="row-title">
          <text class="pin" wx:if="{{item.is_pinned}}">{{t.pinned}}</text>{{item.title}}
        </view>
        <view class="summary" wx:if="{{item.summary}}">{{item.summary}}</view>
        <view class="row-foot">
          <view class="foot-l">
            <text class="src">{{item.source_type_label}}</text>
            <text wx:if="{{item.tagLine}}"> · {{item.tagLine}}</text>
          </view>
          <text class="chev">›</text>
        </view>
      </view>
    </view>
  </view>
</view>
