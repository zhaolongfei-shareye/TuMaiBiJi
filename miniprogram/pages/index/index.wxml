<view class="container {{themeClass}}">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input 
      class="search-input" 
      placeholder="{{t.search}}" 
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
    />
    <text class="search-icon" wx:if="{{!searchKeyword}}">🔍</text>
    <text class="clear-icon" wx:if="{{searchKeyword}}" bindtap="clearSearch">✕</text>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}">
    <view class="category-chips">
      <view 
        class="chip {{selectedCategory === null ? 'active' : ''}}"
        bindtap="selectCategory"
        data-id="{{null}}"
      >
        {{t.allCategories}}
      </view>
      <view 
        class="chip {{selectedCategory === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        bindtap="selectCategory"
        data-id="{{item.id}}"
        style="{{item.toneStyle}}"
      >
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">{{t.loading}}</view>

  <!-- 空状态 -->
  <view wx:elif="{{notes.length === 0 && !loading}}" class="empty">
    <text>{{t.noNotes}}</text>
  </view>

  <!-- 笔记列表：一条笔记就是一张色卡 -->
  <view wx:else class="notes-list">
    <view 
      class="card {{item.is_pinned ? 'pinned' : ''}}" 
      style="{{item.cardStyle}}"
      wx:for="{{notes}}" 
      wx:key="id"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <view class="card-top">
        <view class="icon-chip">{{item.iconChar}}</view>
        <text class="date">{{item.date_label}}{{item.is_pinned ? ' · ' + t.pinned : ''}}</text>
      </view>
      <view class="eyebrow">{{item.eyebrow}}</view>
      <view class="title">{{item.title}}</view>
      <view class="tags" wx:if="{{item.tags && item.tags.length}}">
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this">{{tg}}</text>
      </view>
      <view class="motif {{item.motif}}"></view>
    </view>
  </view>
</view>
