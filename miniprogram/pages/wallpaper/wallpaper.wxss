.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.page-hint {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
}

.wallpaper-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.wallpaper-item {
  position: relative;
  border-radius: 20rpx;
  padding: 24rpx;
  height: 280rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
  border: 4rpx solid transparent;
  transition: border-color 0.2s;
}

.wallpaper-item.active {
  border-color: var(--accent);
}

.wallpaper-preview-card {
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.preview-line {
  height: 8rpx;
  border-radius: 4rpx;
  margin-bottom: 8rpx;
}

.wallpaper-label {
  font-size: 26rpx;
  font-weight: 500;
}

.check-mark {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 40rpx;
}

.applying-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.applying-text {
  font-size: 30rpx;
  color: var(--text-secondary);
}
