.page-head {
  padding: var(--sp-5) 0 var(--sp-4);
}

.page-title {
  display: block;
  font-size: var(--fs-h1);
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
  margin-bottom: var(--sp-1);
}

.page-hint {
  display: block;
  font-size: var(--fs-meta);
  line-height: var(--lh-body);
  color: var(--text-secondary);
}

.wallpaper-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-3);
}

/* ---------- 分节标题 ----------
   这一页现在管两件事（字体 + 壁纸），所以要有两节。原来那行说明挂在页头，
   现在拆成每节各说一句，免得"只改页面底色"这句话被字体那节误读。 */
.sec-head {
  margin: var(--sp-4) 0 var(--sp-3);
}

.sec-title {
  display: block;
  font-size: var(--fs-h2);
  font-weight: 700;
  letter-spacing: -0.6rpx;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.sec-hint {
  display: block;
  font-size: var(--fs-meta);
  line-height: var(--lh-body);
  color: var(--text-secondary);
}

/* ---------- 界面字体那一排 ----------
   格子里那四个字用它自己的字体写，所以这一排不能用纯文字选项：
   用户点之前就该看见会变成什么样，而不是点完再回来看。
   字体类名（.font-song 等）来自 app.wxss，这里只管形状。 */
.font-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-3);
}

.font-item {
  position: relative;
  box-sizing: border-box;
  padding: var(--sp-3);
  min-height: 180rpx;
  border-radius: var(--r-card);
  border: 4rpx solid var(--card-edge);
  background: var(--bg-card);
  color: var(--text-primary);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: border-color 0.2s;
}

.font-item.active {
  border-color: var(--accent);
}

.font-demo {
  font-size: 46rpx;
  line-height: 1.3;
  letter-spacing: 0;
}

.font-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

.font-label {
  font-size: var(--fs-meta);
  font-weight: 600;
  /* 这一行是说明文字，不是字体演示，所以固定用系统链：
     否则"仿宋"那一格的名字也变成仿宋，四个名字看着像同一档。 */
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  color: var(--text-secondary);
}

/* 壁纸那一格的勾取的是"这一格画的那套主题"的墨色（--wp-label），
   字体这一排没有自己的主题变量，所以另给一套，跟着当前主题走。 */
.font-item .check-mark {
  background: var(--accent);
  color: var(--bg-page);
}

/* 带色阶那两枚的标记：跟名字同一行，不再浮在格子上面（浮着会盖住那条长色块）。
   这里不跟界面字体走——它是压在某个具体主题的格子上的小标签，用系统链最稳。 */
.wp-name {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.tint-flag {
  flex: none;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  font-size: var(--fs-micro);
  font-weight: 700;
  letter-spacing: 0.5rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: var(--wp-label);
  color: var(--wp-opp);
}

.wallpaper-item {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 300rpx;
  padding: var(--sp-4);
  border-radius: var(--r-card);
  border: 4rpx solid transparent;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

/* 选中框的颜色取这一格自己画的那个主题的墨色，不取当前主题的 CSS 变量：
   否则停在深海时去看米白那一格，勾和框会变成深海那套亮蓝。 */
.wallpaper-item.active {
  border-color: var(--wp-label);
}

/* 缩略图：一块色 + 一条中性块 + 两条描边行，色块不随主题变——这正是这套语言的要点 */
.mini {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.mini-blk {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
}

.mini-blk.wide {
  flex: 1;
  width: auto;
}

.mini-ln {
  height: 14rpx;
  border: var(--w-edge) solid transparent;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
}

.mini-ln.short {
  width: 70%;
}

.wallpaper-foot {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}

.wallpaper-label {
  font-size: var(--fs-meta);
  font-weight: 800;
  letter-spacing: -0.2rpx;
  color: var(--wp-label, #23252c);
}

.check-mark {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--wp-label, #23252c);
  color: var(--wp-opp, #ffffff);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 等接口那一瞬的遮罩。原来写死半透明白，深色壁纸下会闪一下白；
   但直接给容器加 opacity 会把"应用中"那行字一起冲淡，所以底色放伪元素上。 */
.applying-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.applying-mask::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-page);
  opacity: 0.6;
}

.applying-text {
  position: relative;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-secondary);
}
