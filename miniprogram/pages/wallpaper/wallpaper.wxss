.page-head {
  padding: var(--sp-5) 0 var(--sp-4);
}

.page-title {
  display: block;
  font-size: var(--fs-h1);
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
  margin-bottom: var(--sp-1);
}

.page-hint {
  display: block;
  font-size: var(--fs-meta);
  line-height: var(--lh-body);
  color: var(--text-secondary);
}

.wallpaper-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-3);
}

.wallpaper-item {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 300rpx;
  padding: var(--sp-4);
  border-radius: var(--r-card);
  border: 4rpx solid transparent;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

/* 选中框的颜色取这一格自己画的那个主题的墨色，不取当前主题的 CSS 变量：
   否则停在深海时去看米白那一格，勾和框会变成深海那套亮蓝。 */
.wallpaper-item.active {
  border-color: var(--wp-label);
}

/* 缩略图：一块色 + 一条中性块 + 两条描边行，色块不随主题变——这正是这套语言的要点 */
.mini {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.mini-blk {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
}

.mini-blk.wide {
  flex: 1;
  width: auto;
}

.mini-ln {
  height: 14rpx;
  border: var(--w-edge) solid transparent;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
}

.mini-ln.short {
  width: 70%;
}

.wallpaper-foot {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}

.wallpaper-label {
  font-size: var(--fs-meta);
  font-weight: 800;
  letter-spacing: -0.2rpx;
  color: var(--wp-label, #23252c);
}

.check-mark {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--wp-label, #23252c);
  color: var(--wp-opp, #ffffff);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.applying-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.applying-text {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-secondary);
}
