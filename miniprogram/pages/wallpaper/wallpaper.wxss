.page-head {
  padding: var(--sp-5) 0 var(--sp-4);
}

.page-title {
  display: block;
  font-size: var(--fs-h1);
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
  margin-bottom: var(--sp-1);
}

.page-hint {
  display: block;
  font-size: var(--fs-meta);
  line-height: var(--lh-body);
  color: var(--text-secondary);
}

/* ---------- 分节标题 ---------- */
.sec-head {
  margin: var(--sp-4) 0 var(--sp-3);
}

.sec-title {
  display: block;
  font-size: var(--fs-h2);
  font-weight: 700;
  letter-spacing: -0.6rpx;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.sec-hint {
  display: block;
  font-size: var(--fs-meta);
  line-height: var(--lh-body);
  color: var(--text-secondary);
}

/* 界面字体那一排的样式已随入口一起删掉（iOS 与安卓真机都证伪，见 wallpaper.wxml 那条注释）。
   字体类 .font-song / .font-fang / .font-kai 仍在 app.wxss 和 tab 栏组件里，没删。 */

/* ---------- 手机模拟预览 ----------
   外框走当前主题的卡片色（它是这一页的壳），里面那一屏走被预览那套主题的字面值。
   整块可点，点下去才调 applyTheme。 */
.stage {
  padding: 28rpx 0 20rpx;
  border-radius: var(--r-card);
  border: var(--w-edge) solid var(--card-edge);
  background: var(--bg-card);
}

.mock {
  width: 396rpx;
  margin: 0 auto;
  padding: 12rpx;
  border-radius: 54rpx;
}

.mock-screen {
  display: flex;
  flex-direction: column;
  height: 636rpx;
  border-radius: 42rpx;
  overflow: hidden;
}

.mock-notch {
  width: 100rpx;
  height: 8rpx;
  margin: 10rpx auto 0;
  border-radius: 4rpx;
  opacity: 0.3;
}

.mock-nav {
  height: 46rpx;
  line-height: 46rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
}

.mock-body {
  flex: 1;
  padding: 12rpx 18rpx;
}

.mock-h1 {
  margin: 4rpx 0 14rpx;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: -0.6rpx;
}

.mock-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.mock-blk {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
}

.mock-lines {
  flex: 1;
}

.mock-ln {
  height: 10rpx;
  margin-bottom: 8rpx;
  border-radius: 5rpx;
}

.mock-ln-short {
  width: 56%;
  margin-bottom: 0;
}

.mock-tabs {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 58rpx;
  border-top: 1rpx solid;
}

.mock-tab {
  width: 40rpx;
  height: 14rpx;
  border-radius: 7rpx;
}

.stage-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: var(--fs-meta);
  line-height: var(--lh-body);
  color: var(--text-secondary);
}

/* 有东西在试看时这行才提亮——它是"下一步该点哪儿"的唯一提示 */
.stage-hint-on {
  font-weight: 800;
  color: var(--text-primary);
}

/* ---------- 壁纸条 ---------- */
.wp-strip {
  width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
  margin-top: var(--sp-4);
  padding: 10rpx 0 0;
}

.wp-strip-inner {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: var(--sp-3);
}

.wp-chip {
  flex: none;
  width: 124rpx;
  text-align: center;
}

/* 每一格画的是"另一套主题"，所以底、描边、勾的颜色全从 itemStyle 带进来（--wp-*）。
   不取当前主题的变量：停在深海时去看米白那一格，勾和框会变成深海那套亮蓝。 */
.wp-tile {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  height: 100rpx;
  padding: 14rpx 12rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--wp-edge);
  border-radius: 16rpx;
  transition: border-color 0.2s;
}

.wp-bar {
  height: 14rpx;
  border-radius: 6rpx;
}

.wp-bar-a {
  width: 30rpx;
}

.wp-bar-b {
  width: 100%;
}

/* 选中态和试看态都不许改 border-width：这一条是分享页那一排踩过的坑——
   边框一粗，这一格就高出去 2px，整排跟着抖（他要求这一排是"固定样式"）。
   所以选中用外环（box-shadow 不占布局），试看用同宽的虚线。 */
.wp-chip-on .wp-tile {
  border-color: var(--wp-label);
  box-shadow: 0 0 0 3rpx var(--wp-label);
}

.wp-chip-prev .wp-tile {
  border-color: var(--wp-label);
  border-style: dashed;
}

/* 勾放在格子内侧靠下：原来浮在角上（-10rpx）会被 scroll-view 的裁剪边切到，
   最后一枚尤其明显。格子 100rpx 高是按这条量出来的：内容区从 16rpx 起，
   两条色带到 50rpx 结束，勾顶在 100-2-8-32 = 58rpx，留出 8rpx 不压色带。 */
.wp-dot {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--wp-label, #23252c);
  color: var(--wp-opp, #ffffff);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
}

.wp-name {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-meta);
  font-weight: 700;
  letter-spacing: -0.2rpx;
  color: var(--text-secondary);
}

.wp-chip-on .wp-name,
.wp-chip-prev .wp-name {
  color: var(--text-primary);
}

/* 这一行是说整句话（怎么试、现在在用哪枚），不是标签，所以不用 18rpx 那一档；
   也不叠 opacity：--text-secondary 已经是退让过的墨，再乘 0.75 在深色壁纸下就读不动了。 */
.strip-foot {
  margin-top: var(--sp-2);
  font-size: var(--fs-tiny);
  line-height: var(--lh-body);
  color: var(--text-secondary);
}

/* 等接口那一瞬的遮罩。原来写死半透明白，深色壁纸下会闪一下白；
   但直接给容器加 opacity 会把"应用中"那行字一起冲淡，所以底色放伪元素上。 */
.applying-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.applying-mask::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-page);
  opacity: 0.6;
}

.applying-text {
  position: relative;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-secondary);
}
