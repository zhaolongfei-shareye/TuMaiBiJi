.page-head {
  padding: var(--sp-5) 0 var(--sp-4);
}

.page-title {
  display: block;
  font-size: var(--fs-h1);
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
  margin-bottom: var(--sp-1);
}

.page-hint {
  display: block;
  font-size: var(--fs-meta);
  line-height: var(--lh-body);
  color: var(--text-secondary);
}

.wallpaper-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-3);
}

.wallpaper-item {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 300rpx;
  padding: var(--sp-4);
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
  border: 4rpx solid transparent;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.wallpaper-item.active {
  border-color: var(--text-primary);
}

/* 缩略图：三块色卡 + 一条中性卡，色卡不随主题变——这正是这套语言的要点 */
.preview-stack {
  display: flex;
  gap: 8rpx;
}

.preview-card {
  flex: 1;
  height: 96rpx;
  border-radius: 16rpx;
}

.preview-bar {
  height: 28rpx;
  border-radius: 8rpx;
  margin-bottom: var(--sp-3);
}

.wallpaper-foot {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}

.wallpaper-label {
  font-size: var(--fs-meta);
  font-weight: 700;
  letter-spacing: -0.2rpx;
  color: var(--wp-label, #23252c);
}

.check-mark {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #23252c;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-shadow: var(--sh-chip);
}

.applying-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.applying-text {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-secondary);
}
