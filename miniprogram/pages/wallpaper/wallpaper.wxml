<view class="container {{themeClass}}">
  <view class="page-head">
    <text class="page-title">{{t.wallpaper}}</text>
    <text class="page-hint">{{t.wallpaperHint}}</text>
  </view>

  <view class="wallpaper-grid">
    <view
      class="wallpaper-item {{item.active ? 'active' : ''}}"
      style="{{item.itemStyle}}"
      wx:for="{{wallpapers}}"
      wx:key="key"
      bindtap="onSelect"
      data-key="{{item.key}}"
    >
      <!-- 缩略预览：一块色 + 一条中性块 + 两条描边行，就是首页那一行的缩影。
           色块不随主题变，这正是这套语言要说的件事 -->
      <view class="mini">
        <view class="mini-blk" style="background: {{item.stack[0]}}"></view>
        <view class="mini-blk wide" style="background: {{item.stack[1]}}"></view>
      </view>
      <view class="mini-ln" style="background: {{item.line}}; border-color: {{item.lineEdge}}"></view>
      <view class="mini-ln short" style="background: {{item.line}}; border-color: {{item.lineEdge}}"></view>

      <view class="wallpaper-foot">
        <text class="wallpaper-label">{{item.label}}</text>
        <view wx:if="{{item.active}}" class="check-mark">✓</view>
      </view>
    </view>
  </view>

  <view wx:if="{{applying}}" class="applying-mask">
    <text class="applying-text">{{t.applying}}</text>
  </view>
</view>
