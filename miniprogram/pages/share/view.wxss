/* 分享落地页：外人打开的，不吃用户壁纸，所以整套颜色写死成 V2 的中性壳。 */
.container {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f4f2ec;
  padding: var(--sp-6) var(--sp-4) var(--sp-6);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #23252c;
}

.loading {
  text-align: center;
  padding: var(--sp-6) 0;
  font-size: var(--fs-body);
  color: #5c6068;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.error-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #23252c;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  margin-bottom: var(--sp-4);
}

.error-text {
  font-size: var(--fs-body);
  color: #5c6068;
}

.eyebrow {
  display: block;
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #9a9ea6;
  margin-bottom: var(--sp-2);
}

.share-card {
  background: #ffffff;
  border: var(--w-edge) solid rgba(35, 37, 44, 0.1);
  border-radius: var(--r-card);
  padding: var(--sp-5) var(--sp-4) var(--sp-5);
}

.card-title {
  display: block;
  font-size: var(--fs-h1);
  font-weight: 800;
  line-height: var(--lh-tight);
  letter-spacing: -1rpx;
  color: #23252c;
}

.card-summary {
  display: block;
  font-size: var(--fs-body);
  line-height: 1.68;
  color: #3c4046;
  margin-top: var(--sp-4);
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
  margin-top: var(--sp-5);
}

.tag {
  font-size: var(--fs-tiny);
  font-weight: 700;
  color: #23252c;
  background: rgba(35, 37, 44, 0.06);
  padding: 8rpx 18rpx;
  border-radius: 14rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-5) var(--sp-1) 0;
}

.brand-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #23252c;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.brand-text {
  font-size: var(--fs-meta);
  font-weight: 600;
  color: #5c6068;
}
