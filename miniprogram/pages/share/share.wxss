.share-canvas {
  width: 100%;
  height: 80vh;
  background: transparent;
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-secondary);
}

.actions-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: var(--sp-2);
  padding: var(--sp-3) var(--sp-3) calc(var(--sp-3) + env(safe-area-inset-bottom));
  background: var(--bg-page);
}

.actions-bar .btn-secondary,
.actions-bar .btn-primary {
  flex: 1;
  text-align: center;
  padding: var(--sp-3) 0;
  font-size: var(--fs-body);
}
