<view class="container">
  <view wx:if="{{loading}}" class="loading">
    <text>{{t.loading}}</text>
  </view>

  <view wx:elif="{{error}}" class="error-state">
    <text class="error-icon">!</text>
    <text class="error-text">{{error}}</text>
  </view>

  <block wx:elif="{{share}}">
    <text class="eyebrow">{{t.sharedNote}}</text>

    <view class="share-card">
      <!-- 作者行：昵称是分享者自己在「分享形象」里填的，只在他主动分享的那一刻才对外可见 -->
      <view wx:if="{{share.author_name}}" class="author-row">
        <view class="author-mark">{{authorInitial}}</view>
        <text class="author-name">{{t.authorLabel}}{{t.colon}}{{share.author_name}}</text>
      </view>

      <text class="card-title">{{share.title}}</text>

      <!-- 分享带图（方案 §3.1.7）：清单是服务端在读这一页时现查的（routes/shares.py 的
           _public_assets），只有 cloud:// 这一个字段从公开口出去。撤回分享之后整页 404，图跟着一起不见。
           ⚠ 这一排画不画得出来**不取决于这一页公不公开**，取决于云开发存储的「读」权限那一档：
           默认「仅创建者可读写」时，别人打开就是九格空白（站长 10-12 报的那条 BUG，10-12 由他在
           控制台把读放开给所有用户）。所以这一排要出问题的话，先去看那一档，别先怀疑这条接口。 -->
      <view wx:if="{{share.assets && share.assets.length}}" class="sv-shots">
        <image wx:for="{{share.assets}}" wx:key="cloud_url"
               class="sv-shot"
               src="{{item.cloud_url}}" mode="aspectFill" lazy-load
               bindtap="onPreviewShot" data-url="{{item.cloud_url}}" />
      </view>

      <text wx:if="{{share.summary}}" class="card-summary">{{share.summary}}</text>

      <view wx:if="{{share.key_points && share.key_points.length}}" class="points">
        <text class="section-label">{{t.keyPoints}}</text>
        <view class="point-item" wx:for="{{share.key_points}}" wx:key="index">
          <text class="point-num">{{index + 1}}</text>
          <text class="point-text">{{item}}</text>
        </view>
      </view>

      <!-- 小程序打不开任意外链，所以"去看原文"= 复制链接，和详情页同一套动作 -->
      <view wx:if="{{share.source_url}}" class="source" bindtap="copySource">
        <text class="section-label">{{t.sourceLink}}</text>
        <text class="source-url">{{share.source_url}}</text>
      </view>

      <view wx:if="{{share.tags && share.tags.length > 0}}" class="tags-row">
        <text wx:for="{{share.tags}}" wx:key="*this" class="tag">#{{item}}</text>
      </view>
    </view>

    <!-- 转存：抄的是这份公开快照，存进自己库之后来源那一栏永久留着 -->
    <view class="save-row {{saved ? 'done' : ''}}" bindtap="saveToMine">
      <text class="save-text">{{saved ? t.alreadySaved : (saving ? t.savingMine : t.saveToMine)}}</text>
    </view>

    <view class="brand-row">
      <view class="brand-mark">麦</view>
      <text class="brand-text">{{t.fromTuMaiBiJi}}</text>
    </view>
  </block>
</view>
