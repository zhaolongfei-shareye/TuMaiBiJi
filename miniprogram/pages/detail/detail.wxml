<view class="container {{themeClass}}">
  <view wx:if="{{loading}}" class="loading">{{t.loading}}</view>

  <view wx:elif="{{note}}" class="detail-wrapper">
    <!-- 头部方块：颜色和构图与列表里那条完全一致（同一套 blockSkinFor） -->
    <view class="card row hero">
      <view class="blk tall" style="{{note.blockStyle}}">
        <text class="blk-name">{{note.blockName}}</text>
        <text class="blk-date">{{note.date_label}}</text>
        <view class="motif {{note.motif}}"></view>
      </view>
      <view class="blk-body">
        <view class="hero-meta">{{note.source_type_label}} · {{note.created_at_label}}</view>
        <view class="hero-title">{{note.title}}</view>
        <view class="tags" wx:if="{{note.tags && note.tags.length}}">
          <text class="tag" wx:for="{{note.tags}}" wx:for-item="tg" wx:key="*this">{{tg}}</text>
        </view>
      </view>
    </view>

    <!-- 操作条单独一排：压在头卡里会和标题抢位置 -->
    <view class="action-bar">
      <view class="icon-btn {{note.is_pinned ? 'on' : ''}}" bindtap="togglePin">
        <text>{{note.is_pinned ? t.unpin : t.pin}}</text>
      </view>
      <view class="icon-btn" bindtap="onEdit">{{t.edit}}</view>
      <view class="icon-btn danger" bindtap="onDelete">{{t.delete}}</view>
    </view>

    <!-- 长文本一律回中性卡：方块只承担"这一条是什么"，不承担阅读 -->
    <view wx:if="{{note.summary}}" class="panel">
      <text class="section-label">{{t.summaryLabel}}</text>
      <text class="summary-text">{{note.summary}}</text>
    </view>

    <view wx:if="{{note.key_points && note.key_points.length}}" class="panel" style="{{note.toneStyle}}">
      <text class="section-label">{{t.keyPoints}}</text>
      <view class="points-list">
        <view class="point-item" wx:for="{{note.key_points}}" wx:key="index">
          <text class="point-num">{{index + 1}}</text>
          <text class="point-text">{{item}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{note.source_url}}" class="panel">
      <text class="section-label">{{t.sourceLink}}</text>
      <text class="link-text" bindtap="openSourceUrl">{{note.source_url}}</text>
    </view>

    <view wx:if="{{note.original_content}}" class="panel">
      <view class="original-header" bindtap="toggleOriginal">
        <text class="section-label">{{t.originalContent}}</text>
        <text class="expand-icon">{{showOriginal ? t.collapse : t.expand}}</text>
      </view>
      <scroll-view wx:if="{{showOriginal}}" class="original-scroll" scroll-y>
        <text class="original-text">{{note.original_content}}</text>
      </scroll-view>
    </view>

    <!-- 底部操作 -->
    <view class="bottom-actions">
      <view class="btn-share" bindtap="onShare">{{t.shareAsImage}}</view>
    </view>
  </view>
</view>
