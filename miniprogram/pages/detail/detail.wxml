<view class="container {{themeClass}}">
  <view wx:if="{{loading}}" class="loading">{{t.loading}}</view>

  <view wx:elif="{{note}}" class="detail-wrapper">
    <!-- 顶部操作栏 -->
    <view class="action-bar card">
      <view class="bar-left">
        <text class="source-badge">{{note.source_type_label}}</text>
      </view>
      <view class="bar-right">
        <view class="icon-btn" bindtap="togglePin">
          <text>{{note.is_pinned ? t.unpin : t.pin}}</text>
        </view>
        <view class="icon-btn" bindtap="onEdit">{{t.edit}}</view>
        <view class="icon-btn danger" bindtap="onDelete">{{t.delete}}</view>
      </view>
    </view>

    <!-- 标题区 -->
    <view class="card header-card">
      <text class="title">{{note.title}}</text>
      <view class="meta-row">
        <text class="time">{{note.created_at_label}}</text>
        <text class="category" wx:if="{{note.category_name}}">#{{note.category_name}}</text>
      </view>
    </view>

    <!-- 摘要 -->
    <view wx:if="{{note.summary}}" class="card section-card">
      <text class="section-label">{{t.summaryLabel}}</text>
      <text class="summary-text">{{note.summary}}</text>
    </view>

    <!-- 要点 -->
    <view wx:if="{{note.key_points && note.key_points.length}}" class="card section-card">
      <text class="section-label">{{t.keyPoints}}</text>
      <view class="points-list">
        <view class="point-item" wx:for="{{note.key_points}}" wx:key="index">
          <text class="point-num">{{index + 1}}</text>
          <text class="point-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 标签 -->
    <view wx:if="{{note.tags && note.tags.length}}" class="card section-card">
      <text class="section-label">{{t.tagsLabel}}</text>
      <view class="tags-wrap">
        <text class="tag-chip" wx:for="{{note.tags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <!-- 原文链接 -->
    <view wx:if="{{note.source_url}}" class="card section-card">
      <text class="section-label">{{t.sourceLink}}</text>
      <text class="link-text" bindtap="openSourceUrl">{{note.source_url}}</text>
    </view>

    <!-- 原文内容（可折叠） -->
    <view wx:if="{{note.original_content}}" class="card section-card">
      <view class="original-header" bindtap="toggleOriginal">
        <text class="section-label">{{t.originalContent}}</text>
        <text class="expand-icon">{{showOriginal ? t.collapse : t.expand}}</text>
      </view>
      <scroll-view wx:if="{{showOriginal}}" class="original-scroll" scroll-y>
        <text class="original-text">{{note.original_content}}</text>
      </scroll-view>
    </view>

    <!-- 底部操作 -->
    <view class="bottom-actions">
      <view class="btn-share" bindtap="onShare">
        <text class="share-icon">📤</text>
        <text>{{t.shareAsImage}}</text>
      </view>
    </view>
  </view>
</view>
