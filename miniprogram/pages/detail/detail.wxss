.loading {
  text-align: center;
  padding: var(--sp-6) 0;
  color: var(--text-secondary);
  font-size: var(--fs-body);
}

.detail-wrapper {
  padding-top: var(--sp-2);
}

/* 头部行卡：方块比列表里那块高一点，给标题腾出三行的位置 */
.hero {
  padding: var(--sp-4);
}

/* v4 那条口径：详情页不要色彩方块，纯文字抬头 */
.hero-flat {
  padding: var(--sp-4);
}

.hero-meta {
  font-size: var(--fs-tiny);
  font-weight: 800;
  letter-spacing: 1rpx;
  color: var(--text-tertiary);
  margin-bottom: 10rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.8rpx;
  line-height: 1.34;
  color: var(--text-primary);
  margin-bottom: 0;
}

.tags {
  margin-top: var(--sp-3);
}

/* 操作条：三个中性胶囊 */
.action-bar {
  display: flex;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.icon-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--r-pill);
  background: var(--chip-idle);
  color: var(--text-primary);
  font-size: 25rpx;
  font-weight: 700;
  /* 与详情窗那一排同一条规矩：一行四枚不许折行，所以英文写 Make card 不写 Generate note card */
  white-space: nowrap;
}

.icon-btn.on {
  background: var(--accent);
  color: var(--bg-page);
}

.icon-btn.danger {
  color: var(--danger);
  background: var(--danger-soft);
}

/* 第四枚「生成笔记卡片」宽一点：六个字压在等宽的一枚里会顶到边 */
.icon-btn.primary {
  flex: 1.4;
  background: var(--accent);
  color: var(--bg-page);
}

/* 中性面板：长文本在这里读 */
.panel {
  background: var(--bg-card);
  border: var(--w-edge) solid var(--card-edge);
  border-radius: var(--r-card);
  padding: var(--sp-4);
  margin-bottom: var(--sp-2);
}

.section-label {
  display: block;
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--text-tertiary);
  margin-bottom: var(--sp-2);
}

.summary-text {
  font-size: var(--fs-body);
  line-height: 1.68;
  color: var(--text-primary);
}

.points-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.point-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.point-num {
  flex: none;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  /* 序号用这条笔记的分类色，把中性面板和上面那块方块接上 */
  background: var(--tone-bg, var(--chip-idle));
  color: var(--tone-ink, var(--text-secondary));
  /* 纯数字序号吃全局那一档（首页要点序号同一写法）；这一支只出 Thin，
     原来那条 800 留着就是让系统假加粗，两边平台还不一致。字号 21 没动。 */
  font-family: 'WtsjMind', 'Poppins', sans-serif;
  font-size: var(--fs-tiny);
  font-weight: 100;
  text-align: center;
  line-height: 38rpx;
  margin-top: 4rpx;
}

.point-text {
  flex: 1;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--text-primary);
}

.link-text {
  font-size: var(--fs-meta);
  line-height: 1.5;
  color: var(--accent);
  word-break: break-all;
}

.original-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.original-header .section-label {
  margin-bottom: 0;
}

.expand-icon {
  font-size: var(--fs-meta);
  font-weight: 700;
  color: var(--text-tertiary);
}

.original-scroll {
  max-height: 60vh;
  margin-top: var(--sp-3);
}

.original-text {
  font-size: var(--fs-meta);
  line-height: var(--lh-body);
  color: var(--text-secondary);
  word-break: break-all;
}

/* 已公开那一行：小字说明 + 一个文字按钮，不跟主按钮抢位置。
   它现在紧跟操作条（条自带下间距），所以自己不再加上间距。 */
.share-state {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-3);
  margin-top: 0;
  font-size: var(--fs-meta);
  line-height: var(--lh-body);
  color: var(--text-tertiary);
}

.state-act {
  font-weight: 700;
  color: var(--accent);
  /* 和分享形象页那两个动作同一个毛病：不写死不换行会被拆成两行 */
  white-space: nowrap;
}

/* 转存来源：中性面板 + 一条锁住的说明，不给任何可点的样子 */
.import-line {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-meta);
  line-height: 1.5;
  color: #3c4046;
}

.import-hint {
  display: block;
  margin-top: var(--sp-3);
  font-size: var(--fs-tiny);
  color: #9a9ea6;
}
