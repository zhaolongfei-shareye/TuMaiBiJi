.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
}

.note-detail {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.source-type {
  font-size: 24rpx;
  color: #07c160;
  background: #e8f5e9;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.time {
  font-size: 24rpx;
  color: #999999;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.summary {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.8;
}

.key-points {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
}

.key-point {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.key-point:last-child {
  margin-bottom: 0;
}

.bullet {
  color: #07c160;
  font-weight: bold;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.original-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 12rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.actions {
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #f0f0f0;
}
