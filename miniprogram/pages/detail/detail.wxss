.loading {
  text-align: center;
  padding: var(--sp-6) 0;
  color: var(--text-secondary);
  font-size: var(--fs-body);
}

.detail-wrapper {
  padding-top: var(--sp-2);
}

/* 头部行卡：方块比列表里那块高一点，给标题腾出三行的位置 */
.hero {
  padding: var(--sp-4);
}

.hero-meta {
  font-size: var(--fs-tiny);
  font-weight: 800;
  letter-spacing: 1rpx;
  color: var(--text-tertiary);
  margin-bottom: 10rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.8rpx;
  line-height: 1.34;
  color: var(--text-primary);
  margin-bottom: 0;
}

.tags {
  margin-top: var(--sp-3);
}

/* 操作条：三个中性胶囊 */
.action-bar {
  display: flex;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.icon-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--r-pill);
  background: var(--chip-idle);
  color: var(--text-primary);
  font-size: 25rpx;
  font-weight: 700;
}

.icon-btn.on {
  background: var(--accent);
  color: var(--bg-page);
}

.icon-btn.danger {
  color: var(--danger);
  background: var(--danger-soft);
}

/* 中性面板：长文本在这里读 */
.panel {
  background: var(--bg-card);
  border: var(--w-edge) solid var(--card-edge);
  border-radius: var(--r-card);
  padding: var(--sp-4);
  margin-bottom: var(--sp-2);
}

.section-label {
  display: block;
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--text-tertiary);
  margin-bottom: var(--sp-2);
}

.summary-text {
  font-size: var(--fs-body);
  line-height: 1.68;
  color: var(--text-primary);
}

.points-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.point-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.point-num {
  flex: none;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  /* 序号用这条笔记的分类色，把中性面板和上面那块方块接上 */
  background: var(--tone-bg, var(--chip-idle));
  color: var(--tone-ink, var(--text-secondary));
  font-size: var(--fs-tiny);
  font-weight: 800;
  text-align: center;
  line-height: 38rpx;
  margin-top: 4rpx;
}

.point-text {
  flex: 1;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--text-primary);
}

.link-text {
  font-size: var(--fs-meta);
  line-height: 1.5;
  color: var(--accent);
  word-break: break-all;
}

.original-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.original-header .section-label {
  margin-bottom: 0;
}

.expand-icon {
  font-size: var(--fs-meta);
  font-weight: 700;
  color: var(--text-tertiary);
}

.original-scroll {
  max-height: 60vh;
  margin-top: var(--sp-3);
}

.original-text {
  font-size: var(--fs-meta);
  line-height: var(--lh-body);
  color: var(--text-secondary);
  word-break: break-all;
}

.bottom-actions {
  padding: var(--sp-3) 0 var(--sp-6);
}

.btn-share {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  background: var(--accent);
  color: var(--bg-page);
  border-radius: var(--r-pill);
  font-size: var(--fs-body);
  font-weight: 700;
  padding: var(--sp-3) 0;
}

/* 已公开那一行：小字说明 + 一个文字按钮，不跟主按钮抢位置 */
.share-state {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-3);
  margin-top: var(--sp-3);
  font-size: var(--fs-meta);
  line-height: var(--lh-body);
  color: var(--text-tertiary);
}

.state-act {
  font-weight: 700;
  color: var(--accent);
  /* 和分享形象页那两个动作同一个毛病：不写死不换行会被拆成两行 */
  white-space: nowrap;
}
